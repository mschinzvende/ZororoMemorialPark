@page "{handler?}"
@model ZororoMemorialPark.Pages.Reports.ExpenseReportModel
@using System.Text.Json
@{
    ViewData["Title"] = "Expense Report";
    var categoryLabelsJson = JsonSerializer.Serialize(Model.CategoryChartLabels);
    var categoryValuesJson = JsonSerializer.Serialize(Model.CategoryChartValues);
}

<style>
    .expense-report-kpi { border: 1px solid #e5ece7; border-radius: .8rem; height: 100%; }
    .expense-report-chart { height: 320px; position: relative; }
</style>

<div class="container-fluid py-4 pb-5">
    <section class="card shadow-sm border-0 mb-4">
        <div class="card-body p-4 d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3" style="background:linear-gradient(120deg,#07553f,#14835f); color:#fff; border-radius:.75rem;">
            <div><div class="text-uppercase small fw-semibold opacity-75 mb-1">Finance reporting</div><h1 class="h4 mb-1">Expense Report</h1><p class="mb-0 opacity-75">A single view of approved operating costs and grave-development payments.</p></div>
            <div class="d-flex gap-2"><a href="/Finance/Expenses" class="btn btn-outline-light"><i class="bi bi-wallet2 me-1"></i> Expense register</a><a asp-page-handler="Csv" asp-route-from="@Model.FromDate" asp-route-to="@Model.ToDate" asp-route-category="@Model.CategoryFilter" class="btn btn-light"><i class="bi bi-download me-1"></i> Export CSV</a></div>
        </div>
    </section>

    <form method="get" class="card shadow-sm border-0 mb-4"><div class="card-body"><div class="row g-3 align-items-end"><div class="col-md-3"><label class="form-label small fw-semibold">From</label><input type="date" name="from" class="form-control" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" /></div><div class="col-md-3"><label class="form-label small fw-semibold">To</label><input type="date" name="to" class="form-control" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" /></div><div class="col-md-4"><label class="form-label small fw-semibold">Category</label><select name="category" class="form-select"><option value="All">All expense categories</option>@foreach (var category in Model.ExpenseCategories) { <option value="@category" selected="@(Model.CategoryFilter == category)">@category</option> }</select></div><div class="col-md-2 d-grid"><button class="btn btn-success"><i class="bi bi-funnel me-1"></i> Run report</button></div></div></div></form>

    <div class="row g-3 mb-4">
        <div class="col-xl-3 col-md-6"><div class="card expense-report-kpi shadow-sm"><div class="card-body"><div class="small text-muted text-uppercase fw-semibold">Total expenses</div><div class="fs-4 fw-bold text-danger">$@Model.TotalExpenses.ToString("N2")</div><small class="text-muted">Paid in selected period</small></div></div></div>
        <div class="col-xl-3 col-md-6"><div class="card expense-report-kpi shadow-sm"><div class="card-body"><div class="small text-muted text-uppercase fw-semibold">Approved operating costs</div><div class="fs-4 fw-bold">$@Model.DailyOperatingExpenses.ToString("N2")</div><small class="text-muted">Non-job expenses from requisitions</small></div></div></div>
        <div class="col-xl-3 col-md-6"><div class="card expense-report-kpi shadow-sm"><div class="card-body"><div class="small text-muted text-uppercase fw-semibold">Construction costs</div><div class="fs-4 fw-bold">$@Model.ConstructionExpenses.ToString("N2")</div><small class="text-muted">Grave-development jobs</small></div></div></div>
        <div class="col-xl-3 col-md-6"><div class="card expense-report-kpi shadow-sm"><div class="card-body"><div class="small text-muted text-uppercase fw-semibold">Average per active day</div><div class="fs-4 fw-bold">$@Model.AverageDailyExpense.ToString("N2")</div><small class="text-muted">Days with recorded expenditure</small></div></div></div>
    </div>

    <div class="row g-4 mb-4"><div class="col-lg-7"><section class="card shadow-sm border-0 h-100"><div class="card-header bg-white py-3"><h2 class="h6 mb-1">Expense distribution by category</h2><p class="small text-muted mb-0">Paid value in the selected period.</p></div><div class="card-body"><div class="expense-report-chart"><canvas id="expenseCategoryChart"></canvas></div></div></section></div><div class="col-lg-5"><section class="card shadow-sm border-0 h-100"><div class="card-header bg-white py-3"><h2 class="h6 mb-1">Reading this report</h2></div><div class="card-body"><div class="d-flex gap-3 mb-3"><i class="bi bi-building-check text-success fs-4"></i><div><strong>Approved operating costs</strong><p class="small text-muted mb-0">Each operating expense is tied to the final approved value of a requisition item.</p></div></div><div class="d-flex gap-3"><i class="bi bi-hammer text-warning fs-4"></i><div><strong>Construction costs</strong><p class="small text-muted mb-0">Payments linked to a grave-development job. These remain managed from Job Entries.</p></div></div></div></section></div></div>

    <section class="card shadow-sm border-0"><div class="card-header bg-white py-3 d-flex justify-content-between align-items-center"><div><h2 class="h6 mb-1">Expense transactions</h2><p class="small text-muted mb-0">@Model.Rows.Count entries in the selected period.</p></div></div><div class="card-body p-0">@if (Model.Rows.Any()) { <div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th class="ps-4">Date</th><th>Category</th><th>Payee</th><th>Reference</th><th>Method</th><th>Source</th><th class="text-end pe-4">Amount paid</th></tr></thead><tbody>@foreach (var row in Model.Rows) { <tr><td class="ps-4 text-nowrap">@row.Date.ToString("dd MMM yyyy")</td><td>@row.Category</td><td><div class="fw-semibold">@row.Payee</div><small class="text-muted">@row.Notes</small></td><td>@(string.IsNullOrWhiteSpace(row.Reference) ? "—" : row.Reference)</td><td>@row.PaymentMethod</td><td>@if (row.IsRequisitionExpense) { <a class="badge text-bg-success text-decoration-none" href="/Requisitions/Details/@row.RequisitionId">@row.Source</a> } else if (row.IsConstructionCost) { <span class="badge text-bg-warning">@row.Source</span> } else { <span class="badge text-bg-secondary">@row.Source</span> }</td><td class="text-end pe-4 fw-semibold">$@row.AmountPaid.ToString("N2")</td></tr> }</tbody></table></div> } else { <div class="p-5 text-center text-muted"><i class="bi bi-bar-chart fs-2 d-block mb-2"></i>No expense transactions match the selected filters.</div> }</div></section>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        new Chart(document.getElementById('expenseCategoryChart'), {
            type: 'bar',
            data: { labels: @Html.Raw(categoryLabelsJson), datasets: [{ label: 'Amount paid', data: @Html.Raw(categoryValuesJson), backgroundColor: ['#087f5b','#1971c2','#f08c00','#c92a2a','#7048e8','#0b7285','#5c940d','#868e96'], borderRadius: 7, maxBarThickness: 58 }] },
            options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, ticks: { callback: value => '$' + Number(value).toLocaleString() } }, x: { grid: { display: false } } } }
        });
    </script>
}
