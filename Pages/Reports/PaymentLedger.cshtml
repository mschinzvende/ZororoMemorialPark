@page "{handler?}"
@model ZororoMemorialPark.Pages.Reports.PaymentLedgerModel
@{
    ViewData["Title"] = "Payment Ledger";
}

<div class="container-fluid py-4">
    <div class="row mb-3">
        <div class="col-lg-12 mx-auto">
            <div class="card shadow-sm">
                <div class="card-header d-flex justify-content-between align-items-center"
                     style="background-color: var(--primary-green); color: var(--primary-white);">
                    <h5 class="mb-0">Payment Ledger</h5>
                    <div>
                        <form method="get" asp-page-handler="Pdf" class="d-inline">
                            <input type="hidden" name="from" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" />
                            <input type="hidden" name="to" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" />
                            <input type="hidden" name="category" value="@Model.SelectedCategory" />
                            <input type="hidden" name="paymentMethodId" value="@Model.SelectedPaymentMethodId" />
                            <button type="submit" class="btn btn-sm btn-light">
                                <i class="bi bi-file-earmark-pdf"></i> Export PDF
                            </button>
                        </form>
                    </div>
                </div>

                <div class="card-body">
                    <!-- Filters -->
                    <form method="get" class="row g-3 mb-3">
                        <div class="col-md-3">
                            <label class="form-label">From Date</label>
                            <input type="date" name="from" class="form-control"
                                   value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">To Date</label>
                            <input type="date" name="to" class="form-control"
                                   value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Category</label>
                            <select name="category" class="form-select">
                                <option value="All" selected="@(Model.SelectedCategory == "All")">All</option>
                                <option value="GraveSales" selected="@(Model.SelectedCategory == "GraveSales")">Grave Sales</option>
                                <option value="Reservations" selected="@(Model.SelectedCategory == "Reservations")">Grave Reservations</option>
                                <option value="Tombstones" selected="@(Model.SelectedCategory == "Tombstones")">Tombstone Sales</option>
                                <option value="Other" selected="@(Model.SelectedCategory == "Other")">Other Revenue</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Payment Method</label>
                            <select name="paymentMethodId" class="form-select">
                                <option value="">All Methods</option>
                                @foreach (var pm in Model.PaymentMethods)
                                {
                                    <option value="@pm.sys_paymentMethodId"
                                            selected="@(Model.SelectedPaymentMethodId == pm.sys_paymentMethodId)">
                                        @pm.sys_paymentMethodName
                                    </option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3 d-flex align-items-end">
                            <button type="submit" class="btn btn-success w-100">Run Report</button>
                        </div>
                    </form>

                    <!-- Summary cards -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-3">
                            <div class="card shadow-sm border-0" style="background:#e8f5e9;">
                                <div class="card-body">
                                    <div class="small text-muted">Total Amount</div>
                                    <div class="fw-bold fs-5">$@Model.TotalAmount.ToString("N2")</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="card shadow-sm border-0">
                                <div class="card-body">
                                    <div class="small text-muted">Grave Sales</div>
                                    <div class="fw-bold">$@Model.GraveSalesAmount.ToString("N2")</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="card shadow-sm border-0">
                                <div class="card-body">
                                    <div class="small text-muted">Reservations</div>
                                    <div class="fw-bold">$@Model.ReservationsAmount.ToString("N2")</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="card shadow-sm border-0">
                                <div class="card-body">
                                    <div class="small text-muted">Tombstones</div>
                                    <div class="fw-bold">$@Model.TombstoneAmount.ToString("N2")</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card shadow-sm border-0">
                                <div class="card-body">
                                    <div class="small text-muted">Other Revenue</div>
                                    <div class="fw-bold">$@Model.OtherAmount.ToString("N2")</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Ledger table -->
                    <div class="card shadow-sm">
                        <div class="card-header" style="background-color: var(--primary-grey);">
                            <strong>Payment Ledger (@Model.SelectedCategory)</strong>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table table-striped table-hover align-middle" id="paymentLedgerTable">
                                    <thead>
                                        <tr>
                                            <th>Date</th>
                                            <th>Category</th>
                                            <th>Invoice ID</th>
                                            <th>Receipt #</th>
                                            <th>Payment Method</th>
                                            <th>Payer</th>
                                            <th class="text-end">Amount</th>
                                            <th>Notes</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var row in Model.Rows)
                                        {
                                            <tr>
                                                <td>@row.Date.ToString("yyyy-MM-dd")</td>
                                                <td>@row.Category</td>
                                                <td>@row.InvoiceId</td>
                                                <td>@(row.ReceiptNumber?.ToString() ?? "-")</td>
                                                <td>@row.PaymentMethod</td>
                                                <td>@row.Payer</td>
                                                <td class="text-end">$@row.Amount.ToString("N2")</td>
                                                <td>@row.Notes</td>
                                            </tr>
                                        }
                                        @if (!Model.Rows.Any())
                                        {
                                            <tr>
                                                <td colspan="8" class="text-center text-muted">
                                                    No records for the selected filters.
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            <div class="mt-3 text-end">
                                <strong>Grand Total:</strong> $@Model.TotalAmount.ToString("N2")
                            </div>
                        </div>
                    </div>

                    <!-- You can hook table.js to #paymentLedgerTable for pagination/search -->
                </div>
            </div>
        </div>
    </div>
</div>
