@page
@model ZororoMemorialPark.Pages.Reports.BurialRegisterModel

@{
    ViewData["Title"] = "Burial Register";
}


    <div class="row">
        
            <div class="card shadow-sm mb-4">
                <div class="card-header"
                     style="background-color: var(--primary-green); color: var(--primary-white);">
                    <h5 class="mb-0">Burial Register</h5>
                </div>
                <div class="card-body">
                    <!-- Filters -->
                    <form method="get" class="row g-3 mb-3">
                        <div class="col-md-3">
                            <label class="form-label">From Date</label>
                            <input type="date" name="FromDate" class="form-control"
                                   value="@(Model.FromDate.HasValue ? Model.FromDate.Value.ToString("yyyy-MM-dd") : "")" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">To Date</label>
                            <input type="date" name="ToDate" class="form-control"
                                   value="@(Model.ToDate.HasValue ? Model.ToDate.Value.ToString("yyyy-MM-dd") : "")" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Section</label>
                            <select name="SectionId" class="form-select">
                                <option value="">-- All Sections --</option>
                                @foreach (var sec in Model.Sections)
                                {
                                    <option value="@sec.sys_sectionId"
                                            selected="@((Model.SectionId.HasValue && Model.SectionId.Value == sec.sys_sectionId) ? "selected" : null)">
                                        @sec.sys_sectionName
                                    </option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3 d-flex align-items-end justify-content-end">
                            <button type="submit" class="btn btn-success me-2">Generate</button>

                            @* PDF export with same filters *@
                            <a asp-page="./BurialRegister"
                               asp-page-handler="Pdf"
                               asp-route-fromDate="@(Model.FromDate?.ToString("yyyy-MM-dd"))"
                               asp-route-toDate="@(Model.ToDate?.ToString("yyyy-MM-dd"))"
                               asp-route-sectionId="@(Model.SectionId)"
                               class="btn btn-outline-secondary">
                                Export PDF
                            </a>
                        </div>
                    </form>

                    <!-- Summary -->
                    <div class="row mb-3">
                        <div class="col-md-3 mb-2">
                            <div class="card border-0 shadow-sm">
                                <div class="card-body text-center">
                                    <div class="fw-bold">Total Burials</div>
                                    <div class="fs-4">@Model.TotalBurials</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Table -->
                    @if (Model.Rows != null && Model.Rows.Any())
                    {


                <div class="row">
                    <div class="col-auto me-2">
                        <div class="form-group">
                            <!--		Show Numbers Of Rows 		-->
                            <select class="form-select" name="state" id="maxRows">

                                <option value="10">Show 10</option>
                                <option value="15">15</option>
                                <option value="20">20</option>
                                <option value="50">50</option>
                                <option value="70">70</option>
                                <option value="100">100</option>
                                <option value="5000">ALL</option>
                            </select>

                        </div>
                    </div>
                    <div class="col-auto me-2">
                        <input type="text" id="search_input_all" onkeyup="FilterkeyWord_all_table()" placeholder="Search Table" class="form-control">
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-striped table-class table-sm" id="myTable">

                        <thead class="thead-light">

                        
                                    <tr>
                                        <th>Date & Time of Burial</th>
                                        <th>Section</th>
                                        <th>Plot</th>
                                        <th>Deceased</th>
                                        <th>Gender</th>
                                        <th>Age</th>
                                        <th>Nationality</th>
                                        <th>Customer</th>
                                        <th>Phone</th>
                                        <th>Repatriation</th>
                                        <th>Burial Order</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var r in Model.Rows)
                                    {
                                        <tr>
                                            <td>@r.BurialDateTime.ToString("yyyy-MM-dd HH:mm")</td>
                                            <td>@r.SectionName</td>
                                            <td>@r.PlotNumber</td>
                                            <td>@r.DeceasedName</td>
                                            <td>@r.DeceasedGender</td>
                                            <td>@(r.AgeAtDeath.HasValue ? r.AgeAtDeath.ToString() : "-")</td>
                                            <td>@r.DeceasedNationality</td>
                                            <td>@r.CustomerName</td>
                                            <td>@r.CustomerPhone</td>
                                            <td>@r.RepatriationSource</td>
                                            @if(r.BurialOrder != "Invalid File"){
                                        <td><a href="@r.BurialOrder" target="_blank">View</a></td>
                                            }
                                            else{
                                        <td>@r.BurialOrder</td>
                                            }

                                            
                                        </tr>
                                    }
                                </tbody>
                            </table>

                    <!--		Start Pagination -->
                    <div class="pagination-container">
                        <nav>
                            <ul class="pagination">
                                <!--	Here the JS Function Will Add the Rows -->
                            </ul>
                        </nav>
                    </div>
                    <div class="rows_count">Showing 11 to 20 of 91 entries</div>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info mt-3">
                            No records found for the selected filters.
                        </div>
                    }
                </div>
            </div>
        </div>

<script src='https://cdnjs.cloudflare.com/ajax/libs/jquery/2.2.2/jquery.min.js'></script>
<script src='https://maxcdn.bootstrapcdn.com/bootstrap/3.3.6/js/bootstrap.min.js'></script>
<script src="~/js/tableScript.js"></script>