@page
@model ZororoMemorialPark.Pages.Reports.ReportsDashModel
@{
}

<div class="container mt-4">


    <div class="row">

        <!-- Grave Management Reports -->
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-header" style="background:#006A46;color:white;">
                    Grave Management
                </div>
                <div class="card-body">

                    <a class="btn btn-outline-success w-100 mb-2"
                       asp-page="/Reports/GraveOccupancy">
                        Grave Occupancy
                    </a>
                    <a class="btn btn-outline-success w-100 mb-2"
                       asp-page="/Reports/BurialRegister">
                        Burial Register
                    </a>
                    
                </div>
            </div>
        </div>

        <!-- Finance Reports -->
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-header" style="background:#006A46;color:white;">
                    Finance & Invoicing
                </div>
                <div class="card-body">
                    <a class="btn btn-outline-success w-100 mb-2"
                       asp-page="/Reports/RevenueReport">
                        Revenue Report
                    </a>

                    <a class="btn btn-outline-success w-100 mb-2"
                       asp-page="/Reports/PaymentLedger">
                        Payment Ledger
                    </a>

                    <a class="btn btn-outline-success w-100 mb-2"
                       asp-page="/Reports/OutstandingBalances">
                        Outstanding Balances
                    </a>
                    
                </div>
            </div>
        </div>

        <!-- Stock/Consumables -->
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-header" style="background:#006A46;color:white;">
                    Stock & Consumables
                </div>
                <div class="card-body">

                    <a class="btn btn-outline-success w-100 mb-2"
                       asp-page="/Reports/StockLevels">
                        Stock Levels
                    </a>
                   
                    <a class="btn btn-outline-success w-100 mb-2"
                       asp-page="/Reports/StockMovement">
                        Stock Movement
                    </a>
                   
                </div>
            </div>
        </div>

    </div>
</div>
