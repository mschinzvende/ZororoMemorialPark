@page
@model ZororoMemorialPark.Pages.Reports.StockLevelsModel
@{
    ViewData["Title"] = "Stock Levels";
}

<div class="container-fluid py-4">
    <div class="row mb-3">
        <div class="col-lg-12 mx-auto">
            <div class="card shadow-sm">
                <div class="card-header d-flex justify-content-between align-items-center"
                     style="background-color: var(--primary-green); color: var(--primary-white);">
                    <h5 class="mb-0">Stock Levels</h5>
                </div>

                <div class="card-body">
                    <!-- Filters -->
                    <form method="get" class="row g-3 mb-3">
                        <div class="col-md-3">
                            <label class="form-label">Item Type</label>
                            <select name="itemType" class="form-select">
                                <option value="Product" selected="@(Model.SelectedItemType == "Product")">Products</option>
                                
                            </select>


                        </div>

                        <div class="col-md-3">
                            <label class="form-label">Category</label>
                            <select name="category" class="form-select">
                                
                                <option value="Sellable" selected="@(Model.SelectedCategory == "Sellable" ? "selected" : "")">Sellable</option>
                                <option value="Consumable" selected="@(Model.SelectedCategory == "Consumable" ? "selected" : "")">Consumable</option>
                                <option value="All" selected="@(Model.SelectedCategory == "All" ? "selected" : "")">All</option>
                            </select>
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">Stock Status (Products)</label>
                            <select name="status" class="form-select">
                                
                                <option value="InStock" selected="@(Model.SelectedStatus == "InStock" ? "selected" : "")">In Stock</option>
                                <option value="Low" selected="@(Model.SelectedStatus == "Low" ? "selected" : "")">Low Stock</option>
                                <option value="Out" selected="@(Model.SelectedStatus == "Out" ? "selected" : "")">Out of Stock</option>
                                <option value="All" selected="@(Model.SelectedStatus == "All" ? "selected" : "")">All</option>
                            </select>
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">Search</label>
                            <input type="text" name="search" class="form-control"
                                   value="@Model.SearchTerm" placeholder="Name / Category..." />
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">Low Stock Threshold</label>
                            <input type="number" name="lowThreshold" class="form-control"
                                   value="@Model.LowStockThreshold" min="1" />
                        </div>

                        <div class="col-md-3 d-flex align-items-end">
                            <button type="submit" class="btn btn-success w-100">Run Report</button>
                        </div>
                    </form>

                    <!-- Summary cards -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-3">
                            <div class="card shadow-sm border-0" style="background:#e8f5e9;">
                                <div class="card-body">
                                    <div class="small text-muted">Tracked Products</div>
                                    <div class="fw-bold fs-5">@Model.TotalItems</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card shadow-sm border-0">
                                <div class="card-body">
                                    <div class="small text-muted">In Stock</div>
                                    <div class="fw-bold">@Model.TotalInStock</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card shadow-sm border-0">
                                <div class="card-body">
                                    <div class="small text-muted">Low Stock (&le; @Model.LowStockThreshold)</div>
                                    <div class="fw-bold text-warning">@Model.TotalLowStock</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card shadow-sm border-0">
                                <div class="card-body">
                                    <div class="small text-muted">Out of Stock</div>
                                    <div class="fw-bold text-danger">@Model.TotalOutOfStock</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <div class="card shadow-sm border-0">
                                <div class="card-body">
                                    <div class="small text-muted">Total Stock Cost (at unit cost)</div>
                                    <div class="fw-bold fs-5">$@Model.TotalStockCost.ToString("N2")</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card shadow-sm border-0">
                                <div class="card-body">
                                    <div class="small text-muted">Potential Revenue (at selling price)</div>
                                    <div class="fw-bold fs-5">$@Model.TotalStockPotentialRevenue.ToString("N2")</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Tabs: table vs charts -->
                    <ul class="nav nav-tabs" id="stockTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" id="stock-table-tab" data-bs-toggle="tab"
                                    data-bs-target="#stock-table" type="button" role="tab">
                                Table View
                            </button>
                        </li>
                        
                    </ul>

                    <div class="tab-content mt-3" id="stockTabsContent">
                        <!-- Table tab -->
                        <div class="tab-pane fade show active" id="stock-table" role="tabpanel">
                            <div class="card shadow-sm">
                                <div class="card-header" style="background-color: var(--primary-grey);">
                                    <strong>Stock Details</strong>
                                </div>
                                <div class="card-body">
                                    <div class="table-responsive">
                                        <table class="table table-striped table-hover align-middle" id="stockTable">
                                            <thead>
                                                <tr>
                                                    <th>Name</th>
                                                    <th>Type</th>
                                                    <th>Category</th>
                                                    <th class="text-end">Qty</th>
                                                    <th>UoM</th>
                                                    <th>Status</th>
                                                    <th class="text-end">Unit Cost</th>
                                                    <th class="text-end">Selling Price</th>
                                                    <th class="text-end">Stock Cost</th>
                                                    <th class="text-end">Potential Revenue</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var row in Model.Rows)
                                                {
                                                    var statusClass = row.Status switch
                                                    {
                                                        "Low Stock" => "badge bg-warning text-dark",
                                                        "Out of Stock" => "badge bg-danger",
                                                        "In Stock" => "badge bg-success",
                                                        "Service" => "badge bg-secondary",
                                                        _ => "badge bg-light text-dark"
                                                    };

                                                    <tr>
                                                        <td>@row.ItemName</td>
                                                        <td>@row.ItemType</td>
                                                        <td>@row.Category</td>
                                                        <td class="text-end">@row.StockQuantity</td>
                                                        <td>@row.UnitOfMeasure</td>
                                                        <td><span class="@statusClass">@row.Status</span></td>
                                                        <td class="text-end">$@row.UnitCost.ToString("N2")</td>
                                                        <td class="text-end">$@row.SellingPrice.ToString("N2")</td>
                                                        <td class="text-end">$@row.StockValueCost.ToString("N2")</td>
                                                        <td class="text-end">$@row.StockValueRevenue.ToString("N2")</td>
                                                    </tr>
                                                }

                                                @if (!Model.Rows.Any())
                                                {
                                                    <tr>
                                                        <td colspan="10" class="text-center text-muted">
                                                            No items match the selected filters.
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                    
                                </div>
                            </div>
                        </div>

                        
                    </div> <!-- tab content -->
                </div> <!-- card-body -->
            </div>
        </div>
    </div>
</div>

