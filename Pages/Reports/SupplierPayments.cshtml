@page "{handler?}"
@model ZororoMemorialPark.Pages.Reports.SupplierPaymentsModel
@{
    ViewData["Title"] = "Supplier Payments Report";
}

<div class="container-fluid py-4">
    <div class="row mb-3">
        <div class="col-lg-12 mx-auto">
            <div class="card shadow-sm">
                <div class="card-header d-flex justify-content-between align-items-center"
                     style="background-color: var(--primary-green); color: var(--primary-white);">
                    <h5 class="mb-0">Supplier Payments Report</h5>

                    <form method="get" asp-page-handler="Pdf" class="d-inline">
                        <input type="hidden" name="from" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" />
                        <input type="hidden" name="to" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" />
                        <input type="hidden" name="supplierId" value="@(Model.SelectedSupplierId?.ToString() ?? "")" />
                        <input type="hidden" name="stageId" value="@(Model.SelectedStageId?.ToString() ?? "")" />
                        <input type="hidden" name="sectionId" value="@(Model.SelectedSectionId?.ToString() ?? "")" />
                        <button type="submit" class="btn btn-sm btn-light">
                            <i class="bi bi-file-earmark-pdf"></i> Export PDF
                        </button>
                    </form>
                </div>

                <div class="card-body">
                    <!-- FILTERS -->
                    <form method="get" class="row g-3 mb-3">
                        <div class="col-md-3">
                            <label class="form-label">From Date</label>
                            <input type="date" name="from" class="form-control"
                                   value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">To Date</label>
                            <input type="date" name="to" class="form-control"
                                   value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" />
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">Supplier</label>
                            <select name="supplierId" class="form-select">
                                <option value="">All Suppliers</option>
                                @foreach (var s in Model.SupplierList)
                                {
                                    if (Model.SelectedSupplierId.HasValue && Model.SelectedSupplierId.Value == s.sys_supplierId)
                                    {
                                        <option value="@s.sys_supplierId" selected>@s.sys_supplierName</option>
                                    }
                                    else
                                    {
                                        <option value="@s.sys_supplierId">@s.sys_supplierName</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">Development Stage</label>
                            <select name="stageId" class="form-select">
                                <option value="">All Stages</option>
                                @foreach (var st in Model.StageList)
                                {
                                    if (Model.SelectedStageId.HasValue && Model.SelectedStageId.Value == st.sys_stageId)
                                    {
                                        <option value="@st.sys_stageId" selected>@st.sys_stageName</option>
                                    }
                                    else
                                    {
                                        <option value="@st.sys_stageId">@st.sys_stageName</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">Grave Section</label>
                            <select name="sectionId" class="form-select">
                                <option value="">All Sections</option>
                                @foreach (var sec in Model.SectionList)
                                {
                                    if (Model.SelectedSectionId.HasValue && Model.SelectedSectionId.Value == sec.sys_sectionId)
                                    {
                                        <option value="@sec.sys_sectionId" selected>@sec.sys_sectionName</option>
                                    }
                                    else
                                    {
                                        <option value="@sec.sys_sectionId">@sec.sys_sectionName</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="col-md-3 d-flex align-items-end">
                            <button type="submit" class="btn btn-success w-100">
                                Run Report
                            </button>
                        </div>
                    </form>

                    <!-- SUMMARY CARDS -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <div class="card shadow-sm border-0" style="background:#e8f5e9;">
                                <div class="card-body">
                                    <div class="small text-muted">Total Amount Due</div>
                                    <div class="fw-bold fs-5">$@Model.TotalAmountDue.ToString("N2")</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card shadow-sm border-0">
                                <div class="card-body">
                                    <div class="small text-muted">Total Paid</div>
                                    <div class="fw-bold text-success fs-5">$@Model.TotalAmountPaid.ToString("N2")</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card shadow-sm border-0">
                                <div class="card-body">
                                    <div class="small text-muted">Outstanding Balance</div>
                                    <div class="fw-bold text-danger fs-5">$@Model.TotalBalance.ToString("N2")</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- TABS: TABLE / CHARTS -->
                    <ul class="nav nav-tabs" id="supplierTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" id="sup-table-tab" data-bs-toggle="tab"
                                    data-bs-target="#sup-table" type="button" role="tab">
                                Table View
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="sup-chart-tab" data-bs-toggle="tab"
                                    data-bs-target="#sup-chart" type="button" role="tab">
                                Chart View
                            </button>
                        </li>
                    </ul>

                    <div class="tab-content mt-3" id="supplierTabsContent">
                        <!-- TABLE TAB -->
                        <div class="tab-pane fade show active" id="sup-table" role="tabpanel">
                            <div class="card shadow-sm">
                                <div class="card-header" style="background-color: var(--primary-grey);">
                                    <strong>Supplier Payments</strong>
                                </div>
                                <div class="card-body">
                                    <div class="table-responsive">
                                        <table class="table table-striped table-hover align-middle" id="supplierPaymentsTable">
                                            <thead>
                                                <tr>
                                                    <th>Date</th>
                                                    <th>Supplier</th>
                                                    <th>Section</th>
                                                    <th>Plot</th>
                                                    <th>Stage</th>
                                                    <th class="text-end">Amount Due</th>
                                                    <th class="text-end">Amount Paid</th>
                                                    <th class="text-end">Balance</th>
                                                    <th>Notes</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var r in Model.Rows)
                                                {
                                                    <tr>
                                                        <td>@r.Date.ToString("yyyy-MM-dd")</td>
                                                        <td>@r.SupplierName</td>
                                                        <td>@r.SectionName</td>
                                                        <td>@r.PlotNumber</td>
                                                        <td>@r.StageName</td>
                                                        <td class="text-end">$@r.AmountDue.ToString("N2")</td>
                                                        <td class="text-end text-success">$@r.AmountPaid.ToString("N2")</td>
                                                        <td class="text-end text-danger">$@r.Balance.ToString("N2")</td>
                                                        <td>@r.Notes</td>
                                                    </tr>
                                                }

                                                @if (!Model.Rows.Any())
                                                {
                                                    <tr>
                                                        <td colspan="9" class="text-center text-muted">
                                                            No records for the selected filters.
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                    <small class="text-muted">
                                        You can plug in table.js here for pagination and advanced search.
                                    </small>
                                </div>
                            </div>
                        </div>

                        <!-- CHART TAB -->
                        <div class="tab-pane fade" id="sup-chart" role="tabpanel">
                            <div class="row g-3">
                                <div class="col-lg-6">
                                    <div class="card shadow-sm">
                                        <div class="card-body">
                                            <h6 class="card-title">Amount Paid by Supplier</h6>
                                            <canvas id="supplierBarChart"></canvas>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-6">
                                    <div class="card shadow-sm">
                                        <div class="card-body">
                                            <h6 class="card-title">Amount Paid by Development Stage</h6>
                                            <canvas id="stageBarChart"></canvas>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="row g-3 mt-3">
                                <div class="col-lg-6">
                                    <div class="card shadow-sm">
                                        <div class="card-body">
                                            <h6 class="card-title">Amount Paid by Section</h6>
                                            <canvas id="sectionBarChart"></canvas>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div> <!-- chart tab -->
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // ===== Supplier chart data =====
        
        const supplierLabels = @Html.Raw(Json.Serialize(Model.SupplierChartLabels));
        const supplierPaid = @Html.Raw(Json.Serialize(Model.SupplierChartPaid));





        const ctxSup = document.getElementById('supplierBarChart');
        if (ctxSup && supplierLabels.length > 0) {
            new Chart(ctxSup, {
                type: 'bar',
                data: {
                    labels: supplierLabels,
                    datasets: [{
                        label: 'Amount Paid',
                        data: supplierPaid
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        y: { beginAtZero: true }
                    }
                }
            });
        }

        // ===== Stage chart =====
       

        const stageLabels = @Html.Raw(Json.Serialize(Model.StageChartLabels));
        const stagePaid = @Html.Raw(Json.Serialize(Model.StageChartPaid));

        const ctxStage = document.getElementById('stageBarChart');
        if (ctxStage && stageLabels.length > 0) {
            new Chart(ctxStage, {
                type: 'bar',
                data: {
                    labels: stageLabels,
                    datasets: [{
                        label: 'Amount Paid',
                        data: stagePaid
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        y: { beginAtZero: true }
                    }
                }
            });
        }

        // ===== Section chart =====
        const sectionLabels = @Html.Raw(Json.Serialize(Model.SectionChartLabels));
        const sectionPaid = @Html.Raw(Json.Serialize(Model.SectionChartPaid));

        const ctxSection = document.getElementById('sectionBarChart');
        if (ctxSection && sectionLabels.length > 0) {
            new Chart(ctxSection, {
                type: 'bar',
                data: {
                    labels: sectionLabels,
                    datasets: [{
                        label: 'Amount Paid',
                        data: sectionPaid
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        y: { beginAtZero: true }
                    }
                }
            });
        }




        

    </script>
}
