@page "{handler?}"
@model ZororoMemorialPark.Pages.Reports.StockMovementModel
@{
    ViewData["Title"] = "Stock Movement Report";
}

<div class="container-fluid py-4">
    <div class="row mb-3">
        <div class="col-lg-12 mx-auto">
            <div class="card shadow-sm">
                <div class="card-header d-flex justify-content-between align-items-center"
                     style="background-color: var(--primary-green); color: var(--primary-white);">
                    <h5 class="mb-0">Stock Movement Report</h5>
                    <div>
                        <form method="get" asp-page-handler="Pdf" class="d-inline">
                            <input type="hidden" name="from" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" />
                            <input type="hidden" name="to" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" />
                            <input type="hidden" name="itemId" value="@(Model.SelectedItemId?.ToString())" />
                            <input type="hidden" name="movementType" value="@Model.SelectedMovementType" />
                            <button type="submit" class="btn btn-sm btn-light">
                                <i class="bi bi-file-earmark-pdf"></i> Export PDF
                            </button>
                        </form>
                    </div>
                </div>

                <div class="card-body">
                    <!-- Filters -->
                    <form method="get" class="row g-3 mb-3">
                        <div class="col-md-3">
                            <label class="form-label">From Date</label>
                            <input type="date" name="from" class="form-control"
                                   value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">To Date</label>
                            <input type="date" name="to" class="form-control"
                                   value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" />
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">Product</label>
                            <select name="itemId" class="form-select">
                                <option value="">All Products</option>
                                @foreach (var p in Model.Products)
                                {
                                    if (Model.SelectedItemId.HasValue && Model.SelectedItemId.Value == p.sys_itemId)
                                    {
                                        <option value="@p.sys_itemId" selected>@p.sys_itemName</option>
                                    }
                                    else
                                    {
                                        <option value="@p.sys_itemId">@p.sys_itemName</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">Movement Type</label>
                            <select name="movementType" class="form-select">
                                @if (Model.SelectedMovementType == "All")
                                {
                                    <option value="All" selected>All Types</option>
                                }
                                else
                                {
                                    <option value="All">All Types</option>
                                }

                                @if (Model.SelectedMovementType == "Purchases")
                                {
                                    <option value="Purchases" selected>Purchases</option>
                                }
                                else
                                {
                                    <option value="Purchases">Purchases</option>
                                }

                                @if (Model.SelectedMovementType == "Sales")
                                {
                                    <option value="Sales" selected>Sales</option>
                                }
                                else
                                {
                                    <option value="Sales">Sales</option>
                                }

                                @if (Model.SelectedMovementType == "JobUsage")
                                {
                                    <option value="JobUsage" selected>Job Usage</option>
                                }
                                else
                                {
                                    <option value="JobUsage">Job Usage</option>
                                }

                                @if (Model.SelectedMovementType == "Adjustments")
                                {
                                    <option value="Adjustments" selected>Adjustments / Consumption</option>
                                }
                                else
                                {
                                    <option value="Adjustments">Adjustments / Consumption</option>
                                }

                                @if (Model.SelectedMovementType == "In")
                                {
                                    <option value="In" selected>Inbound Only</option>
                                }
                                else
                                {
                                    <option value="In">Inbound Only</option>
                                }

                                @if (Model.SelectedMovementType == "Out")
                                {
                                    <option value="Out" selected>Outbound Only</option>
                                }
                                else
                                {
                                    <option value="Out">Outbound Only</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-3 d-flex align-items-end">
                            <button type="submit" class="btn btn-success w-100">Run Report</button>
                        </div>
                    </form>

                    <!-- Summary cards -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-3">
                            <div class="card shadow-sm border-0" style="background:#e8f5e9;">
                                <div class="card-body">
                                    <div class="small text-muted">Total Movements</div>
                                    <div class="fw-bold fs-5">@Model.Rows.Count</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card shadow-sm border-0">
                                <div class="card-body">
                                    <div class="small text-muted">Quantity In</div>
                                    <div class="fw-bold text-success">@Model.TotalQuantityIn</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card shadow-sm border-0">
                                <div class="card-body">
                                    <div class="small text-muted">Quantity Out</div>
                                    <div class="fw-bold text-danger">@Model.TotalQuantityOut</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card shadow-sm border-0">
                                <div class="card-body">
                                    <div class="small text-muted">Net Movement (In − Out)</div>
                                    <div class="fw-bold @(Model.NetQuantity >= 0 ? "text-success" : "text-danger")">
                                        @Model.NetQuantity
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Breakdown cards -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-3">
                            <div class="card shadow-sm border-0">
                                <div class="card-body">
                                    <div class="small text-muted">Purchases</div>
                                    <div class="fw-bold">@Model.PurchaseQty</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card shadow-sm border-0">
                                <div class="card-body">
                                    <div class="small text-muted">Sales</div>
                                    <div class="fw-bold">@Model.SaleQty</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card shadow-sm border-0">
                                <div class="card-body">
                                    <div class="small text-muted">Job Usage</div>
                                    <div class="fw-bold">@Model.JobUsageQty</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card shadow-sm border-0">
                                <div class="card-body">
                                    <div class="small text-muted">Adjustments / Consumption</div>
                                    <div class="fw-bold">@Model.AdjustmentQty</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Tabs -->
                    <ul class="nav nav-tabs" id="stockMoveTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" id="sm-table-tab" data-bs-toggle="tab"
                                    data-bs-target="#sm-table" type="button" role="tab">
                                Detailed Table
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="sm-chart-tab" data-bs-toggle="tab"
                                    data-bs-target="#sm-chart" type="button" role="tab">
                                Chart View
                            </button>
                        </li>
                    </ul>

                    <div class="tab-content mt-3" id="stockMoveTabsContent">
                        <!-- Table tab -->
                        <div class="tab-pane fade show active" id="sm-table" role="tabpanel">
                            <div class="card shadow-sm">
                                <div class="card-header" style="background-color: var(--primary-grey);">
                                    <strong>Stock Movement Details</strong>
                                </div>
                                <div class="card-body">
                                    <div class="table-responsive">
                                        <table class="table table-striped table-hover align-middle" id="stockMovementTable">
                                            <thead>
                                                <tr>
                                                    <th>Date</th>
                                                    <th>Item</th>
                                                    <th>Type</th>
                                                    <th class="text-end">Qty In</th>
                                                    <th class="text-end">Qty Out</th>
                                                    <th class="text-end">Unit Cost</th>
                                                    <th class="text-end">Total Cost</th>
                                                    <th>Reference</th>
                                                    <th>Notes</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var r in Model.Rows)
                                                {
                                                    <tr>
                                                        <td>@r.Date.ToString("yyyy-MM-dd")</td>
                                                        <td>@r.ItemName</td>
                                                        <td>@r.MovementType</td>
                                                        <td class="text-end">
                                                            @(r.QuantityIn > 0 ? r.QuantityIn.ToString("N2") : "")
                                                        </td>
                                                        <td class="text-end">
                                                            @(r.QuantityOut > 0 ? r.QuantityOut.ToString("N2") : "")
                                                        </td>
                                                        <td class="text-end">$@r.UnitCost.ToString("N2")</td>
                                                        <td class="text-end">$@r.TotalCost.ToString("N2")</td>
                                                        <td>@r.Reference</td>
                                                        <td>@r.Notes</td>
                                                    </tr>
                                                }

                                                @if (!Model.Rows.Any())
                                                {
                                                    <tr>
                                                        <td colspan="9" class="text-center text-muted">
                                                            No movements for the selected filters.
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                    <small class="text-muted">You can plug in table.js here for pagination and search.</small>
                                </div>
                            </div>
                        </div>

                        <!-- Charts tab -->
                        <div class="tab-pane fade" id="sm-chart" role="tabpanel">
                            <div class="row g-3">
                                <div class="col-lg-8">
                                    <div class="card shadow-sm">
                                        <div class="card-body">
                                            <h6 class="card-title">Movement Over Time</h6>
                                            <canvas id="movementOverTimeChart"></canvas>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-4">
                                    <div class="card shadow-sm">
                                        <div class="card-body">
                                            <h6 class="card-title">Top Moved Products</h6>
                                            <canvas id="topItemsChart"></canvas>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div> <!-- chart tab -->
                    </div> <!-- tab content -->
                </div> <!-- card-body -->
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // ===== Movement Over Time (bar chart) =====
        const motLabels = [
        @foreach (var d in Model.MovementByDate)
        {
            @:$"'{d.Date:yyyy-MM-dd}',"
        }
        ];
        const motIn = [
        @foreach (var d in Model.MovementByDate)
        {
            @:$"{d.QuantityIn},"
        }
        ];
        const motOut = [
        @foreach (var d in Model.MovementByDate)
        {
            @:$"{d.QuantityOut},"
        }
        ];

        const motCtx = document.getElementById('movementOverTimeChart');
        if (motCtx && motLabels.length > 0) {
            new Chart(motCtx, {
                type: 'bar',
                data: {
                    labels: motLabels,
                    datasets: [
                        {
                            label: 'Qty In',
                            data: motIn
                        },
                        {
                            label: 'Qty Out',
                            data: motOut
                        }
                    ]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: { position: 'top' }
                    },
                    scales: {
                        y: { beginAtZero: true },
                        x: {
                            ticks: { autoSkip: false, maxRotation: 90, minRotation: 45 }
                        }
                    }
                }
            });
        }

        // ===== Top Moved Products (horizontal bar) =====
        const tiLabels = [
        @foreach (var x in Model.MovementByItem)
        {
            @:$"'{x.ItemName}',"
        }
        ];
        const tiData = [
        @foreach (var x in Model.MovementByItem)
        {
            @:$"{x.TotalMovement},"
        }
        ];

        const tiCtx = document.getElementById('topItemsChart');
        if (tiCtx && tiLabels.length > 0) {
            new Chart(tiCtx, {
                type: 'bar',
                data: {
                    labels: tiLabels,
                    datasets: [{
                        data: tiData
                    }]
                },
                options: {
                    indexAxis: 'y',
                    responsive: true,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        x: { beginAtZero: true }
                    }
                }
            });
        }
    </script>
}
