@page
@model ZororoMemorialPark.Pages.Graves.GravesModel

@{
    ViewData["Title"] = "Graves";
}

@using Microsoft.AspNetCore.Identity
@inject UserManager<IdentityUser> UserManager

@{
    bool isManager = User.IsInRole("Manager");
    bool isOps = User.IsInRole("OperationsOfficer");
    bool isFinance = User.IsInRole("FinanceOfficer");
    bool isAgent = User.IsInRole("Agent");
}

<style>
    .tab-pane {
        border: 2px solid transparent;
        border-radius: 0 0 .25rem .25rem;
        padding: 1rem;
    }

    /* Tab pane border colors (ACTIVE ONLY) */
    #underconstruction.active.show {
        border-color: saddlebrown;

    }
    /* UNDER CONSTRUCTION */
    .nav-tabs .nav-link.tab-underconstruction {
        background-color: saddlebrown;
        color:white;
        
    }

    #available.active.show {
        border-color: #28a745;
    }
    /* AVAILABLE / UNSOLD */
    .nav-tabs .nav-link.tab-available {
        background-color: #28a745;
        color: white;

    }


    #reserved.active.show {
        border-color: #ffc107;
    }

    /* RESERVED */
    .nav-tabs .nav-link.tab-reserved {
        background-color: #ffc107;
        color: #FFFFFF;
    }

    #occupied.active.show {
        border-color: #343a40;
    }
    /* OCCUPIED */
    .nav-tabs .nav-link.tab-occupied {
        background-color: #343a40;
        color:white;
    }

    /* Active tab reinforcement */
    .nav-tabs .nav-link.active {
        filter: brightness(1.05);
        box-shadow: inset 0 -3px 0 rgba(0,0,0,.2);
    }

    /* Hover */
    .nav-tabs .nav-link:hover {
        filter: brightness(0.95);
    }
</style>


<div class="container-fluid py-4 mb-4">
    <div class="col-lg-12 mx-auto">
        <div class="card shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center"
                 style="background-color: var(--primary-green); color: var(--primary-white);">
                <h5 class="mb-0">Graves</h5>
                <div>
                    @if (isManager || isOps)
                    {
                        <button class="btn btn-sm btn-light me-2" data-bs-toggle="modal" data-bs-target="#createGraveModal">
                            <i class="bi bi-plus-circle"></i> Add Grave
                        </button>
                        <button class="btn btn-sm btn-light" data-bs-toggle="modal" data-bs-target="#bulkGraveModal">
                            <i class="bi bi-stack"></i> Bulk Generate
                        </button>
                    }
                </div>
            </div>

            <div class="card-body">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert" id="successMessage">
                        @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                <!-- TABS -->
                <ul class="nav nav-tabs mb-3" id="graveTabs" role="tablist">

                    @if (isManager || isOps)
                    {
                        <li class="nav-item">
                            <button class="nav-link tab-underconstruction @(Model.ActiveTab == "underconstruction" ? "active" : "")"
                                    data-bs-toggle="tab"
                                    data-bs-target="#underconstruction"
                                    type="button">
                                Under Construction
                            </button>
                        </li>
                    }

                    @if (isManager || isOps || isFinance || isAgent)
                    {
                        <li class="nav-item">
                            <button class="nav-link tab-available @(Model.ActiveTab == "available" ? "active" : "")"
                                    data-bs-toggle="tab"
                                    data-bs-target="#available"
                                    type="button">
                                Unsold
                            </button>
                        </li>
                    }

                    @if (isManager || isOps || isFinance)
                    {
                        <li class="nav-item">
                            <button class="nav-link tab-reserved @(Model.ActiveTab == "reserved" ? "active" : "")"
                                    data-bs-toggle="tab"
                                    data-bs-target="#reserved"
                                    type="button">
                                Reserved
                            </button>
                        </li>
                    }

                    @if (isManager || isOps)
                    {
                        <li class="nav-item">
                            <button class="nav-link tab-occupied @(Model.ActiveTab == "occupied" ? "active" : "")"
                                    data-bs-toggle="tab"
                                    data-bs-target="#occupied"
                                    type="button">
                                Occupied
                            </button>
                        </li>
                    }
                </ul>



                <div class="tab-content">

                    <div class="tab-pane fade @(Model.ActiveTab == "underconstruction" ? "show active" : "")" id="underconstruction">
                        @await Html.PartialAsync("_GravesTablePartial", new
                            {
                                Graves = Model.UnderConstructionGraves,
                                Status = "Under Construction",
                                PageNumber = Model.PageNumber,
                                PageSize = Model.PageSize,
                                TotalCount = Model.UnderConstructionTotalCount,
                                SearchTerm = Model.SearchTerm,
                                ActiveTab = "underconstruction"
                            })
                    </div>

                    <div class="tab-pane fade @(Model.ActiveTab == "available" ? "show active" : "")" id="available">
                        @await Html.PartialAsync("_GravesTablePartial", new
                            {
                                Graves = Model.AvailableGraves,
                                Status = "Unsold",
                                PageNumber = Model.PageNumber,
                                PageSize = Model.PageSize,
                                TotalCount = Model.AvailableTotalCount,
                                SearchTerm = Model.SearchTerm,
                                ActiveTab = "available"
                            })
                    </div>

                    <div class="tab-pane fade @(Model.ActiveTab == "reserved" ? "show active" : "")" id="reserved">
                        @await Html.PartialAsync("_GravesTablePartial", new
                            {
                                Graves = Model.ReservedGraves,
                                Status = "Reserved",
                                PageNumber = Model.PageNumber,
                                PageSize = Model.PageSize,
                                TotalCount = Model.ReservedTotalCount,
                                SearchTerm = Model.SearchTerm,
                                ActiveTab = "reserved"
                            })
                    </div>

                    <div class="tab-pane fade @(Model.ActiveTab == "occupied" ? "show active" : "")" id="occupied">
                        @await Html.PartialAsync("_GravesTablePartial", new
                            {
                                Graves = Model.OccupiedGraves,
                                Status = "Occupied",
                                PageNumber = Model.PageNumber,
                                PageSize = Model.PageSize,
                                TotalCount = Model.OccupiedTotalCount,
                                SearchTerm = Model.SearchTerm,
                                ActiveTab = "occupied"
                            })
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>


<!-- Modals -->
<!-- Tombstone Order Modal -->
<div class="modal fade" id="tombstoneOrderModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title">Order Tombstone</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <form method="post" asp-page-handler="SaveTombstoneOrder">
                <div class="modal-body">
                    <input type="hidden" name="sys_graveId" id="selectedGraveId" />

                    <div class="mb-3">
                        <label class="form-label">Select Tombstone</label>
                        <select name="sys_tombstoneId" class="form-select" required>
                            <option value="">-- Select --</option>
                            @foreach (var t in Model.AvailableTombstones)
                            {
                                <option value="@t.sys_tombstoneId">@t.sys_tombstoneName - $@t.sys_price</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label>Buyer Name</label>
                        <input type="text" name="sys_buyerName" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label>Buyer Contact</label>
                        <input type="text" name="sys_buyerContact" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label>Amount Paid</label>
                        <input type="number" step="0.01" name="sys_amountPaid" class="form-control" required />
                    </div>

                    <hr />
                    <h6>Installation Details</h6>

                    <div class="mb-3">
                        <label>Proposed Installation Date</label>
                        <input type="date" name="sys_installationDate" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label>Proposed Installer</label>
                        <input type="text" name="sys_installedBy" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label>Tombstone Permit Details</label>
                        <textarea name="sys_remarks" class="form-control" required></textarea>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="submit" class="btn btn-success">Save Payment</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Create Single Grave Modal -->
<div class="modal fade" id="createGraveModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header" style="background-color: var(--primary-green); color: var(--primary-white);">
                <h5 class="modal-title">Add Grave</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body bg-light">
                <form method="post" asp-page-handler="Create" id="createGraveForm">
                    <div class="row">
                        <div class="col-sm-6">
                            <div class="mb-3">
                                <label class="form-label fw-bold">Plot Number</label>
                                <input min="1" type="number" name="sys_plotNumber" class="form-control border"
                                       style="border-color: var(--primary-green);" required />
                            </div>
                        </div>

                        <div class="col-sm-6">
                            <div class="mb-3">
                                <label class="form-label fw-bold">Section</label>
                                <select name="sys_sectionId" class="form-select" required>
                                    @foreach (var sec in Model.Sections)
                                    {
                                        <option value="@sec.sys_sectionId">@sec.sys_sectionName</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="col-sm-6">
                            <div class="mb-3">
                                <label class="form-label fw-bold">Stage</label>
                                <select name="sys_stageId" class="form-select" required>
                                    @foreach (var stage in Model.Stages)
                                    {
                                        <option value="@stage.sys_stageId">@stage.sys_stageName</option>
                                    }
                                </select>
                            </div>
                        </div>

                        

                        <div class="col-sm-6">
                            <div class="mb-3">
                                <label class="form-label fw-bold">Sale Status</label>
                                <select name="sys_graveSaleStatus" class="form-select">
                                    <option value="Under Construction">Under Construction</option>
                                    <option value="Unsold">Unsold</option>
                                    <option value="Sold">Sold</option>
                                    <option value="Reserved">Reserved</option>
                                </select>
                            </div>
                        </div>

                        <div class="col-sm-6">
                            <div class="mb-3">
                                <label class="form-label fw-bold">Latitude</label>
                                <input name="sys_Latitude" value="0.0" class="form-control border"
                                       style="border-color: var(--primary-green);" />
                            </div>
                        </div>

                        <div class="col-sm-6">
                            <div class="mb-3">
                                <label class="form-label fw-bold">Longitude</label>
                                <input name="sys_Longitude" value="0.0" class="form-control border"
                                       style="border-color: var(--primary-green);" />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="text-end">
                            <button type="submit" class="btn btn-primary">Save</button>
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Bulk Generate Graves Modal -->
<div class="modal fade" id="bulkGraveModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header" style="background-color: var(--primary-green); color: var(--primary-white);">
                <h5 class="modal-title">Bulk Generate Graves</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body bg-light">
                <form method="post" asp-page-handler="BulkGenerate" id="bulkGraveForm">
                    <div class="row">
                        <div class="col-sm-6">
                            <div class="mb-3">
                                <label class="form-label fw-bold">Number of Graves</label>
                                <input type="number" name="count" class="form-control" min="1" required />
                            </div>
                        </div>

                        <div class="col-sm-6">
                            <div class="mb-3">
                                <label class="form-label fw-bold">Section</label>
                                <select name="sys_sectionId" class="form-select" required>
                                    @foreach (var sec in Model.Sections)
                                    {
                                        <option value="@sec.sys_sectionId">@sec.sys_sectionName</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="col-sm-6">
                            <div class="mb-3">
                                <label class="form-label fw-bold">Stage</label>
                                <select name="sys_stageId" class="form-select" required>
                                    @foreach (var stage in Model.Stages)
                                    {
                                        <option value="@stage.sys_stageId">@stage.sys_stageName</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="col-sm-6">
                            <div class="mb-3">
                                <label class="form-label fw-bold">Starting Plot Number</label>
                                <input type="number" name="plotSeed" class="form-control" min="1" required />
                            </div>
                        </div>

                        
                    </div>

                    <div class="row">
                        <div class="text-end">
                            <button type="submit" class="btn btn-primary">Generate</button>
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Edit Grave Modal -->
<div class="modal fade" id="editGraveModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header" style="background-color: var(--primary-green); color: var(--primary-white);">
                <h5 class="modal-title">Edit Grave</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body bg-light">
                <form method="post" asp-page-handler="Edit" id="editGraveForm">
                    <input type="hidden" name="sys_graveId" />

                    <div class="mb-3">
                        <label class="form-label fw-bold">Plot Number</label>
                        <input name="sys_plotNumber" class="form-control border" style="border-color: var(--primary-green);" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Section</label>
                        <select name="sys_sectionId" class="form-select border" style="border-color: var(--primary-green);">
                            @foreach (var grave_section in Model.Sections)
                            {
                                <option value="@grave_section.sys_sectionId">@grave_section.sys_sectionName</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Development Stage</label>
                        <select name="sys_stageId" class="form-select border" style="border-color: var(--primary-green);">
                            @foreach (var stage in Model.Stages)
                            {
                                <option value="@stage.sys_stageId">@stage.sys_stageName</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Status</label>
                        <select name="sys_graveSaleStatus" class="form-select border" style="border-color: var(--primary-green);">
                            <option value="Under Construction">Under Construction</option>
                            <option value="Unsold">Unsold</option>
                            <option value="Reserved">Reserved</option>
                            <option value="Sold">Sold</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Latitude</label>
                        <input name="sys_Latitude" class="form-control border" style="border-color: var(--primary-green);" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Longitude</label>
                        <input name="sys_Longitude" class="form-control border" style="border-color: var(--primary-green);" />
                    </div>

                    <div class="text-end">
                        <button type="submit" class="btn btn-primary">Update</button>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Delete Grave Modal -->
<div class="modal fade" id="deleteGraveModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header" style="background-color: var(--primary-black); color: var(--primary-white);">
                <h5 class="modal-title">Delete Grave</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body bg-light">
                <form method="post" asp-page-handler="Delete" id="deleteGraveForm">
                    <input type="hidden" name="sys_graveId" />
                    <p class="fw-semibold text-danger">
                        Are you sure you want to delete this grave: <strong id="gravePlotName"></strong>?
                    </p>

                    <div class="text-end">
                        <button type="submit" class="btn btn-danger">Delete</button>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Bulk Delete Modal -->
<div class="modal fade" id="bulkDeleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">Delete Selected Graves</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p id="bulkDeleteMessage">Are you sure you want to delete the selected graves?</p>
            </div>
            <div class="modal-footer">
                <form method="post" asp-page-handler="DeleteSelected" id="bulkDeleteForm">
                    <input type="hidden" name="SelectedIds" id="SelectedIds" />
                    <button type="submit" class="btn btn-danger">Delete</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    // Edit Grave Modal
    var editModal = document.getElementById('editGraveModal');
    if (editModal) {
        editModal.addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;
            var graveId = button.getAttribute('data-id');
            var plotNumber = button.getAttribute('data-plot');
            var sectionId = button.getAttribute('data-section');
            var stageId = button.getAttribute('data-stage');
            
            var status = button.getAttribute('data-status');
            var latitude = button.getAttribute('data-latitude');
            var longitude = button.getAttribute('data-longitude');

            var modal = this;
            modal.querySelector('input[name="sys_graveId"]').value = graveId;
            modal.querySelector('input[name="sys_plotNumber"]').value = plotNumber;
            modal.querySelector('select[name="sys_sectionId"]').value = sectionId;
            modal.querySelector('select[name="sys_stageId"]').value = stageId;
           
            modal.querySelector('select[name="sys_graveSaleStatus"]').value = status;
            modal.querySelector('input[name="sys_Latitude"]').value = latitude;
            modal.querySelector('input[name="sys_Longitude"]').value = longitude;
        });
    }

    // Delete Grave Modal
    var deleteModal = document.getElementById('deleteGraveModal');
    if (deleteModal) {
        deleteModal.addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;
            var graveId = button.getAttribute('data-id');
            var plotNumber = button.getAttribute('data-plot');

            var modal = this;
            modal.querySelector('input[name="sys_graveId"]').value = graveId;
            modal.querySelector('#gravePlotName').textContent = plotNumber;
        });
    }

    document.addEventListener("DOMContentLoaded", () => {
        // Select/Deselect All per tab
        document.querySelectorAll("input[id^='selectAll-']").forEach(selectAll => {
            selectAll.addEventListener("change", function () {
                const tabPane = this.closest(".tab-pane");
                if (!tabPane) return;

                const checkboxes = tabPane.querySelectorAll(".row-checkbox");
                checkboxes.forEach(cb => cb.checked = this.checked);

                toggleDeleteButton(tabPane);
            });
        });

        // Row checkbox listeners
        document.querySelectorAll(".tab-pane .row-checkbox").forEach(cb => {
            cb.addEventListener("change", function () {
                const tabPane = this.closest(".tab-pane");
                toggleDeleteButton(tabPane);
            });
        });

        // Enable/disable delete button
        function toggleDeleteButton(tabPane) {
            const deleteBtn = tabPane.querySelector(".btn[data-bs-target='#bulkDeleteModal']");
            if (!deleteBtn) return;

            const checked = tabPane.querySelectorAll(".row-checkbox:checked").length;
            deleteBtn.disabled = checked === 0;
        }

        // Bulk Delete Modal Handling
        const bulkDeleteModal = document.getElementById("bulkDeleteModal");
        const selectedIdsInput = document.getElementById("SelectedIds");
        const bulkDeleteMessage = document.getElementById("bulkDeleteMessage");

        if (bulkDeleteModal) {
            bulkDeleteModal.addEventListener("show.bs.modal", function (event) {
                const triggerBtn = event.relatedTarget;
                const tabPane = triggerBtn.closest(".tab-pane");

                const ids = Array.from(tabPane.querySelectorAll(".row-checkbox:checked"))
                    .map(cb => cb.value);

                if (ids.length > 0) {
                    selectedIdsInput.value = ids.join(",");
                    bulkDeleteMessage.textContent = `Are you sure you want to delete ${ids.length} selected grave(s)?`;
                } else {
                    selectedIdsInput.value = "";
                    bulkDeleteMessage.textContent = "No graves selected.";
                }
            });
        }

        const tombModal = document.getElementById('tombstoneOrderModal');
        if (tombModal) {
            tombModal.addEventListener('show.bs.modal', event => {
                const button = event.relatedTarget;
                document.getElementById('selectedGraveId').value = button.getAttribute('data-graveid');
            });
        }
    });
</script>


<script>
    document.querySelectorAll('[data-bs-toggle="tab"]').forEach(tab => {
        tab.addEventListener('shown.bs.tab', e => {
            const target = e.target.getAttribute("data-bs-target").replace("#", "");
            const url = new URL(window.location);
            url.searchParams.set("activeTab", target);
            history.replaceState(null, "", url);
        });
    });
</script>