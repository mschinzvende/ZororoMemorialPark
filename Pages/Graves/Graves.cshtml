@page
@model ZororoMemorialPark.Pages.Graves.GravesModel

@{
    ViewData["Title"] = "Graves";
}

@using Microsoft.AspNetCore.Identity
@inject UserManager<IdentityUser> UserManager

@{
    bool isManager = User.IsInRole("Manager");
    bool isOps = User.IsInRole("OperationsOfficer");
    bool isFinance = User.IsInRole("FinanceOfficer");
    bool isAgent = User.IsInRole("Agent");
}

<style>
    .tab-pane {
    border: 2px solid transparent;
    border-radius: 0 0 .25rem .25rem; /* rounded bottom corners */
    padding: 1rem;
    }

    /* Active tab colors */

    #underConstruction.active.show {
    border-color: saddlebrown;
    }

    #available.active.show {
    border-color: #28a745;
    }

    #reserved.active.show {
    border-color: #ffc107;
    }

    #occupied.active.show {
    border-color: #343a40;
    }
</style>

<div class="row">
    <div class="col-lg-12 mx-auto">
        <div class="card shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center"
            style="background-color: var(--primary-green); color: var(--primary-white);">
                <h5 class="mb-0">Graves</h5>
                <div>
                    @if (isManager || isOps )
                    {


                        <button class="btn btn-sm btn-light me-2" data-bs-toggle="modal" data-bs-target="#createGraveModal">
                            <i class="bi bi-plus-circle"></i> Add Grave
                        </button>
                        <button class="btn btn-sm btn-light" data-bs-toggle="modal" data-bs-target="#bulkGraveModal">
                            <i class="bi bi-stack"></i> Bulk Generate
                        </button>
                    }
                </div>
            </div>

            <div class="card-body">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert" id="successMessage">
                        @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                <!-- Tabs -->
                <ul class="nav nav-tabs mb-3" id="graveTabs" role="tablist">

                    @if (isManager || isOps)
                    {


                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" id="underConstruction-tab" data-bs-toggle="tab" data-bs-target="#underConstruction" type="button" role="tab" style="background-color: saddlebrown; color:white;">
                                Under Construction
                            </button>
                        </li>
                    }

                    @if (isManager || isOps || isFinance || isAgent)
                    {


                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="available-tab" data-bs-toggle="tab" data-bs-target="#available" type="button" role="tab" style="background-color: #28a745; color:white;">
                                Unsold
                            </button>
                        </li>
                    }

                    @if(isManager || isOps || isFinance){


                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="reserved-tab" data-bs-toggle="tab" data-bs-target="#reserved" type="button" role="tab" style="background-color: #ffc107; color:black;">
                                Reserved
                            </button>
                        </li>
                    }

                    @if (isManager || isOps)
                    {
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="occupied-tab" data-bs-toggle="tab" data-bs-target="#occupied" type="button" role="tab" style="background-color: #343a40; color:white;">
                                Occupied
                            </button>
                        </li>
                    }

                </ul>

                <div class="tab-content">

                    <!-- Under Construction Graves -->
                    <div class="tab-pane fade show active" id="underConstruction" role="tabpanel">
                        @await Html.PartialAsync("_GravesTablePartial", new { Graves = Model.UnderConstructionGraves, Status = "Under Construction", PageRouteParam = "availablePage" })
                    </div>

                    <!-- Available Graves -->
                    <div class="tab-pane fade" id="available" role="tabpanel">
                        @await Html.PartialAsync("_GravesTablePartial", new { Graves = Model.AvailableGraves, Status = "Unsold", PageRouteParam = "availablePage" })
                    </div>

                    <!-- Reserved Graves -->
                    <div class="tab-pane fade" id="reserved" role="tabpanel">
                        @await Html.PartialAsync("_GravesTablePartial", new { Graves = Model.ReservedGraves, Status = "Reserved", PageRouteParam = "reservedPage" })
                    </div>

                    <!-- Occupied Graves -->
                    <div class="tab-pane fade" id="occupied" role="tabpanel">
                        @await Html.PartialAsync("_GravesTablePartial", new { Graves = Model.OccupiedGraves, Status = "Occupied", PageRouteParam = "occupiedPage" })
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<!-- Modals -->

<!--Sell Tombstone for a grave-->
<!-- Tombstone Order Modal -->
<div class="modal fade" id="tombstoneOrderModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title">Order Tombstone</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <form method="post" asp-page-handler="SaveTombstoneOrder">
                <div class="modal-body">
                    <input type="hidden" name="sys_graveId" id="selectedGraveId" />

                    <div class="mb-3">
                        <label class="form-label">Select Tombstone</label>
                        <select name="sys_tombstoneId" class="form-select" required>
                            <option value="">-- Select --</option>
                            @foreach (var t in Model.AvailableTombstones)
                            {
                                <option value="@t.sys_tombstoneId">@t.sys_tombstoneName - $@t.sys_price</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label>Buyer Name</label>
                        <input type="text" name="sys_buyerName" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label>Buyer Contact</label>
                        <input type="text" name="sys_buyerContact" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label>Amount Paid</label>
                        <input type="number" step="0.01" name="sys_amountPaid" class="form-control"  required />
                    </div>

                    <hr />
                    <h6>Installation Details</h6>

                    <div class="mb-3">
                        <label>Proposed Installation Date</label>
                        <input type="date" name="sys_installationDate" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label>Proposed Installer</label>
                        <input type="text" name="sys_installedBy" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label>Tombstone Permit Details</label>
                        <textarea name="sys_remarks" class="form-control" required ></textarea>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="submit" class="btn btn-success">Save Payment</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!--End of Sell Tombstone for a grave-->





@* Create Single Grave Modal *@
<div class="modal fade" id="createGraveModal" tabindex="-1">
