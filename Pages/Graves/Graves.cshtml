@page
@model ZororoMemorialPark.Pages.Graves.GravesModel

@{
    ViewData["Title"] = "Graves";
}

<div class="row">
    <div class="col-lg-11 mx-auto">
        <div class="card shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center"
                 style="background-color: var(--primary-green); color: var(--primary-white);">
                <h5 class="mb-0">Graves</h5>
                <div>
                    <button class="btn btn-sm btn-light me-2" data-bs-toggle="modal" data-bs-target="#createGraveModal">
                        <i class="bi bi-plus-circle"></i> Add Grave
                    </button>
                    <button class="btn btn-sm btn-light" data-bs-toggle="modal" data-bs-target="#bulkGraveModal">
                        <i class="bi bi-stack"></i> Bulk Generate
                    </button>
                </div>
            </div>

            <div class="card-body">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert" id="successMessage">
                        @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <!-- Search -->
                    <input type="text" id="searchInput" class="form-control w-50" placeholder="Search graves...">

                    <!-- Delete Selected -->

                        <button id="deleteSelectedBtn" type="button" class="btn btn-danger btn-sm" disabled
                                data-bs-toggle="modal" data-bs-target="#bulkDeleteModal">
                            <i class="bi bi-trash"></i> Delete Selected
                        </button>

                </div>

                
                    <table class="table table-responsive table-striped table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th><input type="checkbox" id="selectAll"></th>
                                <th>Plot Number</th>
                                <th>Section</th>
                                <th>Stage</th>
                                <th>Status</th>
                                <th>Price</th>
                                <th>Location</th>
                                <th style="width:150px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="gravesTable">
                            @foreach (var grave in Model.PaginatedGraves)
                            {
                                <tr id="row-@grave.sys_graveId">
                                    <td>
                                        <input type="checkbox" class="row-checkbox" value="@grave.sys_graveId">
                                    </td>
                                    <td><a asp-page="/Graves/GraveDetails" asp-route-id="@grave.sys_graveId">@grave.sys_plotNumber</a></td>
                                    <td>@grave.SectionName</td>
                                    <td>@grave.StageName</td>
                                    <td>@grave.sys_graveSaleStatus</td>
                                    <td>@grave.sys_price.ToString("C")</td>
                                    <td>@grave.sys_latitude,@grave.sys_longitude</td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-secondary"
                                                data-bs-toggle="modal"
                                                data-bs-target="#editGraveModal"
                                                data-id="@grave.sys_graveId"
                                                data-plot="@grave.sys_plotNumber"
                                                data-section="@grave.sys_sectionId"
                                                data-stage="@grave.sys_stageId"
                                                data-status="@grave.sys_graveSaleStatus"
                                                data-price="@grave.sys_price"
                                                data-latitude="@grave.sys_latitude"
                                                data-longitude="@grave.sys_longitude">
                                            Edit
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger"
                                                data-bs-toggle="modal"
                                                data-bs-target="#deleteGraveModal"
                                                data-id="@grave.sys_graveId"
                                                data-plot="@grave.sys_plotNumber">
                                            Delete
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    

                
            </div>

            <!-- Pagination -->
            <div class="card-footer d-flex justify-content-between align-items-center mb-lg-5"
                 style="background-color: var(--primary-grey);">
                <span>Page @Model.PaginatedGraves.PageIndex of @Model.PaginatedGraves.TotalPages</span>
                <nav>
                    <ul class="pagination">
                        <li class="page-item @(Model.PaginatedGraves.HasPreviousPage ? "" : "disabled")">
                            <a class="page-link" asp-route-pageIndex="@(Model.PaginatedGraves.PageIndex - 1)">Previous</a>
                        </li>
                        @for (int i = 1; i <= Model.PaginatedGraves.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.PaginatedGraves.PageIndex ? "active" : "")">
                                <a class="page-link" asp-route-pageIndex="@i">@i</a>
                            </li>
                        }
                        <li class="page-item @(Model.PaginatedGraves.HasNextPage ? "" : "disabled")">
                            <a class="page-link" asp-route-pageIndex="@(Model.PaginatedGraves.PageIndex + 1)">Next</a>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</div>

<!-- Modals -->
@* Create Single Grave Modal *@
<div class="modal fade" id="createGraveModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header" style="background-color: var(--primary-green); color: var(--primary-white);">
                <h5 class="modal-title">Add Grave</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body bg-light">
                <form method="post" asp-page-handler="Create" id="createGraveForm">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Plot Number</label>
                        <input min="1" type="number" name="sys_plotNumber" class="form-control border" style="border-color: var(--primary-green);" required/>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Section</label>
                        <select name="sys_sectionId" class="form-select" required>
                            @foreach (var sec in Model.Sections)
                            {
                                <option value="@sec.sys_sectionId">@sec.sys_sectionName</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Stage</label>
                        <select name="sys_stageId" class="form-select" required>
                            @foreach (var stage in Model.Stages)
                            {
                                <option value="@stage.sys_stageId">@stage.sys_stageName</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Price</label>
                        <input type="number" name="sys_price" step="0.01" class="form-control" min="0" />
                    </div>
                    <div class="mb-3">

                        
                        <label class="form-label fw-bold">Sale Status</label>
                        <select name="sys_graveSaleStatus" class="form-select">
                            <option value="Available">Available</option>
                            <option value="Sold">Sold</option>
                            <option value="Reserved">Reserved</option>

                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Latitude</label>
                        <input name="sys_Latitude" value="0.0" class="form-control border" style="border-color: var(--primary-green);" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Longitude</label>
                        <input name="sys_Longitude" value="0.0" class="form-control border" style="border-color: var(--primary-green);" />
                    </div>
                    <div class="text-end">
                        <button type="submit" class="btn btn-primary">Save</button>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@* Bulk Generate Graves Modal *@
<div class="modal fade" id="bulkGraveModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header" style="background-color: var(--primary-green); color: var(--primary-white);">
                <h5 class="modal-title">Bulk Generate Graves</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body bg-light">
                <form method="post" asp-page-handler="BulkGenerate" id="bulkGraveForm">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Number of Graves</label>
                        <input type="number" name="count" class="form-control" min="1" required/>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Section</label>
                        <select name="sys_sectionId" class="form-select" required>
                            @foreach (var sec in Model.Sections)
                            {
                                <option value="@sec.sys_sectionId">@sec.sys_sectionName</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Stage</label>
                        <select name="sys_stageId" class="form-select" required>
                            @foreach (var stage in Model.Stages)
                            {
                                <option value="@stage.sys_stageId">@stage.sys_stageName</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Starting Plot Number</label>
                        <input type="number" name="plotSeed" class="form-control" min="1" required/>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Price</label>
                        <input type="number" name="sys_price" step="0.01" class="form-control" min="0"/>
                    </div>
                    <div class="text-end">
                        <button type="submit" class="btn btn-primary">Generate</button>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>


<!-- Edit Grave Modal -->
<div class="modal fade" id="editGraveModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header" style="background-color: var(--primary-green); color: var(--primary-white);">
                <h5 class="modal-title">Edit Grave</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body bg-light">
                <form method="post" asp-page-handler="Edit" id="editGraveForm">
                    <input type="hidden" name="sys_graveId" />

                    <div class="mb-3">
                        <label class="form-label fw-bold">Plot Number</label>
                        <input name="sys_plotNumber" class="form-control border" style="border-color: var(--primary-green);" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Section</label>
                        <select name="sys_sectionId" class="form-select border" style="border-color: var(--primary-green);">
                            @foreach (var grave_section in Model.Sections)
                            {
                                <option value="@grave_section.sys_sectionId">@grave_section.sys_sectionName</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Development Stage</label>
                        <select name="sys_stageId" class="form-select border" style="border-color: var(--primary-green);">
                            @foreach (var stage in Model.Stages)
                            {
                                <option value="@stage.sys_stageId">@stage.sys_stageName</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Price</label>
                        <input type="number" step="0.01" name="sys_price" class="form-control border" style="border-color: var(--primary-green);" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Status</label>
                        <select name="sys_graveSaleStatus" class="form-select border" style="border-color: var(--primary-green);">
                            <option value="Available">Available</option>
                            <option value="Reserved">Reserved</option>
                            <option value="Sold">Sold</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Latitude</label>
                        <input name="sys_Latitude" class="form-control border" style="border-color: var(--primary-green);" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Longitude</label>
                        <input name="sys_Longitude" class="form-control border" style="border-color: var(--primary-green);" />
                    </div>
                    <div class="text-end">
                        <button type="submit" class="btn btn-primary">Update</button>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>



<!-- Delete Grave Modal -->
<div class="modal fade" id="deleteGraveModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header" style="background-color: var(--primary-black); color: var(--primary-white);">
                <h5 class="modal-title">Delete Grave</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body bg-light">
                <form method="post" asp-page-handler="Delete" id="deleteGraveForm">
                    <input type="hidden" name="sys_graveId" />
                    <p class="fw-semibold text-danger">
                        Are you sure you want to delete this grave: <strong id="gravePlotName"></strong>?
                    </p>

                    <div class="text-end">
                        <button type="submit" class="btn btn-danger">Delete</button>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>


<!-- Bulk Delete Modal -->
<div class="modal fade" id="bulkDeleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">Delete Selected Graves</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p id="bulkDeleteMessage">Are you sure you want to delete the selected graves?</p>
            </div>
            <div class="modal-footer">
                <form method="post" asp-page-handler="DeleteSelected" id="bulkDeleteForm">
                    <input type="hidden" name="SelectedIds" id="SelectedIds" />
                    <button type="submit" class="btn btn-danger">Delete</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                </form>
            </div>
        </div>
    </div>
</div>



<script>
    // Edit Grave Modal
    var editModal = document.getElementById('editGraveModal');
    editModal.addEventListener('show.bs.modal', function (event) {
        var button = event.relatedTarget;
        var graveId = button.getAttribute('data-id');
        var plotNumber = button.getAttribute('data-plot');
        var sectionId = button.getAttribute('data-section');
        var stageId = button.getAttribute('data-stage');
        var price = button.getAttribute('data-price');
        var status = button.getAttribute('data-status');
        var latitude = button.getAttribute('data-latitude');
        var longitude = button.getAttribute('data-longitude');

        var modal = this;
        modal.querySelector('input[name="sys_graveId"]').value = graveId;
        modal.querySelector('input[name="sys_plotNumber"]').value = plotNumber;
        modal.querySelector('select[name="sys_sectionId"]').value = sectionId;
        modal.querySelector('select[name="sys_stageId"]').value = stageId;
        modal.querySelector('input[name="sys_price"]').value = price;
        modal.querySelector('select[name="sys_graveSaleStatus"]').value = status;
        modal.querySelector('input[name="sys_Latitude"]').value = latitude;
        modal.querySelector('input[name="sys_Longitude"]').value = longitude;
    });

    // Delete Grave Modal
    var deleteModal = document.getElementById('deleteGraveModal');
    deleteModal.addEventListener('show.bs.modal', function (event) {
        var button = event.relatedTarget;
        var graveId = button.getAttribute('data-id');
        var plotNumber = button.getAttribute('data-plot');

        var modal = this;
        modal.querySelector('input[name="sys_graveId"]').value = graveId;
        modal.querySelector('#gravePlotName').textContent = plotNumber;
    });
</script>


<script>
    // --- Live Search ---
    document.getElementById("searchInput").addEventListener("keyup", function () {
        let filter = this.value.toLowerCase();
        let rows = document.querySelectorAll("#gravesTable tr");
        rows.forEach(row => {
            let text = row.innerText.toLowerCase();
            row.style.display = text.includes(filter) ? "" : "none";
        });
    });

    // --- Checkbox Select/Deselect ---
    const selectAll = document.getElementById("selectAll");
    const deleteBtn = document.getElementById("deleteSelectedBtn");

    selectAll.addEventListener("change", function () {
        let checkboxes = document.querySelectorAll(".row-checkbox");
        checkboxes.forEach(cb => cb.checked = this.checked);
        toggleDeleteButton();
    });

    document.addEventListener("change", function (e) {
        if (e.target.classList.contains("row-checkbox")) {
            toggleDeleteButton();
        }
    });

    function toggleDeleteButton() {
        let checked = document.querySelectorAll(".row-checkbox:checked").length;
        deleteBtn.disabled = checked === 0;
    }

    // --- Bulk Delete Modal Handling ---
    const bulkDeleteModal = document.getElementById("bulkDeleteModal");
    const bulkDeleteMessage = document.getElementById("bulkDeleteMessage");
    const selectedIdsInput = document.getElementById("SelectedIds");

    bulkDeleteModal.addEventListener("show.bs.modal", function () {
        let ids = Array.from(document.querySelectorAll(".row-checkbox:checked"))
            .map(cb => cb.value);

        if (ids.length > 0) {
            selectedIdsInput.value = ids.join(",");
            bulkDeleteMessage.textContent = `Are you sure you want to delete ${ids.length} selected grave(s)?`;
        }
    });
</script>




