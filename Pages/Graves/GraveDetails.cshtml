<script>
    document.getElementById("burialDate").addEventListener("change", async function () {
        const burialDate = this.value;
        const timeSelect = document.getElementById("burialTime");
        const messageEl = document.getElementById("slotMessage");
        const submitBtn = document.getElementById("allocateSubmitBtn");

        if (!burialDate) return;

        try {
            const response = await fetch(`?handler=AvailableBurialSlots&burialDate=${encodeURIComponent(burialDate)}`);
            const result = await response.json();

            // Clear old options
            timeSelect.innerHTML = `<option value="">-- Select a slot --</option>`;

            if (result.slots.length === 0) {
                messageEl.textContent = result.message || "No slots available.";
                submitBtn.disabled = true;
            } else {
                messageEl.textContent = "";
                submitBtn.disabled = false;

                result.slots.forEach(slot => {
                    const date = new Date(slot);
                    const opt = document.createElement("option");
                    opt.value = slot;
                    opt.textContent = date.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                    timeSelect.appendChild(opt);
                });
            }
        } catch (error) {
            console.error("Error fetching slots:", error);
            messageEl.textContent = "Could not load slots.";
            submitBtn.disabled = true;
        }
    });
</script>


