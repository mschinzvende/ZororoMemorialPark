<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function () {

        // --- Allocation Payment Modal ---
        const allocationModal = document.getElementById("allocationPaymentModal");
        if (allocationModal) {
            allocationModal.addEventListener("show.bs.modal", function (event) {
                const button = event.relatedTarget;
                document.getElementById("allocationId").value = button.getAttribute("data-allocationid");
            });
        }

        // --- Edit Job Modal ---
        const editModal = document.getElementById("editModal");
        if (editModal) {
            editModal.addEventListener("show.bs.modal", function (event) {
                const button = event.relatedTarget;

                document.getElementById("editJobId").value = button.getAttribute("data-id");
                document.getElementById("editGraveId").value = button.getAttribute("data-grave");
                document.getElementById("editSupplierId").value = button.getAttribute("data-supplier");
                document.getElementById("editStageId").value = button.getAttribute("data-stage");
                document.getElementById("editStartDate").value = button.getAttribute("data-start");
                document.getElementById("editEndDate").value = button.getAttribute("data-end");
                document.getElementById("editStatus").value = button.getAttribute("data-status");
            });
        }

        // --- Delete Job Modal ---
        const deleteModal = document.getElementById("deleteModal");
        if (deleteModal) {
            deleteModal.addEventListener("show.bs.modal", function (event) {
                const button = event.relatedTarget;
                document.getElementById("deleteJobId").value = button.getAttribute("data-id");
            });
        }

        // --- Payment Modal Function ---
        window.openPaymentModal = function (jobId, supplierId) {
            $("#paymentJobId").val(jobId);
            $("#paymentSupplierId").val(supplierId);

            fetch(`?handler=Payments&jobId=${jobId}`)
                .then(r => r.json())
                .then(data => {
                    let rows = "";
                    let hasPayments = data.length > 0;
                    let lastBalance = 0;

                    data.forEach((p, index) => {
                        let amountDue = (index === 0) ? p.amountDue : lastBalance;
                        rows += `<tr>
                            <td>${p.paymentDate}</td>
                            <td>${amountDue}</td>
                            <td>${p.amountPaid}</td>
                            <td>${p.balance}</td>
                        </tr>`;
                        lastBalance = p.balance;
                    });

                    $("#previousPaymentsBody").html(rows);

                    if (hasPayments) {
                        $("#amountDue").val(lastBalance).prop("readonly", true);
                        $("#currentBalance").val(lastBalance);
                        $("#amountPaid").attr("max", lastBalance);
                    } else {
                        $("#amountDue").val("").prop("readonly", false);
                        $("#currentBalance").val("");
                        $("#amountPaid").removeAttr("max");
                    }

                    $("#paymentModal").modal("show");
                });
        };

        // --- Dynamic max update ---
        $("#amountDue").on("input", function () {
            let due = parseFloat($(this).val()) || 0;
            $("#amountPaid").attr("max", due);
        });

        // --- Evaluation Modal ---
        window.openEvaluationModal = function (jobId) {
            $('#evaluationJobId').val(jobId);

            $.getJSON('?handler=EvaluationParameters&jobId=' + jobId, function (data) {
                let container = $('#evaluationParametersContainer');
                container.empty();

                if (data && data.length > 0) {
                    data.forEach(param => {
                        container.append(`
                            <div class="col-sm-4">
                                <div class="mb-2">
                                    <label>${param.sys_parameterName}</label>
                                    <input type="hidden" name="parameterIds" value="${param.sys_jobEvaluationParameterId}" />
                                    <input type="text" class="form-control"
                                        name="evaluation_${param.sys_jobEvaluationParameterId}"
                                        value="${param.sys_jobEvaluation ?? ''}" />
                                </div>
                            </div>
                        `);
                    });
                } else {
                    container.append(`<p class="text-muted">No evaluation parameters defined.</p>`);
                }

                $('#evaluationModal').modal('show');
            });
        };

        // --- Burial Slots ---
        const burialDateInput = document.getElementById("burialDate");
        if (burialDateInput) {
            burialDateInput.addEventListener("change", async function () {
                const burialDate = this.value;
                const timeSelect = document.getElementById("burialTime");
                const messageEl = document.getElementById("slotMessage");
                const submitBtn = document.getElementById("allocateSubmitBtn");

                if (!burialDate) return;

                try {
                    const response = await fetch(`?handler=AvailableBurialSlots&burialDate=${encodeURIComponent(burialDate)}`);
                    const result = await response.json();

                    timeSelect.innerHTML = `<option value="">-- Select a slot --</option>`;

                    if (result.slots.length === 0) {
                        messageEl.textContent = result.message || "No slots available.";
                        submitBtn.disabled = true;
                    } else {
                        messageEl.textContent = "";
                        submitBtn.disabled = false;

                        result.slots.forEach(slot => {
                            const date = new Date(slot);
                            const opt = document.createElement("option");
                            opt.value = slot;
                            opt.textContent = date.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                            timeSelect.appendChild(opt);
                        });
                    }
                } catch (error) {
                    console.error("Error fetching slots:", error);
                    messageEl.textContent = "Could not load slots.";
                    submitBtn.disabled = true;
                }
            });
        }
    });
</script>

<script>
const receiptInput = document.getElementById("receiptNumber");
const validationMsg = document.getElementById("receiptValidationMsg");

// Case 1: Agent with record (hidden input, single book)
const hiddenBook = document.getElementById("receiptBookId");
// Case 2: Agent role only (select with data attributes)
const bookSelect = document.getElementById("receiptBookId") && document.getElementById("receiptBookId").tagName === "SELECT"
    ? document.getElementById("receiptBookId")
    : null;

function validateReceipt() {
    if (!receiptInput) return;

    const receiptNumber = parseInt(receiptInput.value);

    // Clear message if empty
    if (!receiptNumber) {
        validationMsg.textContent = "";
        return;
    }

    // Agent with record → book info comes from server model
    if (hiddenBook && !bookSelect) {
        const start = parseInt("@Model.AgentReceiptBook.sys_startNumber");
        const end = parseInt("@Model.AgentReceiptBook.sys_endNumber");
        const current = parseInt("@Model.AgentReceiptBook.sys_currentNumber");

        if (receiptNumber < start || receiptNumber > end) {
            validationMsg.textContent = "❌ Receipt number not in valid range.";
        } else if (receiptNumber !== current + 1) {
            validationMsg.textContent = `❌ Invalid sequence. Next expected is ${current + 1}.`;
        } else {
            validationMsg.textContent = "✅ Receipt number is valid.";
            validationMsg.className = "text-success small mt-1";
        }
    }

    // Agent role only → book selected from dropdown
    if (bookSelect) {
        const selectedOption = bookSelect.options[bookSelect.selectedIndex];
        if (!selectedOption || !selectedOption.dataset.start) {
            validationMsg.textContent = "";
            return;
        }

        const start = parseInt(selectedOption.dataset.start);
        const end = parseInt(selectedOption.dataset.end);
        const current = parseInt(selectedOption.dataset.current);

        if (receiptNumber < start || receiptNumber > end) {
            validationMsg.textContent = "❌ Receipt number not in valid range.";
        } else if (receiptNumber !== current + 1) {
            validationMsg.textContent = `❌ Invalid sequence. Next expected is ${current + 1}.`;
        } else {
            validationMsg.textContent = "✅ Receipt number is valid.";
            validationMsg.className = "text-success small mt-1";
        }
    }
}

// Bind events
if (receiptInput) {
    receiptInput.addEventListener("input", validateReceipt);
}
if (bookSelect) {
    bookSelect.addEventListener("change", validateReceipt);
}


</script>
