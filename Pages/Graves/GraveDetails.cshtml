@page "{id:int}"
@model ZororoMemorialPark.Pages.Graves.GraveDetailsModel
@{
    ViewData["Title"] = "Grave Details";
}

<div class="row">
    <div class="col-lg-12 mx-auto">
        <div class="card shadow-sm">
            <div class="card-header" style="background-color: var(--primary-green); color: var(--primary-white);">
                <h5 class="mb-0">Grave @Model.Grave.sys_plotNumber Details</h5>
            </div>

            <div class="card-body">

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert" id="successMessage">
                        @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                <!-- Tabs -->
                <ul class="nav nav-tabs mb-3" id="graveTabs" role="tablist">
                    <li class="nav-item">
                        <a class="nav-link active" id="details-tab" data-bs-toggle="tab" href="#details" role="tab">Details</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" id="reservation-tab" data-bs-toggle="tab" href="#reservation" role="tab">Reservations</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" id="jobs-tab" data-bs-toggle="tab" href="#jobs" role="tab">Jobs</a>
                    </li>
                    
                </ul>

                <div class="tab-content">
                    <!-- Details Tab -->
                    <div class="tab-pane fade show active" id="details" role="tabpanel">
                        <div class="row mb-3">
                            <!-- Grave Information -->
                            <div class="col-md-6">
                                <div class="card p-3 mb-3 shadow-sm">
                                    <h6 class="mb-3 border-bottom pb-2">Grave Information</h6>
                                    <dl class="row">
                                        <dt class="col-sm-4">Section</dt>
                                        <dd class="col-sm-8">@Model.Section?.sys_sectionName</dd>

                                        <dt class="col-sm-4">Stage</dt>
                                        <dd class="col-sm-8">@Model.Stage?.sys_stageName</dd>

                                        <dt class="col-sm-4">Plot Number</dt>
                                        <dd class="col-sm-8"><span class="badge bg-primary">@Model.Grave.sys_plotNumber</span></dd>

                                        <dt class="col-sm-4">Status</dt>
                                        <dd class="col-sm-8">
                                            @if (Model.Grave.sys_graveSaleStatus == "Allocated")
                                            {
                                                <span class="badge bg-success">Allocated</span>
                                            }
                                            else if (Model.Grave.sys_graveSaleStatus == "Reserved")
                                            {
                                                <span class="badge bg-warning text-dark">Reserved</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">@Model.Grave.sys_graveSaleStatus</span>
                                            }
                                        </dd>
                                        <dt class="col-sm-4">Location</dt>
                                        <dd class="col-sm-8">(@Model.Grave.sys_latitude, @Model.Grave.sys_longitude)</dd>

                                        @if(Model.Grave.sys_graveSaleStatus=="Reserved"){
                                            <div class="alert alert-info">RESERVED BY @Model.Customer.sys_paymentMadeBy</div>
                                        }
                                        else{
                                            if(Model.Reservation!=null){
                                                <div class="alert alert-info">WAS RESERVED BY @Model.Customer.sys_paymentMadeBy</div>

                                            }
                                            else{

                                            
                                            <dt class="col-sm-4">Price</dt>
                                            <dd class="col-sm-8">$@Model.Grave.sys_price</dd>


                                            <dt class="col-sm-4">Total Paid</dt> 
                                            <dd class="col-sm-8">$@Model.TotalPaidAllocation</dd>

                                            <dt class="col-sm-4">Balance</dt> 
                                            <dd class="col-sm-8">$@Model.AllocationBalance</dd>

                                            <dt class="col-sm-4">Payment Status: </dt>
                                            <dd class="col-sm-8">
                                                <span class="badge @(Model.AllocationPaymentStatus == "Fully Paid" ? "bg-success" : Model.AllocationPaymentStatus == "Partially Paid" ? "bg-warning text-dark" : "bg-danger")">
                                                    @Model.AllocationPaymentStatus
                                                </span> </dd>
                                                }

                                        }
                                    </dl>
                                </div>

                                
                            </div>

                            <!-- Deceased Details -->
                            <div class="col-md-6">
                                <div class="card p-3 mb-3 shadow-sm">
                                    <h6 class="mb-3 border-bottom pb-2">Deceased Details</h6>
                                    @if (Model.Allocation != null)
                                    {
                                        <dl class="row">
                                            <dt class="col-sm-5">Name</dt>
                                            <dd class="col-sm-7 fw-bold">@Model.Deceased.sys_deceasedFullName</dd>

                                            <dt class="col-sm-5">DOB</dt>
                                            <dd class="col-sm-7">@Model.Deceased.sys_deceasedDOB.ToString("yyyy-MM-dd")</dd>

                                            <dt class="col-sm-5">DOD</dt>
                                            <dd class="col-sm-7">@Model.Deceased.sys_deceasedDOD.ToString("yyyy-MM-dd")</dd>

                                            <dt class="col-sm-5">Gender</dt>
                                            <dd class="col-sm-7">@Model.Deceased.sys_deceasedGender</dd>

                                            <dt class="col-sm-5">Marital Status</dt>
                                            <dd class="col-sm-7">@Model.Deceased.sys_deceasedMaritalStatus</dd>

                                            <dt class="col-sm-5">Spouse</dt>
                                            <dd class="col-sm-7">@Model.Deceased.sys_deceasedNameOfSpouse</dd>

                                            <dt class="col-sm-5">Nationality</dt>
                                            <dd class="col-sm-7">@Model.Deceased.sys_deceasedNationality</dd>

                                            <dt class="col-sm-5">Burial Date</dt>
                                            <dd class="col-sm-7">
                                                <span class="badge bg-info text-dark">@Model.Allocation.sys_dateTimeOfBurial</span>
                                            </dd>

                                            <dt class="col-sm-5">Repatriation Source</dt>
                                            <dd class="col-sm-7">@Model.Allocation.sys_repatriationSource</dd>

                                            <dt class="col-sm-5">Next of Kin</dt>
                                            <dd class="col-sm-7">@Model.Deceased.sys_deceasedNextOfKinName</dd>

                                            <dt class="col-sm-5">Address</dt>
                                            <dd class="col-sm-7">@Model.Deceased.sys_deceasedNextOfKinAddress</dd>

                                            <dt class="col-sm-5">Email</dt>
                                            <dd class="col-sm-7">@Model.Deceased.sys_deceasedNextOfKinEmail</dd>

                                            <dt class="col-sm-5">Contact</dt>
                                            <dd class="col-sm-7">@Model.Deceased.sys_deceasedNextOfKinPhone</dd>


                                        </dl>

                                        @if (Model.AllocationPaymentStatus=="Partially Paid" || Model.AllocationPaymentStatus=="Unpaid")
                                        {
                                            @if (Model.Reservation ==null)
                                            {
                                                <button class="btn btn-sm btn-success mt-2"
                                                data-bs-toggle="modal"
                                                    data-bs-target="#allocationPaymentModal"
                                                    data-allocationid="@Model.Allocation.sys_allocationId">
                                                💳 Capture Payment
                                            </button>
                                            }
                                        }
                                        
                                    }
                                    else
                                    {
                                        @if(!Model.isReadyForAllocation){
                                            <div class="alert alert-warning">Grave not ready for allocation. Current Stage: @Model.Stage?.sys_stageName</div>
                                        }
                                        else{
                                            <div class="alert alert-info">No allocation found.</div>
                                            <button class="btn btn-sm btn-primary"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#allocateModal">
                                                ➕ Allocate Grave
                                            </button>

                                        }
                                        
                                    }
                                    
                                </div>
                            </div>
                        </div>
                    
                        <div class="row mb-3">
                            <div class="col-md-12">
                                @if (Model.Reservation == null)
                                {
                                    <!-- Allocation Payments Section -->

                                    <div class="card p-3 mb-3 shadow-sm">

                                        <h6 class="mb-3 border-bottom pb-2">Payments Made</h6>

                                        @if (Model.AllocationPayments?.Any() == true)
                                        {
                                            <div class="table-responsive">
                                                <table class="table table-striped mb-2">
                                                    <thead>
                                                        <tr>
                                                            <th>Date</th>
                                                            <th>Invoice</th>
                                                            <th>Amount</th>
                                                            <th>Method</th>
                                                            <th>Receipt No.</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var p in Model.AllocationPayments)
                                                        {
                                                            <tr>
                                                                <td>@p.sys_date.ToString("yyyy-MM-dd")</td>
                                                                <td>@p.InvoiceNumber</td>
                                                                <td>@p.sys_amount.ToString("C")</td>
                                                                <td>@p.sys_paymentMethod</td>
                                                                <td>@p.sys_receiptNo</td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                            <p><strong>Total Allocation Payments:</strong> @Model.AllocationPayments.Sum(x => x.sys_amount).ToString("C")</p>
                                        }
                                        else
                                        {
                                            <div class="alert alert-info">No payments found.</div>
                                        }

                                    </div>
                                }
                            </div>
                        </div>

                    </div>

                    <!-- Reservation Tab -->
                    <div class="tab-pane fade" id="reservation" role="tabpanel">
                        <div class="row mb-3">
                            <!-- Grave Information -->
                            <div class="col-md-6">
                                <div class="card p-3 mb-3 shadow-sm">
                                    <h6 class="mb-3 border-bottom pb-2">Reservation Details</h6>
                                            @if (Model.Reservation != null)
                                            {
                            
                                                    <dl class="row">
                                                        <dt class="col-sm-4">Reserved By</dt>
                                                        <dd class="col-sm-8">@Model.Customer.sys_paymentMadeBy</dd>

                                                        <dt class="col-sm-4">Price</dt>
                                                        <dd class="col-sm-8">$@Model.Grave.sys_price</dd>


                                                        <dt class="col-sm-4">Total Paid</dt>
                                                        <dd class="col-sm-8">$@Model.TotalPaidReservation</dd>

                                                        <dt class="col-sm-4">Balance</dt>
                                                        <dd class="col-sm-8">$@Model.ReservationBalance</dd>

                                                        <dt class="col-sm-4">Payment Status: </dt>
                                                        <dd class="col-sm-8">
                                                            <span class="badge @(Model.ReservationPaymentStatus == "Fully Paid" ? "bg-success" : Model.ReservationPaymentStatus == "Partially Paid" ? "bg-warning text-dark" : "bg-danger")">
                                                                @Model.ReservationPaymentStatus
                                                            </span>
                                                        </dd>
                                                            @if (Model.Beneficiaries?.Any() == true)
                                                                {
                                                                    
                                        
                                                                    @foreach (var b in Model.Beneficiaries)
                                                                    {
                                                
                                                                            <dt class="col-sm-4">Beneficiary Full Name</dt>
                                                                            <dd class="col-sm-8">@b.sys_benefitFullName</dd>
                                                                            <dt class="col-sm-4">Beneficiary DOB</dt>
                                                                            <dd class="col-sm-8">@b.sys_benefitDOB</dd>
                                                                            <dt class="col-sm-4">Relationship</dt>
                                                                            <dd class="col-sm-8">@b.sys_benefitRelationship</dd>
                                                    
                                                                    }
                                        
                                                            }
                                                    </dl>

                                    

                                                    @if (Model.ReservationPaymentStatus == "Partially Paid" || Model.ReservationPaymentStatus == "Unpaid")
                                                    {
                                                            <button class="btn btn-sm btn-success mt-2"
                                                                    data-bs-toggle="modal"
                                                                    data-bs-target="#reservationPaymentModal"
                                                                    data-reservationid="@Model.Reservation.sys_reservationId">
                                                                💳 Capture Payment
                                                            </button>
                                                    }
                                            }
                                    
                                            else
                                            {
                                                <div class="alert alert-info">No reservation found.</div>
                                                @if(Model.Grave.sys_graveSaleStatus !="Occupied"){
                                            <button class="btn btn-sm btn-primary"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#reservationModal">
                                                ➕ Reserve Grave
                                            </button>
                                                }
                                               
                                            }
                                            
                                </div>

                             </div>

                            <!-- Payments Section -->
                            <div class="col-md-6">
                                <div class="card p-3 mb-3 shadow-sm">
                                    <h6 class="mb-3 border-bottom pb-2">Reservation Payments</h6>


                                    @if (Model.ReservationPayments?.Any() == true)
                                    {
                                        <div class="table-responsive">
                                            <table class="table table-sm table-striped align-middle">
                                                <thead class="table-dark">
                                                    <tr>
                                                        <th>Date</th>
                                                        <th>Invoice No</th>
                                                        <th>Amount</th>
                                                        <th>Method</th>
                                                        <th>Notes</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var p in Model.ReservationPayments)
                                                    {
                                                        <tr>
                                                            <td>@p.sys_date.ToString("dd MMM yyyy")</td>
                                                            <td>@p.InvoiceNumber</td>
                                                            <td>@p.sys_amount.ToString("C")</td>
                                                            <td>@p.sys_paymentMethod</td>
                                                            <td>@p.sys_notes</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                                <tfoot class="table-light">
                                                    <tr>
                                                        <th colspan="2" class="text-end">Total Due</th>
                                                        <th>$@Model.Grave.sys_price</th>
                                                        <th colspan="2"></th>
                                                    </tr>
                                                    <tr>
                                                        <th colspan="2" class="text-end">Total Paid:</th>
                                                        <th>$@Model.TotalPaidReservation</th>
                                                        <th colspan="2"></th>
                                                    </tr>
                                                    <tr>
                                                        <th colspan="2" class="text-end">Balance:</th>
                                                        <th>
                                                            @Model.ReservationBalance.ToString("C")
                                                        </th>
                                                        <th colspan="2"></th>
                                                    </tr>
                                                </tfoot>
                                            </table>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="alert alert-info mb-0">
                                            No payments recorded for this reservation.
                                        </div>
                                    }
                                </div>
                            </div>
                           
                        </div>
                    </div>


                    <!-- Jobs Tab -->
                    <div class="tab-pane fade" id="jobs" role="tabpanel">
                        

                        <div class="row mb-3">
                            
                            <div class="col-md-12">
                                <div class="card p-3 mb-3 shadow-sm">
                                    <h6 class="mb-3 border-bottom pb-2">Jobs Done On This Grave</h6>
                                    <div class="col-md-6 mb-3">
                                    <button class="btn btn-sm btn-primary"
                                            data-bs-toggle="modal"
                                            data-bs-target="#createModal">
                                        ➕ Add Job
                                    </button>
                                    </div>
                                        @if (Model?.JobList?.Any() == true)
                                        {
                                            <div class="table-responsive">
                                                <table class="table table-striped table-hover align-middle mb-0">
                                                    <thead>
                                                        <tr>
                                                            <th style="width:40px;">
                                                                <input type="checkbox" id="selectAll">
                                                            </th>
                                                            <th>Grave</th>
                                                            <th>Supplier</th>
                                                            <th>Stage</th>
                                                            <th>Start Date</th>
                                                            <th>End Date</th>
                                                            <th>Status</th>
                                                            <th>Balance Due</th>
                                                            <th style="width:200px;">Actions</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var job in Model.JobList)
                                                        {
                                                            <tr>
                                                                <td>
                                                                    <input type="checkbox" class="job-checkbox" value="@job.JobId">
                                                                </td>
                                                                <td><a asp-page="/Graves/GraveDetails" asp-route-id="@job.GraveID">@job.GravePlot</a></td>
                                                                <td>@job.SupplierName</td>
                                                                <td>@job.StageName</td>
                                                                <td>@(job.StartDate?.ToString("yyyy-MM-dd") ?? "")</td>
                                                                <td>@(job.EndDate?.ToString("yyyy-MM-dd") ?? "")</td>
                                                                <td>@job.JobStatus</td>
                                                                <td>@job.Balance</td>
                                                                <td>
                                                                    <button class="btn btn-sm btn-warning"
                                                                            data-bs-toggle="modal"
                                                                            data-bs-target="#editModal"
                                                                            data-id="@job.JobId"
                                                                            data-section="@job.SectionID"
                                                                            data-grave="@job.GraveID"
                                                                            data-supplier="@job.SupplierID"
                                                                            data-stage="@job.StageID"
                                                                            data-start="@job.StartDate?.ToString("yyyy-MM-dd")"
                                                                            data-end="@job.EndDate?.ToString("yyyy-MM-dd")"
                                                                            data-status="@job.JobStatus">
                                                                        Edit
                                                                    </button>


                                                                    <button class="btn btn-sm btn-danger"
                                                                            data-bs-toggle="modal"
                                                                            data-bs-target="#deleteModal"
                                                                            data-id="@job.JobId">
                                                                        Delete
                                                                    </button>
                                                                    @if (job.JobStatus != "Complete")
                                                                    {
                                                                        <button class="btn btn-sm btn-secondary" disabled>
                                                                            Pay
                                                                        </button>
                                                                        <button class="btn btn-sm btn-secondary" disabled>
                                                                            Evaluate
                                                                        </button>
                                                                    }
                                                                    else
                                                                    {
                                                                        <button type="button" class="btn btn-sm btn-info"
                                                                                onclick="openPaymentModal(@job.JobId, @job.SupplierID)">
                                                                            Pay
                                                                        </button>

                                                                        <button type="button"
                                                                                class="btn btn-info btn-sm btn-secondary"
                                                                                onclick="openEvaluationModal(@job.JobId)">
                                                                            Evaluate
                                                                        </button>
                                                                    }

                                                                </td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>

                                            

                                        }

                                        else
                                        {
                                            <div class="alert alert-info">No jobs found.</div>
                                        }

                                 
                            </div>
                        </div>
                        </div>
                     </div>
                       


























                    

                    <!-- Payments Tab -->
                    <div class="tab-pane fade" id="payments" role="tabpanel">
                       

                        
                    </div>
                </div>
            </div>
     </div>
  </div>

</div>

<!-- Modals: Allocate, Reservation, Supplier Payment, Allocation Payment -->
<!-- Allocate Grave Modal -->
<div class="modal fade" id="allocateModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <!-- wider modal for 3 columns -->
        <div class="modal-content">
            <form method="post" asp-page-handler="AllocateGrave">
                <div class="modal-header">
                    <h5 class="modal-title">Allocate Grave</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <!-- g-3 adds spacing -->

                        <input type="hidden" name="graveId" value="@Model.Grave.sys_graveId" />

                        <div class="col-md-12">
                            <label>Deceased Name<span class="text-danger">*</span></label>
                            <input type="text" name="deceasedFullName" class="form-control" required />
                        </div>

                        <div class="col-md-4">
                            <label>DOB<span class="text-danger">*</span></label>
                            <input type="date" name="deceasedDOB" class="form-control" required />
                        </div>

                        <div class="col-md-4">
                            <label>DOD<span class="text-danger">*</span></label>
                            <input type="date" name="deceasedDOD" class="form-control" required />
                        </div>

                        <div class="col-md-4">
                            <label>Gender<span class="text-danger">*</span></label>
                            <select name="deceasedGender" class="form-control" required>
                                <option value="">-- Select --</option>
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label>Nationality<span class="text-danger">*</span></label>
                            <input type="text" name="nationality" class="form-control" required />
                        </div>

                        <div class="col-md-4">
                            <label>Marital Status</label>
                            <select name="maritalStatus" class="form-control">
                                <option value="">-- Select --</option>
                                <option value="Single">Single</option>
                                <option value="Married">Married</option>
                                <option value="Divorced">Divorced</option>
                                <option value="Widowed">Widowed</option>
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label>Name of Spouse</label>
                            <input type="text" name="nameOfSpouse" class="form-control" />
                        </div>

                        <div class="col-md-4">
                            <label>Next of Kin Full Name<span class="text-danger">*</span></label>
                            <input type="text" name="nextOfKinFullName" class="form-control" required />
                        </div>

                        <div class="col-md-4">
                            <label>Next of Kin Address<span class="text-danger">*</span></label>
                            <input type="text" name="nextOfKinAddress" class="form-control" required />
                        </div>

                        <div class="col-md-4">
                            <label>Next of Kin Email</label>
                            <input type="email" name="nextOfKinEmail" class="form-control" />
                        </div>

                        <div class="col-md-4">
                            <label>Next of Kin Phone<span class="text-danger">*</span></label>
                            <input type="text" name="nextOfKinPhone" class="form-control" required />
                        </div>

                        @if(Model.Reservation != null){
                            <div class="col-md-4">
                                <label>Payment Made By<span class="text-danger">*</span></label>
                                <input type="text" name="paymentBy" class="form-control" value="@Model.Customer.sys_paymentMadeBy" required />
                            </div>
                        }
                        else{
                            <div class="col-md-4">
                                <label>Payment Made By<span class="text-danger">*</span></label>
                                <input type="text" name="paymentBy" class="form-control" required />
                            </div>
                        }

                        

                        <div class="col-md-4">
                            <label>Repatriation Source<span class="text-danger">*</span></label>
                            <input type="text" name="repatriationSource" class="form-control" value="Local" required />
                        </div>

                        <div class="col-md-4">
                            <label for="burialDate">Burial Date <span class="text-danger">*</span></label>
                            <input type="date" id="burialDate" class="form-control" required />
                        </div>

                        <div class="col-md-4">
                            <label for="burialTime">Available Slots</label>
                            <select id="burialTime" name="burialDateTime" class="form-control" required>
                                <option value="">-- Select a slot --</option>
                            </select>
                            <div id="slotMessage" class="text-danger mt-1"></div>
                        </div>

                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" id="allocateSubmitBtn" class="btn btn-primary">Allocate</button>
                </div>
            </form>
        </div>
    </div>
</div>


<!-- Reserve Modal -->
<div class="modal fade" id="reservationModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form method="post" asp-page-handler="CreateReservation">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">Reserve Grave</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="graveId" value="@Model.Grave.sys_graveId" />

                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">Customer Name <span class="text-danger">*</span></label>
                            <input type="text" name="customerName" class="form-control" required />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Beneficiary Full Name <span class="text-danger">*</span></label>
                            <input type="text" name="beneficiaryFullName" class="form-control" required />
