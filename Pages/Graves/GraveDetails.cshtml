<script>
    document.addEventListener("DOMContentLoaded", function () {
        const sectionDropdown = document.getElementById("sectionDropdown");
        const graveDropdown = document.getElementById("graveDropdown");

        sectionDropdown.addEventListener("change", function () {
            const sectionId = this.value;

            // Clear existing graves
            graveDropdown.innerHTML = '<option value="">-- Select Grave --</option>';

            if (sectionId) {
                fetch(`?handler=GetGravesBySection&sectionId=${sectionId}`)
                    .then(response => response.json())
                    .then(data => {
                        data.forEach(grave => {
                            let option = document.createElement("option");
                            option.value = grave.sys_graveId;
                            option.textContent = grave.sys_plotNumber;
                            graveDropdown.appendChild(option);
                        });
                    });
            }
        });
    });



</script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        var editModal = document.getElementById("editModal");

        editModal.addEventListener("show.bs.modal", function (event) {
            var button = event.relatedTarget;

            // Fill hidden Id
            document.getElementById("editJobId").value = button.getAttribute("data-id");

            // Preselect Section
            var sectionId = button.getAttribute("data-section");
            var graveId = button.getAttribute("data-grave");
            var supplierId = button.getAttribute("data-supplier");
            var stageId = button.getAttribute("data-stage");
            var startDate = button.getAttribute("data-start");
            var endDate = button.getAttribute("data-end");

            // Section dropdown
            var sectionDropdown = document.getElementById("EditsectionDropdown");
            sectionDropdown.value = sectionId;

            // Populate graves for that section and select correct grave
            var graveDropdown = document.getElementById("EditgraveDropdown");
            graveDropdown.innerHTML = '<option value="">-- Select Grave --</option>';

            if (sectionId) {
                fetch(`?handler=GetGravesBySection&sectionId=${sectionId}`)
                    .then(response => response.json())
                    .then(data => {
                        data.forEach(grave => {
                            var option = document.createElement("option");
                            option.value = grave.sys_graveId;
                            option.text = grave.sys_plotNumber;
                            if (grave.sys_graveId == graveId) {
                                option.selected = true;
                            }
                            graveDropdown.add(option);
                        });
                    })
                    .catch(error => console.error("Error loading graves:", error));
            }

            // Supplier, Stage, Dates
            document.getElementById("editSupplierId").value = supplierId;
            document.getElementById("editStageId").value = stageId;
            document.getElementById("editStartDate").value = startDate;
            document.getElementById("editEndDate").value = endDate;
        });

        // If user changes section manually, reload graves
        document.getElementById("EditsectionDropdown").addEventListener("change", function () {
            var sectionId = this.value;
            var graveDropdown = document.getElementById("EditgraveDropdown");
            graveDropdown.innerHTML = '<option value="">-- Select Grave --</option>';

            if (sectionId) {
                fetch(`?handler=GravesBySection&sectionId=${sectionId}`)
                    .then(response => response.json())
                    .then(data => {
                        data.forEach(grave => {
                            var option = document.createElement("option");
                            option.value = grave.sys_graveId;
                            option.text = grave.sys_plotNumber;
                            graveDropdown.add(option);
                        });
                    })
                    .catch(error => console.error("Error loading graves:", error));
            }
        });
    });
</script>


<script>

    function openEvaluationModal(jobId) {
        $('#evaluationJobId').val(jobId);

        $.getJSON('?handler=EvaluationParameters&jobId=' + jobId, function (data) {
            let container = $('#evaluationParametersContainer');
            container.empty();

            if (data && data.length > 0) {
                data.forEach(param => {
                    container.append(`
                    <div class="col-sm-4">
                        <div class="mb-2">
                            <label>${param.sys_parameterName}</label>
                            <input type="hidden" name="parameterIds" value="${param.sys_jobEvaluationParameterId}" />
                            <input type="text" class="form-control" name="evaluation_${param.sys_jobEvaluationParameterId}" value="${param.sys_jobEvaluation ?? ''}" />
                        </div>
                        </div>
                    `);
                });
            } else {
                container.append(`<p class="text-muted">No evaluation parameters defined.</p>`);
            }

            $('#evaluationModal').modal('show');
        });
    }


    document.addEventListener("DOMContentLoaded", function () {
        // --- Edit Job Modal ---
        var editModal = document.getElementById("editModal");
        editModal.addEventListener("show.bs.modal", function (event) {
            var button = event.relatedTarget;
            document.getElementById("editJobId").value = button.getAttribute("data-id");
            document.getElementById("editGraveId").value = button.getAttribute("data-grave");
            document.getElementById("editSupplierId").value = button.getAttribute("data-supplier");
            document.getElementById("editStageId").value = button.getAttribute("data-stage");
            document.getElementById("editStartDate").value = button.getAttribute("data-start");
            document.getElementById("editEndDate").value = button.getAttribute("data-end");
            document.getElementbyId("editStatus").value = button.getAttribute("data-status");
        });

        // --- Delete Job Modal ---
        var deleteModal = document.getElementById("deleteModal");
        deleteModal.addEventListener("show.bs.modal", function (event) {
            var button = event.relatedTarget;
            document.getElementById("deleteJobId").value = button.getAttribute("data-id");
        });



    });

</script>

<script>
    // When opening modal, load previous payments
    function openPaymentModal(jobId, supplierId) {
        $("#paymentJobId").val(jobId);
        $("#paymentSupplierId").val(supplierId);

        fetch(`?handler=Payments&jobId=${jobId}`)
            .then(r => r.json())
            .then(data => {
                let rows = "";
                let hasPayments = data.length > 0;

                data.forEach(p => {
                    rows += `<tr>
                        <td>${p.paymentDate}</td>
                        <td>${p.amountDue}</td>
                        <td>${p.amountPaid}</td>
                        <td>${p.balance}</td>
                    </tr>`;
                });

                $("#previousPaymentsBody").html(rows);

                if (hasPayments) {
                    // Already has payments -> disable AmountDue
                    $("#amountDue").val("0").prop("readonly", true);
                } else {
                    // First payment -> allow entering AmountDue
                    $("#amountDue").val("").prop("readonly", false);
                }

                $("#paymentModal").modal("show");
            });
    }
</script>

