@page
@model ZororoMemorialPark.Pages.Graves.DevelopmentStagesModel

@{
    ViewData["Title"] = "Grave Development Stages";
}

<div class="row">
    <div class="col-lg-10 mx-auto">
        <div class="card shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center"
                 style="background-color: var(--primary-green); color: var(--primary-white);">
                <h5 class="mb-0">Development Stages</h5>
                <button class="btn btn-sm btn-light" data-bs-toggle="modal" data-bs-target="#createStageModal">
                    <i class="bi bi-plus-circle"></i> Add Stage
                </button>
            </div>

            <div class="card-body">
                <!-- Alerts -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert" id="successMessage">
                        @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                <!-- Table -->
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Stage Name</th>
                                <th style="width:150px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="stagesTable">
                            @foreach (var stage in Model.PaginatedStages)
                            {
                                <tr id="row-@stage.sys_stageId">
                                    <td>@stage.sys_stageName</td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-secondary"
                                                data-bs-toggle="modal"
                                                data-bs-target="#editStageModal"
                                                data-id="@stage.sys_stageId"
                                                data-name="@stage.sys_stageName">
                                            Edit
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger"
                                                data-bs-toggle="modal"
                                                data-bs-target="#deleteStageModal"
                                                data-id="@stage.sys_stageId"
                                                data-name="@stage.sys_stageName">
                                            Delete
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Pagination -->
            <div class="card-footer d-flex justify-content-between align-items-center"
                 style="background-color: var(--primary-grey);">
                <span>Page @Model.PaginatedStages.PageIndex of @Model.PaginatedStages.TotalPages</span>
                <nav>
                    <ul class="pagination mb-0">
                        <li class="page-item @(Model.PaginatedStages.HasPreviousPage ? "" : "disabled")">
                            <a class="page-link" asp-route-pageIndex="@(Model.PaginatedStages.PageIndex - 1)">Previous</a>
                        </li>
                        @for (int i = 1; i <= Model.PaginatedStages.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.PaginatedStages.PageIndex ? "active" : "")">
                                <a class="page-link" asp-route-pageIndex="@i">@i</a>
                            </li>
                        }
                        <li class="page-item @(Model.PaginatedStages.HasNextPage ? "" : "disabled")">
                            <a class="page-link" asp-route-pageIndex="@(Model.PaginatedStages.PageIndex + 1)">Next</a>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</div>

<!-- Create Modal -->
<div class="modal fade" id="createStageModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header" style="background-color: var(--primary-green); color: var(--primary-white);">
                <h5 class="modal-title">Add Stage</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body bg-light">
                <form method="post" asp-page-handler="Create" id="createStageForm">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Stage Name</label>
                        <input name="stageName" class="form-control border" style="border-color: var(--primary-green);" />
                    </div>
                    <div class="text-end">
                        <button type="submit" class="btn btn-primary">Save</button>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Edit Modal -->
<div class="modal fade" id="editStageModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header" style="background-color: var(--primary-green); color: var(--primary-white);">
                <h5 class="modal-title">Edit Stage</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body bg-light">
                <form method="post" asp-page-handler="Edit" id="editStageForm">
                    <input type="hidden" name="sys_stageId" />
                    <div class="mb-3">
                        <label class="form-label fw-bold">Stage Name</label>
                        <input name="sys_stageName" class="form-control border" style="border-color: var(--primary-green);" />
                    </div>
                    <div class="text-end">
                        <button type="submit" class="btn btn-primary">Update</button>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteStageModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header" style="background-color: var(--primary-black); color: var(--primary-white);">
                <h5 class="modal-title">Delete Stage</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body bg-light">
                <form method="post" asp-page-handler="Delete" id="deleteStageForm">
                    <input type="hidden" name="sys_stageId" />
                    <p class="fw-semibold text-danger">Are you sure you want to delete this stage?</p>
                    <div class="text-end">
                        <button type="submit" class="btn btn-danger">Delete</button>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- JS to fill Edit/Delete modals -->
<script>
    var editModal = document.getElementById('editStageModal');
    editModal.addEventListener('show.bs.modal', function (event) {
        var button = event.relatedTarget;
        var id = button.getAttribute('data-id');
        var name = button.getAttribute('data-name');

        var modal = this;
        modal.querySelector('input[name="sys_stageId"]').value = id;
        modal.querySelector('input[name="sys_stageName"]').value = name;
    });

    var deleteModal = document.getElementById('deleteStageModal');
    deleteModal.addEventListener('show.bs.modal', function (event) {
        var button = event.relatedTarget;
        var id = button.getAttribute('data-id');
        var name = button.getAttribute('data-name');

        var modal = this;
        modal.querySelector('input[name="sys_stageId"]').value = id;
        modal.querySelector('p').textContent = `Are you sure you want to delete the stage "${name}"?`;
    });
</script>
