@page
@model ZororoMemorialPark.Pages.Inventory.ProductsModel
@{
    ViewData["Title"] = "Products Management";
}

<div class="card shadow-sm">
    <div class="card-header d-flex justify-content-between align-items-center"
         style="background-color: var(--primary-green); color: var(--primary-white);">
        <h5 class="mb-0">Products & Stock Management</h5>
        
    </div>

    <div class="card-body">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
    else if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    <div class="row">
        <!-- Left Column: Add/Edit Form -->
        <div class="col-md-5">
            <div class="card shadow-sm mb-3">
                <div class="card-body">
                    <h5 class="card-title mb-3">Add Product</h5>

                    <form method="post" asp-page-handler="AddProduct">
                        <div class="row">
                            <div class="col-sm-6">
                                <label>Name</label>
                                <input type="text" name="sys_itemName" class="form-control" required />
                            </div>
                            <div class="col-sm-6">
                                <label>Category</label>
                                <select name="sys_category" class="form-select" required>
                                    <option value="">--Select--</option>
                                    <option value="Sellable">Sellable</option>
                                    <option value="Consumable">Consumable</option>
                                    
                                </select>
                            </div>
                        </div>

                        <div class="row mt-3">
                            <div class="col-sm-6">
                                <label>Unit Price</label>
                                <input type="number" step="0.01" name="sys_unitPrice" class="form-control" required />
                            </div>
                            <div class="col-sm-6">
                                <label>Stock Quantity</label>
                                <input type="number" step="0.01" name="sys_stockQuantity" class="form-control" required />
                            </div>
                        </div>

                        <div class="row mt-3">
                            <div class="col-sm-6">
                                <label>Unit of Measure</label>
                                <input type="text" name="sys_measurementUnit" class="form-control" placeholder="e.g. Bags, Litres" />
                            </div>
                            <div class="col-sm-6">
                                <label>Description</label>
                                <textarea name="sys_description" class="form-control"></textarea>
                            </div>
                        </div>

                        <div class="text-end mt-3">
                            <button type="submit" class="btn btn-primary">Save Product</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Right Column: Product List -->
        <div class="col-md-7">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Available Products</h5>
                    <div class="table-responsive">
                        <table class="table table-striped table-class table-sm" id="myTable">

                            <thead class="thead-light">
                            <tr>
                                <th>Name</th>
                                <th>Category</th>
                                <th>Stock</th>
                                <th>Unit</th>
                                <th>Price ($)</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var product in Model.Products)
                            {
                                <tr>
                                    <td>@product.sys_itemName</td>
                                    <td>@product.sys_category</td>
                                    <td>@product.sys_stockQuantity</td>
                                    <td>@product.sys_unitOfMeasure</td>
                                    <td>@product.sys_sellingPrice.ToString("N2")</td>
                                    <td>
                                            <button class="btn btn-sm btn-warning" data-bs-toggle="modal" data-bs-target="#editModal_@product.sys_itemId">Edit</button>
                                            <button class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#deleteModal_@product.sys_itemId">Delete</button>
                                    </td>
                                </tr>

                                <!-- Edit Modal -->
                                <div class="modal fade" id="editModal_@product.sys_itemId" tabindex="-1">
                                    <div class="modal-dialog modal-lg">
                                        <div class="modal-content">
                                            <form method="post" asp-page-handler="EditProduct">
                                                <div class="modal-header">
                                                    <h5>Edit Product</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                </div>
                                                <div class="modal-body">
                                                    <input type="hidden" name="sys_itemId" value="@product.sys_itemId" />

                                                    <div class="row">
                                                        <div class="col-sm-6">
                                                            <label>Name</label>
                                                            <input type="text" name="sys_itemName" value="@product.sys_itemName" class="form-control" required />
                                                        </div>
                                                        <div class="col-sm-6">
                                                            <label>Category</label>
                                                            <select name="sys_category" class="form-select">
                                                                <option value="@product.sys_category">@product.sys_category</option>
                                                                <option value="Sellable">Sellable</option>
                                                                <option value="Consumable">Consumable</option>
                                                                
                                                            </select>
                                                        </div>
                                                    </div>

                                                    <div class="row mt-3">
                                                        <div class="col-sm-6">
                                                            <label>Unit Price</label>
                                                            <input type="number" name="sys_unitPrice" step="0.01" value="@product.sys_sellingPrice" class="form-control" />
                                                        </div>
                                                        <div class="col-sm-6">
                                                            <label>Stock Quantity</label>
                                                            <input type="number" name="sys_stockQuantity" step="0.01" value="@product.sys_stockQuantity" class="form-control" />
                                                        </div>
                                                    </div>

                                                    <div class="row mt-3">
                                                        <div class="col-sm-6">
                                                            <label>Unit</label>
                                                            <input type="text" name="sys_measurementUnit" value="@product.sys_unitOfMeasure" class="form-control" />
                                                        </div>
                                                        <div class="col-sm-6">
                                                            <label>Description</label>
                                                            <textarea name="sys_description" class="form-control">@product.sys_description</textarea>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="submit" class="btn btn-primary">Save Changes</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>

                                <!-- Delete Modal -->
                                    <div class="modal fade" id="deleteModal_@product.sys_itemId" tabindex="-1" aria-labelledby="deleteModalLabel_@product.sys_itemId" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content">
                                                <div class="modal-header bg-danger text-white">
                                                    <h5 class="modal-title" id="deleteModalLabel_@product.sys_itemId">Confirm Deletion</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <div class="modal-body">
                                                    Are you sure you want to delete <strong>@product.sys_itemName</strong>?
                                                </div>
                                                <div class="modal-footer">
                                                    <form method="post" asp-page-handler="DeleteProduct">
                                                        <input type="hidden" name="sys_itemId" value="@product.sys_itemId" />
                                                        <button type="submit" class="btn btn-danger">Yes, Delete</button>
                                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                            }
                        </tbody>
                    </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

</div>
</div>
