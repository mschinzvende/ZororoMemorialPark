@page
@model ZororoMemorialPark.Pages.Burials.BurialScheduleModel
@{
    ViewData["Title"] = "Burial Schedule";
}

<div class="container-fluid py-4 mb-4">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- PAGE HEADER -->
    <div class="row mb-3">
        <div class="col">
            <h3>Burial Schedule</h3>
            <p class="text-muted mb-0">
                Burial bookings scheduled for today and upcoming dates, including payment status.
            </p>
        </div>
        <div class="col-auto">
            

            <div class="d-flex gap-2">
                <a asp-page="/Index" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-arrow-left"></i> Back to Dashboard
                </a>
                <a asp-page-handler="DownloadSchedule"
                   class="btn btn-outline-primary btn-sm">
                    <i class="bi bi-download"></i> Download
                </a>

                <button class="btn btn-success btn-sm"
                        data-bs-toggle="modal"
                        data-bs-target="#sendScheduleModal">
                    <i class="bi bi-whatsapp"></i> Send
                </button>
            </div>
        </div>
    </div>

    <!-- SUMMARY PANELS -->
    <div class="row g-3 mb-4">

        <!-- Today's Bookings -->
        <div class="col-lg-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-success text-white">
                    <h6 class="mb-0">Today's Burials (@Model.TodaysBurials.Count)</h6>
                </div>
                <div class="card-body p-2" style="max-height: 420px; overflow-y:auto;">
                    @if (!Model.TodaysBurials.Any())
                    {
                        <p class="text-muted small mb-0">No burials scheduled for today.</p>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var b in Model.TodaysBurials)
                            {
                                <li class="list-group-item small">
                                    <div class="d-flex justify-content-between">
                                        <div>
                                            <strong>@b.BurialDateTime.ToString("HH:mm")</strong><br />
                                            <span class="text-muted">
                                                @b.DeceasedFullName – @b.SectionName
                                            </span><br />
                                            <span class="@(b.IsFullyPaid ? "text-success" : "text-danger")">
                                                @(b.IsFullyPaid ? "PAID" : $"BALANCE: ${b.Balance}")
                                            </span>
                                        </div>
                                        <div class="text-end">
                                            <span class="badge @(b.IsFullyPaid ? "bg-success" : "bg-warning text-dark")">
                                                @b.BookingStatus
                                            </span>
                                        </div>
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>

        <!-- Upcoming Bookings -->
        <div class="col-lg-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-light">
                    <h6 class="mb-0">Upcoming Burials</h6>
                </div>
                <div class="card-body p-2" style="max-height: 420px; overflow-y:auto;">
                    @if (!Model.UpcomingBurials.Any())
                    {
                        <p class="text-muted small mb-0">No upcoming burials.</p>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var b in Model.UpcomingBurials)
                            {
                                <li class="list-group-item small">
                                    <strong>
                                        @b.BurialDateTime.ToString("ddd dd MMM yyyy HH:mm")
                                    </strong><br />
                                    <span class="text-muted">
                                        @b.DeceasedFullName – @b.SectionName
                                    </span><br />
                                    <span class="@(b.IsFullyPaid ? "text-success" : "text-danger")">
                                        @(b.IsFullyPaid ? "PAID" : $"BALANCE: ${b.Balance}")
                                    </span>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>

        <!-- INSIGHTS -->
        <div class="col-lg-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-light">
                    <h6 class="mb-0">Burial Insights</h6>
                </div>
                <div class="card-body">
                    <h2 class="fw-bold text-success">@Model.TodaysBurials.Count</h2>
                    <p class="text-muted mb-3">Scheduled Today</p>

                    <hr />

                    <h4 class="fw-bold">@Model.UpcomingBurials.Count</h4>
                    <p class="text-muted mb-3">Upcoming Burials</p>

                    <hr />

                    <h5 class="fw-bold">@Model.AllBurials.Count</h5>
                    <p class="text-muted mb-0">Total Active Bookings</p>
                </div>
            </div>
        </div>
    </div>

    <!-- FULL TABLE -->
    <div class="card shadow-sm">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <h6 class="mb-0">All Scheduled Burials</h6>

            <form method="get" class="d-flex align-items-center gap-2">
                <label class="small mb-0">Filter date:</label>
                <input type="date"
                       name="FilterDate"
                       value="@(Model.FilterDate.HasValue ? Model.FilterDate.Value.ToString("yyyy-MM-dd") : "")"
                       class="form-control form-control-sm"
                       style="max-width:180px;">
                <button type="submit" class="btn btn-sm btn-outline-light">
                    <i class="bi bi-funnel"></i>
                </button>
            </form>
        </div>

        <div class="card-body p-2 table-responsive">
            <table class="table table-bordered table-striped align-middle">
                <thead class="table-dark small">
                    <tr>
                        <th>Date</th>
                        <th>Time</th>
                        <th>Deceased</th>
                        <th>Section</th>
                        <th>Customer</th>
                        <th>Invoice</th>
                        <th>Paid</th>
                        <th>Balance</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.AllBurials.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center text-muted small">
                                No burial bookings found.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var b in Model.AllBurials)
                        {
                            <tr class="small">
                                <td>@b.BurialDateTime.ToString("yyyy-MM-dd")</td>
                                <td>@b.BurialDateTime.ToString("HH:mm")</td>
                                <td>@b.DeceasedFullName</td>
                                <td>@b.SectionName</td>
                                <td>@b.CustomerName (@b.CustomerNumber)</td>
                                <td>$@b.InvoiceTotal</td>
                                <td class="text-success">$@b.AmountPaid</td>
                                <td class="@(b.Balance > 0 ? "text-danger" : "text-success")">
                                    $@b.Balance
                                </td>
                                <td>
                                    <span class="badge @(b.IsFullyPaid ? "bg-success" : "bg-warning text-dark")">
                                        @(b.IsFullyPaid ? "PAID" : "PENDING")
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>

<div class="modal fade" id="sendScheduleModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <form method="post" asp-page-handler="SendSchedule">

                <div class="modal-header">
                    <h5 class="modal-title">Send Burial Schedule</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <label class="form-label">Phone Number</label>
                    <input type="text" name="phoneNumber" class="form-control"
                           placeholder="e.g. 2637XXXXXXXX" required />
                </div>

                <div class="modal-footer">
                    <button type="submit" class="btn btn-success">
                        Send via WhatsApp
                    </button>
                </div>

            </form>

        </div>
    </div>
</div>