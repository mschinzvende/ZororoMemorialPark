@page
@model ZororoMemorialPark.Pages.Burials.BurialScheduleModel
@{
    ViewData["Title"] = "Burial Schedule";
}

<div class="container-fluid py-4 mb-4">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row mb-3">
        <div class="col">
            <h3>Burial Schedule</h3>
            <p class="text-muted mb-0">
                View all scheduled burials, reschedule and manage notifications for next of kin.
            </p>
        </div>
        <div class="col-auto">
            <a asp-page="/Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left"></i> Back to Dashboard
            </a>
        </div>
    </div>

    <div class="row g-3">

        <!-- Today's Burials -->
        <div class="col-lg-4">
            <div class="card shadow-sm h-100">
                <div class="card-header" style="background-color: var(--primary-green); color: var(--primary-white);">
                    <h6 class="mb-0">Today's Burials (@Model.TodaysBurials.Count)</h6>
                </div>
                <div class="card-body p-2" style="max-height: 420px; overflow-y: auto;">
                    @if (!Model.TodaysBurials.Any())
                    {
                        <p class="text-muted small mb-0">No burials scheduled for today.</p>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var b in Model.TodaysBurials)
                            {
                                <li class="list-group-item small">
                                    <div class="d-flex justify-content-between">
                                        <div>
                                            <strong>@b.BurialDateTime.ToString("HH:mm")</strong><br />
                                            <span class="text-muted">
                                                Grave: @b.PlotNumber (@b.SectionName)
                                            </span><br />
                                            <span class="text-muted">
                                                NOK: @b.NextOfKinName (@b.NextOfKinContact)
                                            </span>
                                        </div>
                                        <div class="text-end">
                                            <a asp-page="/Burials/EditBurial" asp-route-id="@b.AllocationId"
                                               class="btn btn-sm btn-outline-primary mb-1" title="Edit">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>
                                            <form method="post" asp-page-handler="Notify" asp-route-id="@b.AllocationId" class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-outline-success" title="Notify NOK">
                                                    <i class="bi bi-bell"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>

        <!-- Upcoming Burials List -->
        <div class="col-lg-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-light">
                    <h6 class="mb-0">Upcoming Burials (Next 30 Days)</h6>
                </div>
                <div class="card-body p-2" style="max-height: 420px; overflow-y: auto;">
                    @if (!Model.UpcomingBurials.Any())
                    {
                        <p class="text-muted small mb-0">No upcoming burials scheduled.</p>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var b in Model.UpcomingBurials)
                            {
                                <li class="list-group-item small">
                                    <div class="d-flex justify-content-between">
                                        <div>
                                            <strong>@b.BurialDateTime.ToString("ddd dd MMM yyyy HH:mm")</strong><br />
                                            <span class="text-muted">
                                                Grave: @b.PlotNumber (@b.SectionName)
                                            </span><br />
                                            <span class="text-muted">
                                                NOK: @b.NextOfKinName (@b.NextOfKinContact)
                                            </span>
                                        </div>
                                        <div class="text-end">
                                            <a asp-page="/Burials/EditBurial" asp-route-id="@b.AllocationId"
                                               class="btn btn-sm btn-outline-primary mb-1" title="Edit">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>
                                            <form method="post" asp-page-handler="Notify" asp-route-id="@b.AllocationId" class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-outline-success" title="Notify NOK">
                                                    <i class="bi bi-bell"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>

        <!-- Insights / Summary Panel -->
        <div class="col-lg-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-light">
                    <h6 class="mb-0">Burial Insights</h6>
                </div>
                <div class="card-body">

                    <div class="mb-3">
                        <h2 class="fw-bold text-success">@Model.TodaysBurials.Count</h2>
                        <p class="text-muted mb-0">Scheduled for Today</p>
                    </div>

                    <hr />

                    <div class="mb-3">
                        <h4 class="fw-bold">@Model.UpcomingBurials.Count</h4>
                        <p class="text-muted mb-0">Upcoming Burials (next 30 days)</p>
                    </div>

                    <hr />

                    <div class="mb-3">
                        <h5 class="fw-bold">@Model.AllBurials.Count</h5>
                        <p class="text-muted mb-0">Total Scheduled Burials Displayed</p>
                    </div>

                    <hr />

                    <p class="small text-muted">
                        This summary provides a quick overview of burial activity without opening the full table.
                    </p>
                </div>
            </div>
        </div>

    </div>

    <!-- Full Table -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header d-flex justify-content-between align-items-center"
                     style="background-color: var(--primary-green); color: var(--primary-white);">

                    <h6 class="mb-0" style="color: var(--primary-white);">All Scheduled Burials</h6>

                    <form method="get" class="d-flex align-items-center gap-2">

                        <label class="small mb-0" style="color: var(--primary-white);">
                            Filter by date:
                        </label>

                        <input type="date" name="filterDate"
                               value="@(Model.FilterDate.HasValue ? Model.FilterDate.Value.ToString("yyyy-MM-dd") : "")"
                               class="form-control form-control-sm"
                               style="max-width: 180px;
                      background-color: transparent;
                      color: var(--primary-white);
                      border-color: var(--primary-white);">

                        <button type="submit" class="btn btn-sm"
                                style="border:1px solid var(--primary-white); color: var(--primary-white);">
                            <i class="bi bi-funnel"></i> Apply
                        </button>

                    </form>
                </div>

                <div class="card-body p-2 table-responsive">
                    <table class="table table-bordered table-striped">
                        <thead class="table-dark">
                            <tr class="small">
                                <th>Date</th>
                                <th>Time</th>
                                <th>Grave</th>
                                <th>Section</th>
                                <th>Deceased</th>
                                <th>Next of Kin</th>
                                <th>Contact</th>
                                <th>Customer</th>
                                <th>Repatriation</th>
                                <th style="width: 140px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.AllBurials.Any())
                            {
                                <tr>
                                    <td colspan="10" class="text-center small text-muted">
                                        No burials found for the selected filter.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var b in Model.AllBurials)
                                {
                                    <tr class="small">
                                        <td>@b.BurialDateTime.ToString("yyyy-MM-dd")</td>
                                        <td>@b.BurialDateTime.ToString("HH:mm")</td>
                                        <td>@b.PlotNumber</td>
                                        <td>@b.SectionName</td>
                                        <td>@b.DeceasedName</td>
                                        <td>@b.NextOfKinName</td>
                                        <td>@b.NextOfKinContact</td>
                                        <td>@b.CustomerName</td>
                                        <td>@b.RepatriationSource</td>
                                        <td>
                                            <div class="btn-group btn-group-sm">
                                                <a asp-page="/Burials/EditBurial" asp-route-id="@b.AllocationId"
                                                   class="btn btn-outline-primary" title="Edit">
                                                    <i class="bi bi-pencil-square"></i>
                                                </a>
                                                <form method="post" asp-page-handler="Notify" asp-route-id="@b.AllocationId">
                                                    <button type="submit" class="btn btn-outline-success" title="Notify NOK">
                                                        <i class="bi bi-bell"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

</div>


