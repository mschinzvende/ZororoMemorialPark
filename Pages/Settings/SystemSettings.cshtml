@page
@model ZororoMemorialPark.Pages.Settings.SystemSettingsModel

@{
    ViewData["Title"] = "System Settings";
}
<div class="container-fluid py-4 mb-4">
<div class="card shadow-sm">
    <div class="card-header" style="background-color: var(--primary-green); color:white;">
        <h5 class="mb-0">System Settings</h5>
    </div>

    <div class="card-body">

        @if (TempData["Message"] != null)
        {
                <div class="alert alert-info">@TempData["Message"]</div>
        }

        <form method="post" enctype="multipart/form-data">

            <h5 class="mt-3 mb-2">Company Information</h5>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label>Company Name</label>
                    <input type="text" class="form-control" asp-for="Settings.CompanyName" required />
                </div>

                <div class="col-md-6 mb-3">
                    <label>Company Logo</label>
                    <input type="file" class="form-control" asp-for="LogoFile" />
                    @if (!string.IsNullOrEmpty(Model.Settings.LogoPath))
                    {
                            <img src="@Model.Settings.LogoPath" class="img-thumbnail mt-2" style="height:60px;" />
                    }
                </div>

                <div class="col-md-6 mb-3">
                    <label>Physical Address</label>
                    <input type="text" class="form-control" asp-for="Settings.PhysicalAddress" />
                </div>

                <div class="col-md-3 mb-3">
                    <label>Phone (263...)</label>
                    <input type="text" class="form-control" asp-for="Settings.Phone" />
                </div>

                <div class="col-md-3 mb-3">
                    <label>Email</label>
                    <input type="email" class="form-control" asp-for="Settings.Email" />
                </div>
            </div>

            <hr />

            <h5 class="mt-3">SMTP Configuration</h5>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label>SMTP Server</label>
                    <input type="text" class="form-control" asp-for="Settings.SmtpServer" />
                </div>

                <div class="col-md-2 mb-3">
                    <label>Port</label>
                    <input type="number" class="form-control" asp-for="Settings.SmtpPort" />
                </div>

                <div class="col-md-4 mb-3">
                    <label>Use SSL</label><br />
                    <input type="checkbox" asp-for="Settings.UseSSL" />
                </div>

                <div class="col-md-3 mb-3">
                    <label>Sender Name</label>
                    <input type="text" class="form-control" asp-for="Settings.SenderName" />
                </div>

                <div class="col-md-3 mb-3">
                    <label>Sender Email</label>
                    <input type="email" class="form-control" asp-for="Settings.SenderEmail" />
                </div>

                <div class="col-md-3 mb-3">
                    <label>SMTP Username</label>
                    <input type="text" class="form-control" asp-for="Settings.SmtpUsername" />
                </div>

                <div class="col-md-3 mb-3">
                    <label>SMTP Password</label>
                    <input type="password" class="form-control" asp-for="Settings.SmtpPassword" />
                </div>
            </div>

            <hr />

                <h5 class="mt-3">WhatsApp Api</h5>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label>System Url</label>
                        <input type="text" class="form-control" asp-for="Settings.systemUrl" required />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label>WhatsApp API Url</label>
                        <input type="text" class="form-control" asp-for="Settings.waApiUrl" required />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label>WhatsApp Access Token</label>
                        <input type="text" class="form-control" asp-for="Settings.waAccessToken" required />
                    </div>
                </div>

            <hr />

            <h5 class="mt-3">Burial Rules</h5>
            <div class="row">
                <div class="col-md-3 mb-3">
                    <label>Max Burials Per Day</label>
                    <input type="number" class="form-control" asp-for="Settings.MaxBurialsPerDay" required />
                </div>

                <div class="col-md-3 mb-3">
                    <label>Minutes Between Burials</label>
                    <input type="number" class="form-control" asp-for="Settings.MinutesBetweenBurials" required />
                </div>

                    <div class="col-md-3 mb-3">
                        <label>Day Start Hour (e.g 8)</label>
                        <input type="number" class="form-control" asp-for="Settings.dayStartTime" required />
                    </div>

                    <div class="col-md-3 mb-3">
                        <label>Day End Hour (e.g 16 for 4pm)</label>
                        <input type="number" class="form-control" asp-for="Settings.dayEndTime" required />
                    </div>
            </div>

            <div class="text-end mt-4">
                <button type="submit" class="btn btn-success">Save Settings</button>
                <button type="submit" formaction="?handler=TestEmail" class="btn btn-primary">Send Test Email</button>
            </div>

        </form>
    </div>
</div>
</div>
