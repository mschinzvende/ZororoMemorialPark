@page
@model ZororoMemorialPark.Pages.Tools.SmtpTestModel
@{
    ViewData["Title"] = "SMTP Tester";
}

<div class="container py-4">

    <h3>SMTP Tester</h3>
    <p class="text-muted">Send a test email using the configured SMTP settings.</p>

    @if (Model.SuccessMessage != null)
    {
        <div class="alert alert-success">@Model.SuccessMessage</div>
    }

    @if (Model.ErrorMessage != null)
    {
        <div class="alert alert-danger">
            <strong>SMTP Error:</strong><br />
            <pre style="white-space: pre-wrap;">@Model.ErrorMessage</pre>
        </div>
    }

    <div class="card shadow-sm mt-3">
        <div class="card-body">

            <form method="post">
                <div class="mb-3">
                    <label>Recipient Email</label>
                    <input asp-for="Input.ToEmail" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label>Subject</label>
                    <input asp-for="Input.Subject" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label>Message</label>
                    <textarea asp-for="Input.Message" class="form-control" rows="5" required></textarea>
                </div>

                <button type="submit" class="btn btn-success">Send Test Email</button>
            </form>

            <hr />

            <h5>Loaded SMTP Settings</h5>
            @if (Model.Settings != null)
            {
                <ul>
                    <li><strong>SMTP Server:</strong> @Model.Settings.SmtpServer</li>
                    <li><strong>Port:</strong> @Model.Settings.SmtpPort</li>
                    <li><strong>Use SSL:</strong> @Model.Settings.UseSSL</li>
                    <li><strong>Username:</strong> @Model.Settings.SmtpUsername</li>
                    <li><strong>Email From:</strong> @Model.Settings.Email</li>
                </ul>
            }
        </div>
    </div>

</div>
