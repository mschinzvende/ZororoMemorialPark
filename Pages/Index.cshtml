@page
@model ZororoMemorialPark.Pages.IndexModel
@{
    ViewData["Title"] = "Cemetery Dashboard";
}

@using Microsoft.AspNetCore.Identity
@inject UserManager<IdentityUser> UserManager

@{
    bool isManager = User.IsInRole("Manager");
    bool isOps = User.IsInRole("OperationsOfficer");
    bool isFinance = User.IsInRole("FinanceOfficer");
    bool isAgent = User.IsInRole("Agent");

    if (isAgent)
    {
        Response.Redirect("/Graves/Graves");
    }
}

<style>
    .chart-container {
        position: relative;
        height: 240px;
        width: 100%;
    }
</style>

<div class="container-fluid mt-4 mb-4">

    <!-- TOP MONTH METRICS -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card shadow-sm p-3 text-center">
                <h6 class="mb-1">Revenue (This Month)</h6>
                <h3 class="fw-bold">$@Model.RevenueThisMonth</h3>
                <small class="text-muted">@Model.CurrentMonthLabel</small>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm p-3 text-center">
                <h6 class="mb-1">Outstanding (This Month)</h6>
                <h3 class="fw-bold text-danger">$@Model.OutstandingThisMonth</h3>
                <small class="text-muted">Open balance on invoices this month</small>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm p-3 text-center">
                <h6 class="mb-1">Graves Sold (This Month)</h6>
                <h3 class="fw-bold text-primary">@Model.GravesSoldThisMonth</h3>
                <small class="text-muted">Allocations in the month</small>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm p-3 text-center">
                <h6 class="mb-1">New Reservations (This Month)</h6>
                <h3 class="fw-bold text-warning">@Model.NewReservationsThisMonth</h3>
                <small class="text-muted">New reservation records created</small>
            </div>
        </div>
    </div>

    <!-- CHARTS -->
    <div class="row g-4">

        <!-- Under Construction per Section (Current Month) -->
        <div class="col-lg-6 col-md-12">
            <div class="card shadow-sm p-3">
                <h6 class="mb-2">Under Construction Graves per Section (Current Month)</h6>
                <div class="chart-container">
                    <canvas id="underConstructionMonthBySectionChart"></canvas>
                </div>
                <small class="text-muted">
                    Based on jobs ending this month that are Pending/In Progress
                </small>
            </div>
        </div>

        <!-- Burials (Allocations) per Section (Current Month) -->
        <div class="col-lg-6 col-md-12">
            <div class="card shadow-sm p-3">
                <h6 class="mb-2">Burials (Allocations) per Section (Current Month)</h6>
                <div class="chart-container">
                    <canvas id="burialsMonthBySectionChart"></canvas>
                </div>

                <small class="text-muted">
                    Allocations with allocated date within the month
                </small>
            </div>
        </div>


        <!-- Available Graves for Sale per Section -->
        <div class="col-lg-6 col-md-12">
            <div class="card shadow-sm p-3">
                <h6 class="mb-2">Available Graves for Sale per Section</h6>
                <div class="chart-container">
                    <canvas id="availableGravesBySectionChart"></canvas>
                </div>
                <small class="text-muted">
                    Graves currently unsold and available for allocation
                </small>
            </div>
        </div>


        <!-- Development Stage per Section (Current Month) -->
        <div class="col-lg-6 col-md-12">
            <div class="card shadow-sm p-3">
                <h6 class="mb-2">Development Stage per Section (Current Month)</h6>
                <div class="chart-container">
                    <canvas id="stageMonthBySectionChart"></canvas>
                </div>
                <small class="text-muted">
                    Stages of graves currently in active construction jobs ending this month
                </small>
            </div>
        </div>

        <!-- Monthly Revenue Trend (Last 6 Months) -->
        <div class="col-lg-6 col-md-12">
            <div class="card shadow-sm p-3">
                <h6 class="mb-2">Monthly Revenue Trend (Last 6 Months)</h6>
                <div class="chart-container">
                    <canvas id="revenueTrend6MonthsChart"></canvas>
                </div>
                <small class="text-muted">Sum of payments per month</small>
            </div>
        </div>

    </div>

    <div class="mb-5"></div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        // -----------------------------
        // Under Construction per Section (Current Month)
        // -----------------------------
        new Chart(document.getElementById("underConstructionMonthBySectionChart"), {
            type: "bar",
            data: {
                labels: @Html.Raw(Model.UnderConstructionMonthSectionNamesJson),
                datasets: [{
                    label: "Under Construction",
                    data: @Html.Raw(Model.UnderConstructionMonthSectionCountsJson),
                    backgroundColor: "#8e24aa"
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    y: { beginAtZero: true, ticks: { precision: 0 } }
                }
            }
        });

        // -----------------------------
        // Burials per Section (Current Month)
        // -----------------------------
        new Chart(document.getElementById("burialsMonthBySectionChart"), {
            type: "bar",
            data: {
                labels: @Html.Raw(Model.BurialsMonthSectionNamesJson),
                datasets: [{
                    label: "Burials",
                    data: @Html.Raw(Model.BurialsMonthSectionCountsJson),
                    backgroundColor: "#1565c0"
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    y: { beginAtZero: true, ticks: { precision: 0 } }
                }
            }
        });

        // -----------------------------
        // Development Stage per Section (Current Month) - stacked bar
        // -----------------------------
        const stageSectionLabels = @Html.Raw(Model.StageMonthMatrixSectionLabelsJson);
        const stageMonthMatrixData = @Html.Raw(Model.StageMonthMatrixDataJson);

        const stageColors = ["#2E7D32", "#0277BD", "#F9A825", "#8E24AA", "#C62828", "#00897B", "#5D4037", "#6A1B9A"];
        let idx = 0;

        const stageDatasets = [];
        for (const stageName in stageMonthMatrixData) {
            stageDatasets.push({
                label: stageName,
                data: stageMonthMatrixData[stageName],
                backgroundColor: stageColors[idx % stageColors.length]
            });
            idx++;
        }

        new Chart(document.getElementById("stageMonthBySectionChart"), {
            type: "bar",
            data: {
                labels: stageSectionLabels,
                datasets: stageDatasets
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { position: "bottom" } },
                scales: {
                    x: { stacked: true },
                    y: { stacked: true, beginAtZero: true, ticks: { precision: 0 } }
                }
            }
        });

        // -----------------------------
        // Revenue Trend - Last 6 Months
        // -----------------------------
        new Chart(document.getElementById("revenueTrend6MonthsChart"), {
            type: "line",
            data: {
                labels: @Html.Raw(Model.Revenue6MonthsLabelsJson),
                datasets: [{
                    label: "Revenue",
                    data: @Html.Raw(Model.Revenue6MonthsValuesJson),
                    borderColor: "#0277bd",
                    borderWidth: 2,
                    fill: false,
                    tension: 0.2
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: { y: { beginAtZero: true } }
            }
        });
    </script>


    <script>
        // -----------------------------
        // Available Graves for Sale per Section
        // -----------------------------
        new Chart(document.getElementById("availableGravesBySectionChart"), {
            type: "bar",
            data: {
                labels: @Html.Raw(Model.AvailableSaleSectionNamesJson),
                datasets: [{
                    label: "Available Graves",
                    data: @Html.Raw(Model.AvailableSaleSectionCountsJson),
                    backgroundColor: "#2e7d32"
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: { precision: 0 }
                    }
                }
            }
        });
    </script>

}
