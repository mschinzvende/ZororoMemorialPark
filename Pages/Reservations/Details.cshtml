@page "{id:int}"
@model ZororoMemorialPark.Pages.Reservations.DetailsModel
@{
    ViewData["Title"] = "Reservation";
    var reference = string.IsNullOrWhiteSpace(Model.Reservation.sys_reservationReference)
        ? $"RES-{Model.Reservation.sys_reservationId}"
        : Model.Reservation.sys_reservationReference;
}

<div class="container-fluid py-4 mb-4">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">@TempData["SuccessMessage"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">@TempData["ErrorMessage"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <a asp-page="Index" class="text-decoration-none small"><i class="bi bi-arrow-left"></i> Reservations</a>
            <h4 class="mb-0 mt-1">@reference</h4>
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#editReservationModal"><i class="bi bi-pencil-square me-1"></i> Edit reservation</button>
            @if (Model.Invoices.Any(x => x.Balance > 0))
            {
                <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#capturePaymentModal"><i class="bi bi-cash-coin me-1"></i> Capture installment</button>
            }
        </div>
    </div>

    <div class="row g-4">
        <div class="col-xl-8">
            <div class="card shadow-sm mb-4">
                <div class="card-header" style="background-color: var(--primary-green); color: var(--primary-white);"><h6 class="mb-0">Reservation overview</h6></div>
                <div class="card-body">
                    <div class="row g-4">
                        <div class="col-md-6">
                            <h6 class="border-bottom pb-2">Customer contact</h6>
                            <dl class="row mb-0">
                                <dt class="col-sm-5">Name</dt><dd class="col-sm-7">@Model.Customer.sys_paymentMadeBy</dd>
                                <dt class="col-sm-5">Phone</dt><dd class="col-sm-7">@Model.Customer.sys_customerPhone</dd>
                                <dt class="col-sm-5">Email</dt><dd class="col-sm-7">@(Model.Customer.sys_customerEmail ?? "Not recorded")</dd>
                            </dl>
                        </div>
                        <div class="col-md-6">
                            <h6 class="border-bottom pb-2">Terms</h6>
                            <dl class="row mb-0">
                                <dt class="col-sm-6">Selected section</dt><dd class="col-sm-6">@(Model.PreferredSection?.sys_sectionName ?? "Not recorded")</dd>
                                <dt class="col-sm-6">Agreed price</dt><dd class="col-sm-6">$@Model.Reservation.sys_agreedPrice.ToString("N2")</dd>
                                <dt class="col-sm-6">Next installment</dt><dd class="col-sm-6">@(Model.Reservation.sys_nextInstallmentDueDate?.ToString("dd MMM yyyy") ?? "Not scheduled")</dd>
                                <dt class="col-sm-6">Expiry</dt><dd class="col-sm-6">@(Model.Reservation.sys_expiryDate?.ToString("dd MMM yyyy") ?? "Not set")</dd>
                            </dl>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h6 class="mb-0">Reservation invoices and payments</h6>
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge @(Model.PaymentStatus == "Fully paid" ? "bg-success" : Model.PaymentStatus == "Partially paid" ? "bg-warning text-dark" : "bg-primary")">@Model.PaymentStatus</span>
                        @if (Model.Invoices.Any(x => x.Balance > 0))
                        {
                            <button type="button" class="btn btn-sm btn-success" data-bs-toggle="modal" data-bs-target="#capturePaymentModal">Capture payment</button>
                        }
                    </div>
                </div>
                <div class="card-body">
                    <div class="row text-center border-bottom pb-3 mb-3">
                        <div class="col-4"><small class="d-block text-muted">Total</small><strong>$@Model.Total.ToString("N2")</strong></div>
                        <div class="col-4"><small class="d-block text-muted">Paid</small><strong class="text-success">$@Model.Paid.ToString("N2")</strong></div>
                        <div class="col-4"><small class="d-block text-muted">Balance</small><strong class="text-warning">$@Model.Balance.ToString("N2")</strong></div>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-sm table-striped align-middle">
                            <thead><tr><th>Invoice</th><th>Issued</th><th>Due</th><th class="text-end">Total</th><th class="text-end">Paid</th><th class="text-end">Balance</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var invoice in Model.Invoices)
                                {
                                    <tr>
                                        <td>#@invoice.InvoiceId</td><td>@invoice.InvoiceDate.ToString("dd MMM yyyy")</td><td>@invoice.DueDate.ToString("dd MMM yyyy")</td>
                                        <td class="text-end">$@invoice.Total.ToString("N2")</td><td class="text-end">$@invoice.Paid.ToString("N2")</td><td class="text-end">$@invoice.Balance.ToString("N2")</td>
                                        <td class="text-end"><a asp-page="/Finance/InvoiceDetail" asp-route-id="@invoice.InvoiceId" class="btn btn-sm btn-outline-primary">Open</a></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (Model.Payments.Any())
                    {
                        <h6 class="mt-4 mb-2">Payment history</h6>
                        <div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th>Date</th><th>Invoice</th><th>Method</th><th>Receipt</th><th class="text-end">Amount</th></tr></thead><tbody>
                            @foreach (var payment in Model.Payments) { <tr><td>@payment.sys_date.ToString("dd MMM yyyy")</td><td>#@payment.sys_invoiceId</td><td>@payment.sys_paymentMethod</td><td>@payment.sys_receiptNumber</td><td class="text-end">$@payment.sys_amount.ToString("N2")</td></tr> }
                        </tbody></table></div>
                    }
                </div>
            </div>
        </div>

        <div class="col-xl-4">
            <div class="card shadow-sm mb-4">
                <div class="card-header"><h6 class="mb-0">Grave assignment</h6></div>
                <div class="card-body">
                    @if (Model.LinkedGrave != null)
                    {
                        <div class="alert alert-success mb-3"><i class="bi bi-check-circle me-1"></i> Grave <strong>@Model.LinkedGrave.sys_plotNumber</strong> is reserved.</div>
                        <dl class="row mb-0"><dt class="col-5">Section</dt><dd class="col-7">@Model.LinkedGraveSection?.sys_sectionName</dd><dt class="col-5">Plot</dt><dd class="col-7">@Model.LinkedGrave.sys_plotNumber</dd></dl>
                        <div class="d-flex gap-2 mt-3">
                            <a class="btn btn-outline-primary btn-sm" asp-page="/Graves/GraveDetails" asp-route-id="@Model.LinkedGrave.sys_graveId">Open grave</a>
                            @if (Model.CanManageGraveLink)
                            {
                                <form method="post" asp-page-handler="UnlinkGrave" onsubmit="return confirm('Unlink this grave and make it available for sale again?');">
                                    <input type="hidden" name="reservationId" value="@Model.Reservation.sys_reservationId" />
                                    <button class="btn btn-outline-danger btn-sm"><i class="bi bi-link-45deg me-1"></i> Unlink grave</button>
                                </form>
                            }
                        </div>
                    }
                    else if (!Model.CanManageGraveLink)
                    {
                        <p class="text-muted mb-0">No physical grave has been assigned. A manager or operations officer can link one when it is available.</p>
                    }
                    else if (!Model.AvailableGraves.Any())
                    {
                        <p class="text-muted mb-0">No unsold graves are currently available in the selected section.</p>
                    }
                    else
                    {
                        <p class="small text-muted">Only unsold graves in @Model.PreferredSection?.sys_sectionName are shown.</p>
                        <form method="post" asp-page-handler="LinkGrave">
                            <input type="hidden" name="reservationId" value="@Model.Reservation.sys_reservationId" />
                            <label class="form-label fw-semibold">Available grave</label>
                            <select class="form-select mb-3" name="graveId" required><option value="">Select plot</option>@foreach (var grave in Model.AvailableGraves) { <option value="@grave.sys_graveId">@grave.sys_plotNumber</option> }</select>
                            <button class="btn btn-primary w-100"><i class="bi bi-link-45deg me-1"></i> Link grave</button>
                        </form>
                    }
                </div>
            </div>
            <div class="card shadow-sm"><div class="card-header"><h6 class="mb-0">Beneficiaries</h6></div><div class="card-body">
                @if (Model.Beneficiaries.Any()) { <ul class="list-group list-group-flush">@foreach (var beneficiary in Model.Beneficiaries) { <li class="list-group-item px-0"><strong>@beneficiary.sys_benefitFullName</strong><br /><small class="text-muted">@beneficiary.sys_benefitRelationship · @beneficiary.sys_benefitDOB.ToString("dd MMM yyyy")</small></li> }</ul> }
                else { <p class="text-muted mb-0">No beneficiaries recorded.</p> }
            </div></div>
        </div>
    </div>
</div>

<div class="modal fade" id="capturePaymentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form method="post" asp-page-handler="CapturePayment">
                <div class="modal-header" style="background-color: var(--primary-green); color: var(--primary-white);">
                    <div><h5 class="modal-title">Capture installment payment</h5><small>Confirmation is sent to the reservation contact after payment is saved.</small></div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="reservationId" value="@Model.Reservation.sys_reservationId" />
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Outstanding invoice</label>
                        <select class="form-select" name="invoiceId" required>
                            @foreach (var invoice in Model.Invoices.Where(x => x.Balance > 0))
                            {
                                <option value="@invoice.InvoiceId">Invoice #@invoice.InvoiceId — balance $@invoice.Balance.ToString("N2")</option>
                            }
                        </select>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6"><label class="form-label fw-semibold">Amount</label><input type="number" class="form-control" name="amount" min="0.01" step="0.01" required /></div>
                        <div class="col-md-6"><label class="form-label fw-semibold">Payment date</label><input type="date" class="form-control" name="paymentDate" value="@DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd")" required /></div>
                        <div class="col-md-6"><label class="form-label fw-semibold">Payment method</label><select class="form-select" name="paymentMethodId" required><option value="">Select method</option>@foreach (var method in Model.PaymentMethods) { <option value="@method.sys_paymentMethodId">@method.sys_paymentMethodName</option> }</select></div>
                        <div class="col-md-6"><label class="form-label fw-semibold">Notes</label><input type="text" class="form-control" name="notes" placeholder="Optional" /></div>
                    </div>
                </div>
                <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-primary">Save payment &amp; notify</button></div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="editReservationModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <form method="post" asp-page-handler="Update" class="modal-content border-0 shadow">
                <div class="modal-header" style="background-color: var(--primary-green); color: var(--primary-white);">
                    <div><h5 class="modal-title">Edit reservation</h5><small>Changes to the next installment date update outstanding reservation invoices.</small></div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input asp-for="EditInput.ReservationId" type="hidden" />
                    <input asp-for="EditInput.BeneficiaryId" type="hidden" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div class="row g-3">
                        <div class="col-12"><h6 class="border-bottom pb-2">Customer contact</h6></div>
                        <div class="col-md-6"><label asp-for="EditInput.CustomerName" class="form-label fw-semibold">Customer name</label><input asp-for="EditInput.CustomerName" class="form-control" /><span asp-validation-for="EditInput.CustomerName" class="text-danger"></span></div>
                        <div class="col-md-6"><label asp-for="EditInput.CustomerPhone" class="form-label fw-semibold">WhatsApp / phone number</label><input asp-for="EditInput.CustomerPhone" class="form-control" /><span asp-validation-for="EditInput.CustomerPhone" class="text-danger"></span></div>
                        <div class="col-md-6"><label asp-for="EditInput.CustomerEmail" class="form-label fw-semibold">Email address</label><input asp-for="EditInput.CustomerEmail" type="email" class="form-control" /><span asp-validation-for="EditInput.CustomerEmail" class="text-danger"></span></div>
                        <div class="col-md-6"><label asp-for="EditInput.Status" class="form-label fw-semibold">Reservation status</label><select asp-for="EditInput.Status" class="form-select"><option value="Active">Active</option><option value="Expired">Expired</option><option value="Cancelled">Cancelled</option></select></div>
                        <div class="col-12"><h6 class="border-bottom pb-2 mt-2">Reservation terms</h6></div>
                        <div class="col-md-6">
                            <label asp-for="EditInput.SectionId" class="form-label fw-semibold">Selected section</label>
                            @if (Model.LinkedGrave != null)
                            {
                                <input asp-for="EditInput.SectionId" type="hidden" />
                                <input class="form-control" value="@Model.PreferredSection?.sys_sectionName" disabled />
                                <small class="text-muted">The section is locked because a grave has been linked.</small>
                            }
                            else
                            {
                                <select asp-for="EditInput.SectionId" class="form-select"><option value="">Select section</option>@foreach (var availableSection in Model.Sections) { <option value="@availableSection.sys_sectionId">@availableSection.sys_sectionName</option> }</select>
                            }
                            <span asp-validation-for="EditInput.SectionId" class="text-danger"></span>
                        </div>
                        <div class="col-md-6"><label asp-for="EditInput.AgreedPrice" class="form-label fw-semibold">Agreed price</label><input asp-for="EditInput.AgreedPrice" type="number" min="0" step="0.01" class="form-control" /><small class="text-muted">The price remains locked unless you explicitly amend it.</small><span asp-validation-for="EditInput.AgreedPrice" class="text-danger"></span></div>
                        <div class="col-md-6"><label asp-for="EditInput.NextInstallmentDueDate" class="form-label fw-semibold">Next installment due</label><input asp-for="EditInput.NextInstallmentDueDate" type="date" class="form-control" /><span asp-validation-for="EditInput.NextInstallmentDueDate" class="text-danger"></span></div>
                        <div class="col-md-6"><label asp-for="EditInput.ExpiryDate" class="form-label fw-semibold">Reservation expiry</label><input asp-for="EditInput.ExpiryDate" type="date" class="form-control" /></div>
                        <div class="col-12"><h6 class="border-bottom pb-2 mt-2">Beneficiary</h6></div>
                        <div class="col-md-6"><label asp-for="EditInput.BeneficiaryFullName" class="form-label fw-semibold">Full name</label><input asp-for="EditInput.BeneficiaryFullName" class="form-control" /><span asp-validation-for="EditInput.BeneficiaryFullName" class="text-danger"></span></div>
                        <div class="col-md-3"><label asp-for="EditInput.BeneficiaryDOB" class="form-label fw-semibold">Date of birth</label><input asp-for="EditInput.BeneficiaryDOB" type="date" class="form-control" /><span asp-validation-for="EditInput.BeneficiaryDOB" class="text-danger"></span></div>
                        <div class="col-md-3"><label asp-for="EditInput.BeneficiaryRelationship" class="form-label fw-semibold">Relationship</label><input asp-for="EditInput.BeneficiaryRelationship" class="form-control" /><span asp-validation-for="EditInput.BeneficiaryRelationship" class="text-danger"></span></div>
                    </div>
                </div>
                <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-primary">Save changes</button></div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @if (!ViewContext.ModelState.IsValid)
    {
        <script>document.addEventListener('DOMContentLoaded', () => new bootstrap.Modal(document.getElementById('editReservationModal')).show());</script>
    }
}
