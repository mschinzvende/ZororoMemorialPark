@page
@model ZororoMemorialPark.Pages.Reservations.IndexModel
@{
    ViewData["Title"] = "Reservations";
}

<div class="container-fluid py-4 mb-4">
    @if (Model.ShowCreateModal && !ViewContext.ModelState.IsValid)
    {
        <div class="alert alert-danger" role="alert">
            The reservation was not created. Check the highlighted fields in the create form.
            <div asp-validation-summary="All"></div>
        </div>
    }
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm mb-5">
        <div class="card-header d-flex justify-content-between align-items-center"
             style="background-color: var(--primary-green); color: var(--primary-white);">
            <div>
                <h5 class="mb-0">Grave Reservations</h5>
                <small class="d-block" style="font-size: .8rem;">Reserve a section and price first; select the physical grave when it becomes available.</small>
            </div>
            <button type="button" class="btn btn-light btn-sm" data-bs-toggle="modal" data-bs-target="#createReservationModal">
                <i class="bi bi-plus-circle me-1"></i> New Reservation
            </button>
        </div>

        <div class="card-body">
            <div class="alert alert-light border d-flex gap-2 align-items-start">
                <i class="bi bi-info-circle text-success mt-1"></i>
                <div><strong>Section price is locked on creation.</strong> A reservation does not hold a specific plot until a user links an available grave from its timeline.</div>
            </div>

            <form method="get" class="row g-2 align-items-end mb-4">
                <div class="col-lg-4 col-md-6">
                    <label asp-for="SearchTerm" class="form-label small fw-semibold mb-1">Search</label>
                    <input asp-for="SearchTerm" class="form-control" placeholder="Reference, customer, phone, section, or plot" />
                </div>
                <div class="col-lg-2 col-md-3">
                    <label asp-for="StatusFilter" class="form-label small fw-semibold mb-1">Reservation state</label>
                    <select asp-for="StatusFilter" class="form-select">
                        <option value="All">All states</option>
                        <option value="Active">Active</option>
                        <option value="Expired">Expired</option>
                        <option value="Cancelled">Cancelled</option>
                    </select>
                </div>
                <div class="col-lg-2 col-md-3">
                    <label asp-for="SectionFilter" class="form-label small fw-semibold mb-1">Section</label>
                    <select asp-for="SectionFilter" class="form-select">
                        <option value="">All sections</option>
                        @foreach (var filterSection in Model.Sections)
                        {
                            <option value="@filterSection.sys_sectionId">@filterSection.sys_sectionName</option>
                        }
                    </select>
                </div>
                <div class="col-lg-2 col-md-3">
                    <label asp-for="GraveLinkFilter" class="form-label small fw-semibold mb-1">Grave link</label>
                    <select asp-for="GraveLinkFilter" class="form-select">
                        <option value="All">All</option>
                        <option value="Unlinked">Not linked</option>
                        <option value="Linked">Linked</option>
                    </select>
                </div>
                <div class="col-lg-2 col-md-3 d-flex gap-2">
                    <button class="btn btn-primary flex-grow-1"><i class="bi bi-funnel me-1"></i> Filter</button>
                    <a asp-page="Index" class="btn btn-outline-secondary" title="Clear filters"><i class="bi bi-x-lg"></i></a>
                </div>
            </form>

            <div class="d-flex justify-content-between align-items-center mb-2">
                <small class="text-muted">@Model.TotalRecords reservation@(Model.TotalRecords == 1 ? string.Empty : "s") found</small>
                <small class="text-muted">Page @Model.PageNumber of @Model.TotalPages</small>
            </div>

            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Reference</th>
                            <th>Customer</th>
                            <th>Reserved section</th>
                            <th>Linked grave</th>
                            <th>Next due</th>
                            <th class="text-end">Price</th>
                            <th class="text-end">Balance</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Reservations.Any())
                        {
                            @foreach (var reservation in Model.Reservations)
                            {
                                var statusClass = reservation.Status switch
                                {
                                    "Fully paid" => "bg-success",
                                    "Partially paid" => "bg-warning text-dark",
                                    "Cancelled" or "Expired" => "bg-secondary",
                                    _ => "bg-primary"
                                };
                                <tr>
                                    <td class="fw-semibold">@reservation.Reference<br /><small class="text-muted">@reservation.ReservedOn.ToString("dd MMM yyyy")</small></td>
                                    <td>@reservation.CustomerName<br /><small class="text-muted">@reservation.CustomerPhone</small></td>
                                    <td>@reservation.SectionName</td>
                                    <td>
                                        @if (reservation.GraveLabel is null)
                                        {
                                            <span class="text-muted">Not linked</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-dark border">@reservation.GraveLabel</span>
                                        }
                                    </td>
                                    <td>@(reservation.NextInstallmentDueDate?.ToString("dd MMM yyyy") ?? "Not scheduled")</td>
                                    <td class="text-end">$@reservation.AgreedPrice.ToString("N2")</td>
                                    <td class="text-end">$@reservation.Balance.ToString("N2")</td>
                                    <td><span class="badge @statusClass">@reservation.Status</span></td>
                                    <td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-page="Details" asp-route-id="@reservation.Id">Open</a></td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="9" class="text-center text-muted py-4">No reservations have been created.</td></tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.TotalPages > 1)
            {
                <nav class="mt-4" aria-label="Reservations pagination">
                    <ul class="pagination pagination-sm justify-content-center mb-0">
                        <li class="page-item @(Model.PageNumber == 1 ? "disabled" : string.Empty)">
                            <a class="page-link" asp-route-PageNumber="@(Model.PageNumber - 1)" asp-route-SearchTerm="@Model.SearchTerm" asp-route-StatusFilter="@Model.StatusFilter" asp-route-SectionFilter="@Model.SectionFilter" asp-route-GraveLinkFilter="@Model.GraveLinkFilter">Previous</a>
                        </li>
                        @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
                        {
                            <li class="page-item @(pageNumber == Model.PageNumber ? "active" : string.Empty)">
                                <a class="page-link" asp-route-PageNumber="@pageNumber" asp-route-SearchTerm="@Model.SearchTerm" asp-route-StatusFilter="@Model.StatusFilter" asp-route-SectionFilter="@Model.SectionFilter" asp-route-GraveLinkFilter="@Model.GraveLinkFilter">@pageNumber</a>
                            </li>
                        }
                        <li class="page-item @(Model.PageNumber == Model.TotalPages ? "disabled" : string.Empty)">
                            <a class="page-link" asp-route-PageNumber="@(Model.PageNumber + 1)" asp-route-SearchTerm="@Model.SearchTerm" asp-route-StatusFilter="@Model.StatusFilter" asp-route-SectionFilter="@Model.SectionFilter" asp-route-GraveLinkFilter="@Model.GraveLinkFilter">Next</a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    </div>
</div>

<div class="modal fade" id="createReservationModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form method="post" asp-page-handler="Create">
                <div class="modal-header" style="background-color: var(--primary-green); color: var(--primary-white);">
                    <div>
                        <h5 class="modal-title">Create reservation</h5>
                        <small>Choose the section to lock the agreed price.</small>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Input.SectionId" class="form-label fw-semibold"></label>
                            <select asp-for="Input.SectionId" class="form-select" required>
                                <option value="">Select section</option>
                                @foreach (var item in Model.Sections)
                                {
                                    <option value="@item.sys_sectionId">@item.sys_sectionName — $@(item.sys_SecPrice.ToString("N2"))</option>
                                }
                            </select>
                            <span asp-validation-for="Input.SectionId" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Input.NextInstallmentDueDate" class="form-label fw-semibold"></label>
                            <input asp-for="Input.NextInstallmentDueDate" type="date" class="form-control" required />
                            <span asp-validation-for="Input.NextInstallmentDueDate" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Input.CustomerName" class="form-label fw-semibold"></label>
                            <input asp-for="Input.CustomerName" class="form-control" required />
                            <span asp-validation-for="Input.CustomerName" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Input.CustomerPhone" class="form-label fw-semibold"></label>
                            <input asp-for="Input.CustomerPhone" class="form-control" placeholder="263771234567" required />
                            <small class="text-muted">WhatsApp number including country code.</small>
                            <span asp-validation-for="Input.CustomerPhone" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Input.CustomerEmail" class="form-label fw-semibold"></label>
                            <input asp-for="Input.CustomerEmail" type="email" class="form-control" placeholder="Optional" />
                            <span asp-validation-for="Input.CustomerEmail" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Input.ExpiryDate" class="form-label fw-semibold"></label>
                            <input asp-for="Input.ExpiryDate" type="date" class="form-control" />
                            <small class="text-muted">Optional internal control date.</small>
                            <span asp-validation-for="Input.ExpiryDate" class="text-danger"></span>
                        </div>
                        <div class="col-12"><hr class="my-1" /><h6 class="mb-0">Beneficiary</h6></div>
                        <div class="col-md-6">
                            <label asp-for="Input.BeneficiaryFullName" class="form-label fw-semibold"></label>
                            <input asp-for="Input.BeneficiaryFullName" class="form-control" required />
                            <span asp-validation-for="Input.BeneficiaryFullName" class="text-danger"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Input.BeneficiaryDOB" class="form-label fw-semibold"></label>
                            <input asp-for="Input.BeneficiaryDOB" type="date" class="form-control" required />
                            <span asp-validation-for="Input.BeneficiaryDOB" class="text-danger"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Input.BeneficiaryRelationship" class="form-label fw-semibold"></label>
                            <input asp-for="Input.BeneficiaryRelationship" class="form-control" placeholder="e.g. Parent" required />
                            <span asp-validation-for="Input.BeneficiaryRelationship" class="text-danger"></span>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Create reservation</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @if (Model.ShowCreateModal)
    {
        <script>document.addEventListener('DOMContentLoaded', () => new bootstrap.Modal(document.getElementById('createReservationModal')).show());</script>
    }
}
