@page
@model ZororoMemorialPark.Pages.Finance.InvoicesListModel
@{
    ViewData["Title"] = "Invoices";
}



<div class="card shadow-sm mb-5">
    <div class="card-header d-flex justify-content-between align-items-center"
         style="background-color: var(--primary-green); color: var(--primary-white);">
        <h5 class="mb-0">Invoices</h5>
        <div>
            <a asp-page="./CreateInvoice" class="btn btn-light btn-sm">+ New Invoice</a>
        </div>
    </div>

    <div class="card-body">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">@TempData["SuccessMessage"]</div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
        }

        <div class="row">
            <div class="col-sm-2">


                <div class="form-group">
                    <!--		Show Numbers Of Rows 		-->
                    <select class="form-select form-control" name="state" id="maxRows">

                        <option value="10">Show 10</option>
                        <option value="15">15</option>
                        <option value="20">20</option>
                        <option value="50">50</option>
                        <option value="70">70</option>
                        <option value="100">100</option>
                        <option value="5000">ALL</option>
                    </select>

                </div>


            </div>
            <div class="col-sm-4">
                <input type="text" id="search_input_all" onkeyup="FilterkeyWord_all_table()" placeholder="Search Table" class="form-control">

            </div>
        </div>


        <table class="table table-striped table-class table-sm" id="myTable">

            <thead class="thead-light">
                <tr>
                    <th>Invoice #</th>
                    <th>Date</th>
                    <th>Customer</th>
                    <th>Type</th>
                    <th class="text-end">Total</th>
                    <th class="text-end">Paid</th>
                    <th class="text-end">Balance</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var inv in Model.Invoices)
                {
                    var balance = inv.TotalAmount - inv.PaidAmount;
                    <tr>
                        <td>
                            <a asp-page="./InvoiceDetail" asp-route-id="@inv.sys_invoiceId" >@inv.sys_invoiceId</a>
                        </td>
                        <td>@inv.sys_invoiceDate.ToString("yyyy-MM-dd")</td>
                        <td>@inv.CustomerName</td>
                        <td>
                            @if (inv.InvoiceType == "ProductService")
                            {
                                <span class="badge bg-primary">Products/Services</span>
                            }
                            else if (inv.InvoiceType == "GraveSale")
                            {
                                <span class="badge bg-success">Grave Sale</span>
                            }
                            else
                            {
                                <span class="badge bg-info text-dark">Reservation</span>
                            }
                        </td>
                        <td class="text-end">$@inv.TotalAmount.ToString("N2")</td>
                        <td class="text-end">$@inv.PaidAmount.ToString("N2")</td>
                        <td class="text-end">
                            <span class="badge @(balance <= 0 ? "bg-success" : "bg-warning text-dark")">
                                $@balance.ToString("N2")
                            </span>
                        </td>
                        <td class="text-end">
                            <a asp-page="./InvoiceDetail" asp-route-id="@inv.sys_invoiceId" class="btn btn-sm btn-outline-primary">View</a>

                            @if (inv.InvoiceType != "GraveSale" && inv.InvoiceType != "Reservation")
                            {
                                <button class="btn btn-sm btn-success"
                                        data-bs-toggle="modal"
                                        data-bs-target="#paymentModal"
                                        data-invoice="@inv.sys_invoiceId"
                                data-balance="@balance">
                                    Capture Payment
                                </button>
                            }
                        </td>
                    </tr>

                    @* Expand payments if this invoice is selected *@
                    if (Model.ExpandedId.HasValue && Model.ExpandedId.Value == inv.sys_invoiceId)
                    {
                        <tr>
                            <td colspan="8" class="bg-light">
                                <strong>Payments</strong>
                                @if (inv.Payments.Any())
                                {
                                    <table class="table table-sm mt-2 mb-0">
                                        <thead>
                                            <tr>
                                                <th>Date</th>
                                                <th>Amount</th>
                                                <th>Method</th>
                                                <th>Receipt</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var p in inv.Payments)
                                            {
                                                <tr>
                                                    <td>@p.sys_date.ToString("yyyy-MM-dd")</td>
                                                    <td>$@p.sys_amount.ToString("N2")</td>
                                                    <td>@p.sys_paymentMethod</td>
                                                    <td>@p.sys_receiptNumber</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                }
                                else
                                {
                                    <div class="text-muted mt-2">No payments recorded</div>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>

        <!--		Start Pagination -->
        <div class="pagination-container">
            <nav>
                <ul class="pagination">
                    <!--	Here the JS Function Will Add the Rows -->
                </ul>
            </nav>
        </div>
        <div class="rows_count">Showing 11 to 20 of 91 entries</div>
    </div>
</div>

<div class="modal fade" id="paymentModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header" style="background:#006A46; color:white;">
                <h5 class="modal-title">Capture Payment</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <form method="post" asp-page-handler="CapturePayment">
                <div class="modal-body">

                    <!-- Hidden Invoice ID -->
                    <input type="hidden" id="InvoiceIdField" name="InvoiceId" />

                    <!-- Hidden Invoice Balance (for client validation) -->
                    <input type="hidden" id="InvoiceBalanceField" name="InvoiceBalance" />

                    <div class="row">

                        <!-- LEFT COLUMN -->
                        <div class="col-md-6">

                            <div class="mb-3">
                                <label class="form-label fw-bold">Amount</label>
                                <input type="number" min="1" step="0.01"
                                       class="form-control"
                                       id="AmountField"
                                       name="Amount"
                                       required />
                                <small id="BalanceWarning" class="text-danger" style="display:none;">
                                    Payment cannot exceed invoice balance.
                                </small>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold">Payment Method</label>
                                <select class="form-select" name="PaymentMethodId" required>
                                    <option value="">-- Select Method --</option>

                                    @foreach (var pm in Model.PaymentMethods)
                                    {
                                        <option value="@pm.sys_paymentMethodId">
                                            @pm.sys_paymentMethodName
                                        </option>
                                    }
                                </select>
                            </div>

                        </div>

                        <!-- RIGHT COLUMN -->
                        <div class="col-md-6">

                            

                            <div class="mb-3">
                                <label class="form-label fw-bold">Remaining Balance</label>
                                <input class="form-control" id="BalanceField" readonly />
                            </div>

                        </div>
                    </div>

                </div>

                <div class="modal-footer">
                    <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button class="btn" id="SubmitPaymentBtn"
                            style="background:#006A46; color:white;">
                        Save Payment
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>


<script>
    const paymentModal = document.getElementById("paymentModal");

    paymentModal.addEventListener("show.bs.modal", function (event) {
        const button = event.relatedTarget;

        const invoiceId = button.getAttribute("data-invoice");
        const balance = button.getAttribute("data-balance");

        document.getElementById("InvoiceIdField").value = invoiceId;
        document.getElementById("InvoiceBalanceField").value = balance;
        document.getElementById("BalanceField").value = balance;
    });

    document.getElementById("AmountField")?.addEventListener("input", function () {
        const amount = parseFloat(this.value || 0);
        const balance = parseFloat(document.getElementById("InvoiceBalanceField").value);

        const warning = document.getElementById("BalanceWarning");
        const submitBtn = document.getElementById("SubmitPaymentBtn");

        if (amount > balance) {
            warning.style.display = "block";
            submitBtn.disabled = true;
        } 
        
        else {
            warning.style.display = "none";
            submitBtn.disabled = false;
        }
    });
</script>



<script src='https://cdnjs.cloudflare.com/ajax/libs/jquery/2.2.2/jquery.min.js'></script>

<script src="~/js/tableScript.js"></script>