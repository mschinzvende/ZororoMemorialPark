@page
@model ZororoMemorialPark.Pages.Finance.InvoicesListModel
@{
    ViewData["Title"] = "Invoices";
}

<div class="container-fluid py-4 mb-4">
    <div class="card shadow-sm mb-5">

        <div class="card-header d-flex justify-content-between align-items-center"
             style="background-color: var(--primary-green); color: var(--primary-white);">

            <div>
                <h5 class="mb-0">Invoices</h5>
                <small style="font-size:0.8rem;">Quickly view and capture payments for all invoices.</small>
            </div>

            <a asp-page="./CreateInvoice" class="btn btn-light btn-sm">
                + New Invoice
            </a>

        </div>

        <div class="card-body">

            @if (TempData["SuccessMessage"] != null)
            {

                <div class="alert alert-success">@TempData["SuccessMessage"]</div>
            }

            @if (TempData["ErrorMessage"] != null)
            {

                <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
            }

            <!-- FILTER BAR -->

            <div class="mb-3">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">

                    <div>

                        <ul class="nav nav-pills">

                            <li class="nav-item">
                                <a class="nav-link @(Model.TypeFilter=="All"?"active":"")"
                                   asp-route-TypeFilter="All"
                                   asp-route-StatusFilter="@Model.StatusFilter"
                                   asp-route-SearchTerm="@Model.SearchTerm">
                                    All
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link @(Model.TypeFilter=="ProductService"?"active":"")"
                                   asp-route-TypeFilter="ProductService"
                                   asp-route-StatusFilter="@Model.StatusFilter"
                                   asp-route-SearchTerm="@Model.SearchTerm">
                                    Products & Services
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link @(Model.TypeFilter=="Reservation"?"active":"")"
                                   asp-route-TypeFilter="Reservation"
                                   asp-route-StatusFilter="@Model.StatusFilter"
                                   asp-route-SearchTerm="@Model.SearchTerm">
                                    Grave Reservations
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link @(Model.TypeFilter=="GraveSale"?"active":"")"
                                   asp-route-TypeFilter="GraveSale"
                                   asp-route-StatusFilter="@Model.StatusFilter"
                                   asp-route-SearchTerm="@Model.SearchTerm">
                                    Grave Sales
                                </a>
                            </li>

                        </ul>

                    </div>

                    <div class="d-flex flex-wrap align-items-center gap-2">

                        <form method="get" class="d-flex gap-2">

                            <input type="hidden" name="TypeFilter" value="@Model.TypeFilter" />

                            <select name="StatusFilter"
                                    class="form-select form-select-sm"
                                    onchange="this.form.submit()">

                                <option value="All" selected="@(Model.StatusFilter=="All")">All Statuses</option>
                                <option value="Outstanding" selected="@(Model.StatusFilter=="Outstanding")">Outstanding</option>
                                <option value="Paid" selected="@(Model.StatusFilter=="Paid")">Fully Paid</option>

                            </select>

                        </form>

                        <form method="get">

                            <input type="hidden" name="TypeFilter" value="@Model.TypeFilter" />
                            <input type="hidden" name="StatusFilter" value="@Model.StatusFilter" />

                            <select name="PageSize"
                                    class="form-select form-select-sm"
                                    onchange="this.form.submit()">

                                <option value="10" selected="@(Model.PageSize==10)">Show 10</option>
                                <option value="15" selected="@(Model.PageSize==15)">15</option>
                                <option value="20" selected="@(Model.PageSize==20)">20</option>
                                <option value="50" selected="@(Model.PageSize==50)">50</option>
                                <option value="100" selected="@(Model.PageSize==100)">100</option>

                            </select>

                        </form>

                        <form method="get">

                            <input type="hidden" name="TypeFilter" value="@Model.TypeFilter" />
                            <input type="hidden" name="StatusFilter" value="@Model.StatusFilter" />

                            <input type="text"
                                   name="SearchTerm"
                                   value="@Model.SearchTerm"
                                   placeholder="Search invoices..."
                                   class="form-control form-control-sm" />

                        </form>

                    </div>

                </div>
            </div>

            <div class="table-responsive">

                <table class="table table-striped table-sm">

                    <thead>

                        <tr>
                            <th>Invoice #</th>
                            <th>Date</th>
                            <th>Customer</th>
                            <th>Type</th>
                            <th>Grave</th>
                            <th class="text-end">Total</th>
                            <th class="text-end">Paid</th>
                            <th class="text-end">Balance</th>
                            <th class="text-end">Actions</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var inv in Model.Invoices)
                        {

                            <tr>

                                <td>
                                    <a asp-page="./InvoiceDetail"
                                       asp-route-id="@inv.sys_invoiceId"
                                       class="text-decoration-none fw-semibold">
                                        @inv.sys_invoiceId
                                    </a>
                                </td>

                                <td>@inv.sys_invoiceDate.ToString("yyyy-MM-dd")</td>

                                <td>@inv.CustomerName</td>

                                <td>

                                    @if (inv.InvoiceType == "ProductService")
                                    {
                                        <span class="badge bg-primary">Products/Services</span>
                                    }
                                    else if (inv.InvoiceType == "GraveSale")
                                    {
                                        <span class="badge bg-success">Grave Sale</span>
                                    }
                                    else if (inv.InvoiceType == "Reservation")
                                    {
                                        <span class="badge bg-info text-dark">Reservation</span>
                                    }

                                </td>

                                <td>

                                    @if (inv.GraveId.HasValue)
                                    {
                                        <a asp-page="/Graves/GraveDetails"
                                             asp-route-id="@inv.GraveId"
                                             class="text-decoration-none">
                                            Grave @inv.GraveId
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">N/A</span>
                                    }

                                </td>

                                <td class="text-end">$@inv.TotalAmount.ToString("N2")</td>
                                <td class="text-end">$@inv.PaidAmount.ToString("N2")</td>

                                <td class="text-end">
                                    <span class="badge @(inv.Balance<=0?"bg-success":"bg-warning text-dark")">
                                        $@inv.Balance.ToString("N2")
                                    </span>
                                </td>

                                <td class="text-end">

                                    <div class="btn-group btn-group-sm">

                                        <a asp-page="./InvoiceDetail"
                                           asp-route-id="@inv.sys_invoiceId"
                                           class="btn btn-outline-primary">
                                            View
                                        </a>

                                        @if (inv.Balance > 0 && inv.InvoiceType != "GraveSale")
                                        {
                                            <button class="btn btn-success"
                                                      data-bs-toggle="modal"
                                                      data-bs-target="#paymentModal"
                                                      data-invoice="@inv.sys_invoiceId"
                                                      data-balance="@inv.Balance">
                                                Capture
                                            </button>
                                        }

                                    </div>

                                </td>

                            </tr>

                        }

                    </tbody>

                </table>

            </div>

            <nav>

                <ul class="pagination pagination-sm">

                    @if (Model.PageNumber > 1)
                    {

                        <li class="page-item">
                            <a class="page-link"
                               asp-route-PageNumber="@(Model.PageNumber-1)"
                               asp-route-SearchTerm="@Model.SearchTerm"
                               asp-route-TypeFilter="@Model.TypeFilter"
                               asp-route-StatusFilter="@Model.StatusFilter"
                               asp-route-PageSize="@Model.PageSize">
                                Previous
                            </a>
                        </li>
                    }

                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {

                        <li class="page-item @(Model.PageNumber==i?"active":"")">

                            <a class="page-link"
                               asp-route-PageNumber="@i"
                               asp-route-SearchTerm="@Model.SearchTerm"
                               asp-route-TypeFilter="@Model.TypeFilter"
                               asp-route-StatusFilter="@Model.StatusFilter"
                               asp-route-PageSize="@Model.PageSize">

                                @i

                            </a>

                        </li>
                    }

                    @if (Model.PageNumber < Model.TotalPages)
                    {

                        <li class="page-item">
                            <a class="page-link"
                               asp-route-PageNumber="@(Model.PageNumber+1)"
                               asp-route-SearchTerm="@Model.SearchTerm"
                               asp-route-TypeFilter="@Model.TypeFilter"
                               asp-route-StatusFilter="@Model.StatusFilter"
                               asp-route-PageSize="@Model.PageSize">
                                Next
                            </a>
                        </li>
                    }

                </ul>

            </nav>

        </div>
    </div>
</div>

<div class="modal fade" id="paymentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header" style="background:#006A46; color:white;">
                <h5 class="modal-title">
                    Capture Payment
                    <small class="d-block fw-normal" style="font-size:0.8rem;">
                        Record a payment against this invoice.
                    </small>
                </h5>
                <button class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <form method="post" asp-page-handler="CapturePayment">

                <div class="modal-body">

                    <input type="hidden" id="InvoiceIdField" name="InvoiceId" />
                    <input type="hidden" id="InvoiceBalanceField" name="InvoiceBalance" />

                    <div class="row">

                        <div class="col-md-6">

                            <div class="mb-3">
                                <label class="form-label fw-bold">Amount</label>

                                <input type="number"
                                       min="1"
                                       step="0.01"
                                       class="form-control"
                                       id="AmountField"
                                       name="Amount"
                                       required />

                                <small id="BalanceWarning"
                                       class="text-danger"
                                       style="display:none;">
                                    Payment cannot exceed invoice balance.
                                </small>

                            </div>

                            <div class="mb-3">

                                <label class="form-label fw-bold">Payment Method</label>

                                <select class="form-select"
                                        name="PaymentMethodId"
                                        required>

                                    <option value="">-- Select Method --</option>

                                    @foreach (var pm in Model.PaymentMethods)
                                    {
                                        <option value="@pm.sys_paymentMethodId">
                                            @pm.sys_paymentMethodName
                                        </option>
                                    }

                                </select>

                            </div>

                        </div>


                        <div class="col-md-6">

                            <div class="mb-3">
                                <label class="form-label fw-bold">Remaining Balance</label>

                                <input class="form-control"
                                       id="BalanceField"
                                       readonly />

                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold">Notes (optional)</label>

<textarea class="form-control"
          name="Notes"
          rows="3"
          placeholder="Add payment notes..."></textarea>

                            </div>

                        </div>

                    </div>

                </div>

                <div class="modal-footer">

                    <button class="btn btn-secondary"
                            type="button"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button class="btn"
                            id="SubmitPaymentBtn"
                            style="background:#006A46; color:white;"
                            type="submit">
                        Save Payment
                    </button>

                </div>

            </form>

        </div>
    </div>
</div>

<script>

    const paymentModal = document.getElementById("paymentModal");

    if (paymentModal) {

    paymentModal.addEventListener("show.bs.modal", function (event) {

    const button = event.relatedTarget;

    const invoiceId = button.getAttribute("data-invoice");
    const balance = button.getAttribute("data-balance");

    document.getElementById("InvoiceIdField").value = invoiceId;
    document.getElementById("InvoiceBalanceField").value = balance;
    document.getElementById("BalanceField").value = parseFloat(balance).toFixed(2);

    document.getElementById("AmountField").value = "";

    document.getElementById("BalanceWarning").style.display = "none";
    document.getElementById("SubmitPaymentBtn").disabled = false;

    });

    }

    document.getElementById("AmountField")?.addEventListener("input", function () {

    const amount = parseFloat(this.value || 0);
    const balance = parseFloat(document.getElementById("InvoiceBalanceField").value || 0);

    const warning = document.getElementById("BalanceWarning");
    const submitBtn = document.getElementById("SubmitPaymentBtn");

    if (amount > balance) {

    warning.style.display = "block";
    submitBtn.disabled = true;

    }
    else {

    warning.style.display = "none";
    submitBtn.disabled = false;

    }

    });

</script>