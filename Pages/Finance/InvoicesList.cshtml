@page
@model ZororoMemorialPark.Pages.Finance.InvoicesListModel
@{
    ViewData["Title"] = "Invoices";
}
<div class="container-fluid py-4 mb-4">
<div class="card shadow-sm mb-5">
    <div class="card-header d-flex justify-content-between align-items-center"
         style="background-color: var(--primary-green); color: var(--primary-white);">
        <div>
            <h5 class="mb-0">Invoices</h5>
            <small class="d-block" style="font-size: 0.8rem;">
                Quickly view and capture payments for all invoices.
            </small>
        </div>

        <div class="d-flex gap-2">
            <a asp-page="./CreateInvoice" class="btn btn-light btn-sm">
                + New Invoice
            </a>

        </div>
    </div>

    <div class="card-body">

        @* Alerts *@
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @* FILTER BAR *@
        <div class="mb-3">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">

                <div>
                    <ul class="nav nav-pills">
                        <li class="nav-item">
                            <a class="nav-link @(Model.TypeFilter == "All" ? "active" : "")"
                               asp-page="./InvoicesList"
                               asp-route-TypeFilter="All"
                               asp-route-StatusFilter="@Model.StatusFilter">
                                All
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(Model.TypeFilter == "ProductService" ? "active" : "")"
                               asp-page="./InvoicesList"
                               asp-route-TypeFilter="ProductService"
                               asp-route-StatusFilter="@Model.StatusFilter">
                                Products & Services
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(Model.TypeFilter == "Reservation" ? "active" : "")"
                               asp-page="./InvoicesList"
                               asp-route-TypeFilter="Reservation"
                               asp-route-StatusFilter="@Model.StatusFilter">
                                Grave Reservations
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(Model.TypeFilter == "GraveSale" ? "active" : "")"
                               asp-page="./InvoicesList"
                               asp-route-TypeFilter="GraveSale"
                               asp-route-StatusFilter="@Model.StatusFilter">
                                Grave Sales
                            </a>
                        </li>
                    </ul>
                </div>

                <div class="d-flex flex-wrap align-items-center gap-2">

                    <form method="get" class="d-flex flex-wrap align-items-center gap-2">
                        <input type="hidden" name="TypeFilter" value="@Model.TypeFilter" />

                        <select name="StatusFilter" class="form-select form-select-sm" onchange="this.form.submit()">

                            <option value="All"
                                    selected="@(Model.StatusFilter == "All")">
                                All Statuses
                            </option>

                            <option value="Outstanding"
                                    selected="@(Model.StatusFilter == "Outstanding")">
                                Outstanding
                            </option>

                            <option value="Paid"
                                    selected="@(Model.StatusFilter == "Paid")">
                                Fully Paid
                            </option>

                        </select>

                    </form>

                    <div class="form-group mb-0">
                        <select class="form-select form-select-sm" id="maxRows">
                            <option value="10">Show 10</option>
                            <option value="15">15</option>
                            <option value="20">20</option>
                            <option value="50">50</option>
                            <option value="70">70</option>
                            <option value="100">100</option>
                            <option value="5000">ALL</option>
                        </select>
                    </div>

                    <div>
                        <input type="text"
                               id="search_input_all"
                               onkeyup="FilterkeyWord_all_table()"
                               placeholder="Search invoices..."
                               class="form-control form-control-sm" />
                    </div>
                </div>
            </div>
        </div>

        @* INVOICES TABLE *@
        <div class="table-responsive">
            <table class="table table-striped table-class table-sm">
                <thead class="thead-light">
                    <tr>
                        <th>Invoice #</th>
                        <th>Date</th>
                        <th>Customer</th>
                        <th>Type</th>
                        <th>Grave</th>
                        <th class="text-end">Total</th>
                        <th class="text-end">Paid</th>
                        <th class="text-end">Balance</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var inv in Model.Invoices)
                    {
                        <tr>
                            <td>
                                <a asp-page="./InvoiceDetail"
                                   asp-route-id="@inv.sys_invoiceId"
                                   class="text-decoration-none fw-semibold">
                                    @inv.sys_invoiceId
                                </a>
                            </td>
                            <td>@inv.sys_invoiceDate.ToString("yyyy-MM-dd")</td>
                            <td>@inv.CustomerName</td>
                            <td>
                                @if (inv.InvoiceType == "ProductService")
                                {
                                    <span class="badge bg-primary">Products/Services</span>
                                }
                                else if (inv.InvoiceType == "GraveSale")
                                {
                                    <span class="badge bg-success">Grave Sale</span>
                                }
                                else if (inv.InvoiceType == "Reservation")
                                {
                                    <span class="badge bg-info text-dark">Grave Reservation</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Other</span>
                                }
                            </td>
                            <td>
                                @if ((inv.InvoiceType == "GraveSale" || inv.InvoiceType == "Reservation") && inv.GraveId.HasValue)
                                {
                                    @* TODO: adjust asp-page/route to match your grave details page *@
                                    <a asp-page="/Graves/GraveDetails"
                                       asp-route-id="@inv.GraveId.Value"
                                       class="text-decoration-none">
                                        Grave @inv.GraveId
                                    </a>
                                }
                                else if (inv.InvoiceType == "GraveSale" || inv.InvoiceType == "Reservation")
                                {
                                    <span class="text-muted">Not linked</span>
                                }
                                else
                                {
                                    <span class="text-muted">N/A</span>
                                }
                            </td>
                            <td class="text-end">$@inv.TotalAmount.ToString("N2")</td>
                            <td class="text-end">$@inv.PaidAmount.ToString("N2")</td>
                            <td class="text-end">
                                <span class="badge @(inv.Balance <= 0 ? "bg-success" : "bg-warning text-dark")">
                                    $@inv.Balance.ToString("N2")
                                </span>
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm" role="group">
                                    <a asp-page="./InvoiceDetail"
                                       asp-route-id="@inv.sys_invoiceId"
                                       class="btn btn-outline-primary">
                                        View
                                    </a>

                                    @if (inv.Balance > 0)
                                    {
                                        <button class="btn btn-success"
                                                type="button"
                                                data-bs-toggle="modal"
                                                data-bs-target="#paymentModal"
                                                data-invoice="@inv.sys_invoiceId"
                                                data-balance="@inv.Balance">
                                            Capture
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>

                        @* Expanded payments (if needed) *@
                        if (Model.ExpandedId.HasValue && Model.ExpandedId.Value == inv.sys_invoiceId)
                        {
                            <tr>
                                <td colspan="9" class="bg-light">
                                    <strong>Payments</strong>
                                    @if (inv.Payments.Any())
                                    {
                                        <table class="table table-sm mt-2 mb-0">
                                            <thead>
                                                <tr>
                                                    <th>Date</th>
                                                    <th>Amount</th>
                                                    <th>Method</th>
                                                    <th>Receipt</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var p in inv.Payments)
                                                {
                                                    <tr>
                                                        <td>@p.sys_date.ToString("yyyy-MM-dd")</td>
                                                        <td>$@p.sys_amount.ToString("N2")</td>
                                                        <td>@p.sys_paymentMethod</td>
                                                        <td>@p.sys_receiptNumber</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    }
                                    else
                                    {
                                        <div class="text-muted mt-2">No payments recorded.</div>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        <div class="d-flex justify-content-between align-items-center mt-3">
            <div class="rows_count small text-muted">
                <!-- tableScript.js will update this text -->
                Showing entries
            </div>
            <div class="pagination-container mb-0">
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <!-- tableScript.js will inject pagination -->
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</div>
</div>

@* CAPTURE PAYMENT MODAL *@
<div class="modal fade" id="paymentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header" style="background:#006A46; color:white;">
                <h5 class="modal-title">
                    Capture Payment
                    <small class="d-block fw-normal" style="font-size: 0.8rem;">
                        Record a payment against this invoice.
                    </small>
                </h5>
                <button class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form method="post" asp-page-handler="CapturePayment">
                <div class="modal-body">

                    <input type="hidden" id="InvoiceIdField" name="InvoiceId" />
                    <input type="hidden" id="InvoiceBalanceField" name="InvoiceBalance" />

                    <div class="row">

                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label fw-bold">Amount</label>
                                <input type="number"
                                       min="1"
                                       step="0.01"
                                       class="form-control"
                                       id="AmountField"
                                       name="Amount"
                                       required />
                                <small id="BalanceWarning"
                                       class="text-danger"
                                       style="display:none;">
                                    Payment cannot exceed invoice balance.
                                </small>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold">Payment Method</label>
                                <select class="form-select" name="PaymentMethodId" required>
                                    <option value="">-- Select Method --</option>
                                    @foreach (var pm in Model.PaymentMethods)
                                    {
                                        <option value="@pm.sys_paymentMethodId">
                                            @pm.sys_paymentMethodName
                                        </option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label fw-bold">Remaining Balance</label>
                                <input class="form-control" id="BalanceField" readonly />
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold">Notes (optional)</label>
                                <textarea class="form-control" name="Notes" rows="3"
                                          placeholder="Add any payment notes..."></textarea>
                            </div>
                        </div>

                    </div>

                </div>

                <div class="modal-footer">
                    <button class="btn btn-secondary" type="button" data-bs-dismiss="modal">
                        Cancel
                    </button>
                    <button class="btn" id="SubmitPaymentBtn"
                            style="background:#006A46; color:white;" type="submit">
                        Save Payment
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const paymentModal = document.getElementById("paymentModal");

        if (paymentModal) {
            paymentModal.addEventListener("show.bs.modal", function (event) {
                const button = event.relatedTarget;

                const invoiceId = button.getAttribute("data-invoice");
                const balance = button.getAttribute("data-balance");

                document.getElementById("InvoiceIdField").value = invoiceId;
                document.getElementById("InvoiceBalanceField").value = balance;
                document.getElementById("BalanceField").value = parseFloat(balance).toFixed(2);
                const amountField = document.getElementById("AmountField");
                if (amountField) {
                    amountField.value = "";
                }

                const warning = document.getElementById("BalanceWarning");
                const submitBtn = document.getElementById("SubmitPaymentBtn");
                if (warning) warning.style.display = "none";
                if (submitBtn) submitBtn.disabled = false;
            });
        }

        document.getElementById("AmountField")?.addEventListener("input", function () {
            const amount = parseFloat(this.value || 0);
            const balance = parseFloat(document.getElementById("InvoiceBalanceField").value || 0);

            const warning = document.getElementById("BalanceWarning");
            const submitBtn = document.getElementById("SubmitPaymentBtn");

            if (amount > balance) {
                warning.style.display = "block";
                submitBtn.disabled = true;
            } else {
                warning.style.display = "none";
                submitBtn.disabled = false;
            }
        });
    </script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/2.2.2/jquery.min.js"></script>
    <script src="~/js/tableScript.js"></script>
}
