@page
@model ZororoMemorialPark.Pages.Finance.InvoicesListModel
@{
    ViewData["Title"] = "Invoices";
}

<div class="card shadow-sm">
    <div class="card-header d-flex justify-content-between align-items-center"
         style="background-color: var(--primary-green); color: var(--primary-white);">
        <h5 class="mb-0">Invoices</h5>
        <div>
            <a asp-page="./Create" class="btn btn-light btn-sm">+ New Invoice</a>
        </div>
    </div>

    <div class="card-body">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">@TempData["SuccessMessage"]</div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
        }

        <table class="table table-striped table-class table-sm" id="myTable">

            <thead class="thead-light">
                <tr>
                    <th>Invoice #</th>
                    <th>Date</th>
                    <th>Customer</th>
                    <th>Type</th>
                    <th class="text-end">Total</th>
                    <th class="text-end">Paid</th>
                    <th class="text-end">Balance</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var inv in Model.Invoices)
                {
                    var balance = inv.TotalAmount - inv.PaidAmount;
                    <tr>
                        <td>
                            <a asp-page="./InvoiceDetail" asp-route-expandedId="@inv.sys_invoiceId">@inv.sys_invoiceNumber</a>
                        </td>
                        <td>@inv.sys_invoiceDate.ToString("yyyy-MM-dd")</td>
                        <td>@inv.CustomerName</td>
                        <td>
                            @if (inv.InvoiceType == "ProductService")
                            {
                                <span class="badge bg-primary">Products/Services</span>
                            }
                            else if (inv.InvoiceType == "GraveSale")
                            {
                                <span class="badge bg-success">Grave Sale</span>
                            }
                            else
                            {
                                <span class="badge bg-info text-dark">Reservation</span>
                            }
                        </td>
                        <td class="text-end">$@inv.TotalAmount.ToString("N2")</td>
                        <td class="text-end">$@inv.PaidAmount.ToString("N2")</td>
                        <td class="text-end">
                            <span class="badge @(balance <= 0 ? "bg-success" : "bg-warning text-dark")">
                                $@balance.ToString("N2")
                            </span>
                        </td>
                        <td class="text-end">
                            <a asp-page="./InvoiceDetail" asp-route-id="@inv.sys_invoiceId" class="btn btn-sm btn-outline-primary">View</a>
                        </td>
                    </tr>

                    @* Expand payments if this invoice is selected *@
                    if (Model.ExpandedId.HasValue && Model.ExpandedId.Value == inv.sys_invoiceId)
                    {
                        <tr>
                            <td colspan="8" class="bg-light">
                                <strong>Payments</strong>
                                @if (inv.Payments.Any())
                                {
                                    <table class="table table-sm mt-2 mb-0">
                                        <thead>
                                            <tr>
                                                <th>Date</th>
                                                <th>Amount</th>
                                                <th>Method</th>
                                                <th>Receipt</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var p in inv.Payments)
                                            {
                                                <tr>
                                                    <td>@p.sys_date.ToString("yyyy-MM-dd")</td>
                                                    <td>$@p.sys_amount.ToString("N2")</td>
                                                    <td>@p.sys_paymentMethod</td>
                                                    <td>@p.sys_receiptNumber</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                }
                                else
                                {
                                    <div class="text-muted mt-2">No payments recorded</div>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
