@page
@model ZororoMemorialPark.Pages.Finance.ReceiptBooksModel
@{
    ViewData["Title"] = "Receipt Books Management";
}

<div class="row">
    <div class="col-lg-12 mx-auto">
        <div class="card shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center"
                 style="background-color: var(--primary-green); color: var(--primary-white);">
                <h5 class="mb-0">Receipt Books Management</h5>
                <div>
                    <button class="btn btn-sm btn-light me-2" data-bs-toggle="modal" data-bs-target="#createModal">
                        <i class="bi bi-plus-circle"></i> + Add Receipt Book
                    </button>
                </div>
            </div>

            <div class="card-body">
    

    <!-- Alerts -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

   

    <table class="table table-striped">
        <thead class="table-dark">
            <tr>
                <th>Agent</th>
                <th>Book Number</th>
                <th>Range</th>
                <th>Current</th>
                <th>Status</th>
                <th>Remaining</th>
                <th>Issued</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var book in Model.ReceiptBooks)
            {
                var total = book.sys_endNumber - book.sys_startNumber + 1;
                var used = book.sys_currentNumber - book.sys_startNumber + 1;
                var remaining = total - used;
                var percent = (double)used / total * 100;

                <tr>
                    <td>@book.Agent.sys_agentName</td>
                    <td>@book.sys_bookNumber</td>
                    <td>@book.sys_startNumber - @book.sys_endNumber</td>
                    <td>@book.sys_currentNumber</td>
                    <td>
                        @if (book.sys_isClosed)
                        {
                            <span class="badge bg-secondary">Closed</span>
                        }
                        else
                        {
                            <span class="badge bg-success">Active</span>
                        }
                    </td>
                    <td>
                        <div class="progress" style="height: 20px;">
                            <div class="progress-bar bg-info" role="progressbar"
                                 style="width:@percent%" aria-valuenow="@used"
                                 aria-valuemin="0" aria-valuemax="@total">
                                @remaining left
                            </div>
                        </div>
                    </td>
                    <td>@book.sys_issueDate.ToShortDateString()</td>
                    <td>
                        <button class="btn btn-sm btn-warning editBtn"
                                data-id="@book.sys_receiptBookId"
                                data-book="@book.sys_bookNumber"
                                data-start="@book.sys_startNumber"
                                data-end="@book.sys_endNumber"
                                data-current="@book.sys_currentNumber"
                                data-agent="@book.sys_agentId"
                                data-closed="@book.sys_isClosed"
                                data-bs-toggle="modal"
                                data-bs-target="#editModal">
                            Edit
                        </button>

                        <button class="btn btn-sm btn-danger"
                                data-id="@book.sys_receiptBookId"
                                data-bs-toggle="modal"
                                data-bs-target="#deleteModal">
                            Delete
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
</div>
</div>
</div>


<!-- Create Modal -->
<div class="modal fade" id="createModal" tabindex="-1">
    <div class="modal-dialog">
        <form method="post" asp-page-handler="Create">
            <div class="modal-content">
                <div class="modal-header" style="background-color: var(--primary-green); color: var(--primary-white);">
                    <h5 class="modal-title">Add Receipt Book</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-2">
                        <label>Agent</label>
                        <select name="sys_agentId" class="form-select">
                            @foreach (var a in Model.Agents)
                            {
                                <option value="@a.sys_agentId">@a.sys_agentName</option>
                            }
                        </select>
                    </div>
                    <div class="mb-2">
                        <label>Book Number</label>
                        <input type="text" name="sys_bookNumber" class="form-control" required />
                    </div>
                    <div class="mb-2">
                        <label>Start Number</label>
                        <input type="number" name="sys_startNumber" class="form-control" required />
                    </div>
                    <div class="mb-2">
                        <label>End Number</label>
                        <input type="number" name="sys_endNumber" class="form-control" required />
                    </div>
                    <div class="mb-2">
                        <label>Issue Date</label>
                        <input type="date" name="sys_issueDate" class="form-control" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-success">Save</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Edit Modal -->
<div class="modal fade" id="editModal" tabindex="-1">
    <div class="modal-dialog">
        <form method="post" asp-page-handler="Edit">
            <input type="hidden" id="editId" name="sys_receiptBookId" />
            <div class="modal-content">
                <div class="modal-header" style="background-color: var(--primary-green); color: var(--primary-white);">
                    <h5 class="modal-title">Edit Receipt Book</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-2">
                        <label>Book Number</label>
                        <input type="text" id="editBookNumber" name="sys_bookNumber" class="form-control" required />
                    </div>
                    <div class="mb-2">
                        <label>Start Number</label>
                        <input type="number" id="editStart" name="sys_startNumber" class="form-control" required />
                    </div>
                    <div class="mb-2">
                        <label>End Number</label>
                        <input type="number" id="editEnd" name="sys_endNumber" class="form-control" required />
                    </div>
                    <div class="mb-2">
                        <label>Current Number</label>
                        <input type="number" id="editCurrent" name="sys_currentNumber" class="form-control" readonly />
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-success">Update</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <form method="post" asp-page-handler="Delete">
            <input type="hidden" id="deleteId" name="sys_receiptBookId" />
            <div class="modal-content">
                <div class="modal-header" style="background-color: var(--primary-green); color: var(--primary-white);">
                    <h5 class="modal-title">Delete Receipt Book</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to delete this receipt book?</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-danger">Delete</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll(".editBtn").forEach(btn => {
            btn.addEventListener("click", function () {
                document.getElementById("editId").value = this.dataset.id;
                document.getElementById("editBookNumber").value = this.dataset.book;
                document.getElementById("editStart").value = this.dataset.start;
                document.getElementById("editEnd").value = this.dataset.end;
                document.getElementById("editCurrent").value = this.dataset.current;
            });
        });

        document.querySelectorAll("[data-bs-target='#deleteModal']").forEach(btn => {
            btn.addEventListener("click", function () {
                document.getElementById("deleteId").value = this.dataset.id;
            });
        });
    </script>
}
