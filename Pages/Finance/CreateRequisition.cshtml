@page
@model ZororoMemorialPark.Pages.Finance.CreateRequisitionModel
@{
    ViewData["Title"] = "New Requisition";
}

<div class="card shadow-sm mb-4">
    <div class="card-header" style="background-color: var(--primary-green); color: var(--primary-white);">
        <h5 class="mb-0">New Requisition</h5>
    </div>

    <div class="card-body">
        <form method="post" enctype="multipart/form-data">

            <div class="row">
                <div class="col-md-8">
                    <div class="mb-3">
                        <label asp-for="Input.Title" class="form-label fw-bold"></label>
                        <input asp-for="Input.Title" class="form-control" />
                        <span asp-validation-for="Input.Title" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Description" class="form-label fw-bold"></label>
                        <textarea asp-for="Input.Description" class="form-control" rows="4"></textarea>
                        <span asp-validation-for="Input.Description" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Attachment (optional)</label>
                        <input type="file" asp-for="Attachment" class="form-control" />
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="border rounded p-3 bg-light mb-3">
                        <h6 class="fw-bold">Approvers</h6>

                        <div class="mb-2">
                            <label class="form-label fw-bold">Reviewer (required)</label>
                            <select asp-for="Approver1UserId"
                                    asp-items="Model.RequisitionReviewerOptions"
                                    class="form-select form-select-sm" required>
                                <option value="">-- Select Reviewer --</option>
                            </select>
                            <span asp-validation-for="Approver1UserId" class="text-danger"></span>
                        </div>

                        <div class="mb-2">
                            <label class="form-label fw-bold">Approver (required)</label>
                            <select asp-for="Approver2UserId"
                                    asp-items="Model.RequisitionApproverOptions"
                                    class="form-select form-select-sm" required>
                                <option value="">-- Select Approver --</option>
                            </select>
                        </div>

                        
                    </div>
                </div>
            </div>

            <hr />

            <h6 class="fw-bold mb-2">Items</h6>
            <div class="table-responsive mb-2">
                <table class="table table-striped table-class table-sm">
                    <thead class="thead-light">
                        <tr>
                            <th style="width:40%;">Item</th>
                            <th style="width:15%;">Qty</th>
                            <th style="width:20%;">Cost / Unit</th>
                            <th style="width:20%;">Total</th>
                            <th style="width:5%;"></th>
                        </tr>
                    </thead>
                    <tbody id="itemsBody">
                        @{
                            var index = 0;
                            foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td>
                                        <input name="Items[@index].ItemName"
                                               value="@item.ItemName"
                                               class="form-control form-control-sm item-name"
                                               required />
                                    </td>
                                    <td>
                                        <input name="Items[@index].Quantity"
                                               value="@item.Quantity"
                                               type="number"
                                               min="1"
                                               class="form-control form-control-sm item-qty"
                                               required />
                                    </td>
                                    <td>
                                        <input name="Items[@index].CostPerUnit"
                                               value="@item.CostPerUnit"
                                               type="number"
                                               step="0.01"
                                               min="0.01"
                                               class="form-control form-control-sm item-cost"
                                               required />
                                    </td>
                                    <td>
                                        <input type="text"
                                               class="form-control form-control-sm item-total"
                                               readonly />
                                    </td>
                                    <td class="text-center">
                                        <button type="button"
                                                class="btn btn-sm btn-outline-danger"
                                                onclick="removeItemRow(this)">
                                            &times;
                                        </button>
                                    </td>
                                </tr>
                                index++;
                            }
                        }
                    </tbody>
                </table>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-3">
                <button type="button"
                        class="btn btn-sm btn-outline-secondary"
                        onclick="addItemRow()">
                    + Add Item
                </button>

                <div class="fw-bold">
                    Total: $<span id="grandTotal">0.00</span>
                </div>
            </div>

            <div class="d-flex justify-content-between">
                <a asp-page="./Index" class="btn btn-secondary">Back to List</a>
                <button type="submit" class="btn" style="background:#006A46;color:white;">
                    Submit Requisition
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        let itemIndex = @Model.Items.Count;

        function addItemRow() {
            const tbody = document.getElementById('itemsBody');
            const row = document.createElement('tr');

            row.innerHTML = `
                <td>
                    <input name="Items[${itemIndex}].ItemName"
                           class="form-control form-control-sm item-name"
                           required />
                </td>
                <td>
                    <input name="Items[${itemIndex}].Quantity"
                           type="number"
                           min="1"
                           value="1"
                           class="form-control form-control-sm item-qty"
                           required />
                </td>
                <td>
                    <input name="Items[${itemIndex}].CostPerUnit"
                           type="number"
                           step="0.01"
                           min="0.01"
                           value="0.00"
                           class="form-control form-control-sm item-cost"
                           required />
                </td>
                <td>
                    <input type="text"
                           class="form-control form-control-sm item-total"
                           readonly />
                </td>
                <td class="text-center">
                    <button type="button"
                            class="btn btn-sm btn-outline-danger"
                            onclick="removeItemRow(this)">
                        &times;
                    </button>
                </td>
            `;

            tbody.appendChild(row);
            itemIndex++;
            recalcTotals();
        }

        function removeItemRow(btn) {
            const row = btn.closest('tr');
            row.remove();
            recalcTotals();
        }

        function recalcTotals() {
            let grand = 0;
            document.querySelectorAll('#itemsBody tr').forEach(tr => {
                const qty = parseFloat(tr.querySelector('.item-qty')?.value || 0);
                const cost = parseFloat(tr.querySelector('.item-cost')?.value || 0);
                const total = qty * cost;

                const totalInput = tr.querySelector('.item-total');
                if (totalInput) {
                    totalInput.value = total.toFixed(2);
                }

                grand += total;
            });

            document.getElementById('grandTotal').innerText = grand.toFixed(2);
        }

        document.addEventListener('input', function (e) {
            if (e.target.classList.contains('item-qty') ||
                e.target.classList.contains('item-cost')) {
                recalcTotals();
            }
        });

        window.addEventListener('load', recalcTotals);
    </script>
}
