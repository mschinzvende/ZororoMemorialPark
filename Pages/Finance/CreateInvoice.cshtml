@page
@model CreateInvoiceModel
@{
    ViewData["Title"] = "Create Invoice";
}


<div class="container-fluid py-4 mb-4">
<div class="card shadow-sm mb-5">
    <div class="card-header bg-success text-white">
        <h5>Create Invoice</h5>
    </div>
    <div class="card-body">

        <!-- CUSTOMER SELECTION -->
        <div class="row">
            <div class="col-sm-3">
                <div class="mb-3">
                    <label class="form-label">Customer Name</label>
                    <div class="d-flex gap-2">
                        <input type="text" id="customerName" name="customerName" class="form-control" required />

                    </div>
                </div>
            </div>
            <div class="col-sm-3">
                <div class="mb-3">
                    <label class="form-label">Customer Phone (263...)</label>
                    <div class="d-flex gap-2">
                        <input type="text" id="customerPhone" name="customerPhone" class="form-control" required />

                    </div>
                </div>
            </div>
        </div>
        


        <!-- ITEMS PICKER (TOP 3 ROWS) -->
        <div class="row">
            <div class="col-md-4">
                <label class="form-label">Sellable Products</label>
                <select id="productSelect" class="form-select">
                    <option value="">-- Select Product --</option>
                    @foreach (var p in Model.Products)
                    {
                        <option value="@p.sys_itemId" data-price="@p.sys_sellingPrice">
                            @p.sys_itemName
                        </option>
                    }
                </select>
            </div>

            <div class="col-md-4">
                <label class="form-label">Services</label>
                <select id="serviceSelect" class="form-select">
                    <option value="">-- Select Service --</option>
                    @foreach (var s in Model.Services)
                    {
                        <option value="@s.sys_itemId" data-price="@s.sys_sellingPrice">
                            @s.sys_itemName - $@s.sys_sellingPrice
                        </option>
                    }
                </select>
            </div>

            <div class="col-md-4">
                <label class="form-label">Tombstones</label>
                <select id="tombstoneSelect" class="form-select">
                    <option value="">-- Select Tombstone --</option>
                    @foreach (var t in Model.Tombstones)
                    {
                        <option value="@t.sys_tombstoneId" data-price="@t.sys_price" data-type="tombstone">
                            @t.sys_tombstoneName - $@t.sys_price
                        </option>
                    }
                </select>
            </div>
        </div>


        <!-- INVOICE ITEMS TABLE -->
        <div class="mt-4">
            <h5>Invoice Items</h5>
            <table class="table table-striped table-class table-sm" id="invoiceItemsTable">

                <thead class="thead-light">
                    <tr>
                        <th>Item</th>
                        <th width="100">Price</th>
                        <th width="100">Qty</th>
                        <th width="100">Discount</th>
                        <th></th>
                        <th width="120">Total</th>
                        <th width="50"></th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>


        <!-- TOTALS -->
        <div class="text-end mt-3">
            <h6>Subtotal: $<span id="subtotal">0.00</span></h6>
            <!--<h6>VAT (15%): $<span id="vat">0.00</span></h6>-->
            <h4>Total: $<span id="grandTotal">0.00</span></h4>
        </div>

        <button class="btn btn-success mt-4" type="submit" form="invoiceForm">Save Invoice</button>
    </div>
</div>
</div>

<!-- HIDDEN FORM FOR SUBMISSION -->
<form method="post" id="invoiceForm">
    <input type="hidden" name="customerName" id="hiddenCustomerName" />
    <input type="hidden" name="customerPhone" id="hiddenCustomerPhone" />
    <div id="invoiceItemsContainer"></div>
</form>


<!-- CREATE CUSTOMER MODAL -->
<div class="modal fade" id="createCustomerModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5>Add Customer</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <label>Name</label>
                <input id="newCustomerName" class="form-control" />

                <label class="mt-2">Phone</label>
                <input id="newCustomerPhone" class="form-control" />

                <label class="mt-2">Email</label>
                <input id="newCustomerEmail" class="form-control" />
            </div>

            <div class="modal-footer">
                <button type="button" id="saveCustomerBtn" class="btn btn-success">Save</button>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        // ------------------------------------------
        // ADD ITEMS TO INVOICE TABLE
        // ------------------------------------------

        function addItem(id, name, price, type) {
            const table = document.querySelector("#invoiceItemsTable tbody");

            // Prevent duplicates
            if (document.getElementById("row_" + type + "_" + id)) {
                alert("Item already added.");
                return;
            }

                   const row = `
            <tr id="row_${type}_${id}">
                <td>${name}</td>
                
                <td>$${price}</td>
                <td><input type="number" class="form-control qty-input" value="1" min="1" data-price="${price}" /></td>
                <td><input type="number" class="form-control discount-input" value="0" min="0" data-price="${price}" /></td>
                <td><input type="hidden" class="form-control type-input" value="${type}"</td>
                <td class="line-total">$${price}</td>
                <td><button type="button" class="btn btn-danger btn-sm remove-item">&times;</button></td>

            </tr>
        `;


            table.insertAdjacentHTML("beforeend", row);
            updateTotals();
            updateHiddenForm();
        }

        document.getElementById("productSelect").addEventListener("change", function () {
            const opt = this.selectedOptions[0];
            addItem(opt.value, opt.text, opt.dataset.price, "product");
            this.value = "";
        });

        document.getElementById("serviceSelect").addEventListener("change", function () {
            const opt = this.selectedOptions[0];
            addItem(opt.value, opt.text, opt.dataset.price, "service");
            this.value = "";
        });

        document.getElementById("tombstoneSelect").addEventListener("change", function () {
            const opt = this.selectedOptions[0];
            addItem(opt.value, opt.text, opt.dataset.price, "tombstone");
            this.value = "";
        });

        // Update totals when qty changes
        document.addEventListener("input", function (e) {
            if (e.target.classList.contains("qty-input")) {
                const qty = e.target.value;
                const price = e.target.dataset.price;

                const row = e.target.closest("tr");
                row.querySelector(".line-total").innerText = "$" + (qty * price);

                updateTotals();
                updateHiddenForm();
            }


            if (e.target.classList.contains("discount-input")) {
                const row = e.target.closest("tr");
                const qty = row.querySelector(".qty-input").value;
                const price = e.target.dataset.price;
                const discount = e.target.value || 0;

                const lineTotal = (qty * price) - Number(discount);
                row.querySelector(".line-total").innerText = "$" + lineTotal.toFixed(2);

                updateTotals();
                updateHiddenForm();
            }
        });

        // Remove item
        document.addEventListener("click", function (e) {
            if (e.target.classList.contains("remove-item")) {
                e.target.closest("tr").remove();
                updateTotals();
                updateHiddenForm();
            }
        });

        // Calculate totals
        function updateTotals() {
            let subtotal = 0;

            document.querySelectorAll(".line-total").forEach(x => {
                subtotal += Number(x.innerText.replace("$", ""));
            });

            //let vat = subtotal * 0.15;
            let total = subtotal;

            document.getElementById("subtotal").innerText = subtotal.toFixed(2);
            //document.getElementById("vat").innerText = vat.toFixed(2);
            document.getElementById("grandTotal").innerText = total.toFixed(2);
        }


        // Prepare form for backend
        function updateHiddenForm() {
            const container = document.getElementById("invoiceItemsContainer");
            container.innerHTML = "";
            document.getElementById("hiddenCustomerName").value = document.getElementById("customerName").value;
            document.getElementById("hiddenCustomerPhone").value = document.getElementById("customerPhone").value;

            document.querySelectorAll("#invoiceItemsTable tbody tr").forEach((row, index) => {
                const cols = row.children;
                const itemName = cols[0].innerText;
                const price = cols[1].innerText.replace("$", "");
                const qty = cols[2].querySelector(".qty-input").value;
                const discount = cols[3].querySelector(".discount-input").value;
                const itemType = cols[4].querySelector(".type-input").value;


                container.insertAdjacentHTML("beforeend", `
                    <input type="hidden" name="Items[${index}].Name" value="${itemName}" />
                    <input type="hidden" name="Items[${index}].Price" value="${price}" />
                    <input type="hidden" name="Items[${index}].Qty" value="${qty}" />
                    <input type="hidden" name="Items[${index}].Discount" value="${discount}" />
                    <input type="hidden" name="Items[${index}].Type" value="${itemType}" />
                `);
            });
        }
    </script>
}
