@page
@model ZororoMemorialPark.Pages.Finance.ExpenseCategoriesModel
@{
    ViewData["Title"] = "Expense Categories";
}

<style>
    .category-table { --bs-table-bg: #fff; --bs-table-color: #21362d; --bs-table-hover-bg: #f1f8f4; --bs-table-hover-color: #14251e; }
    .category-table td { background-color: #fff !important; color: #21362d !important; vertical-align: middle; }
    .category-table > thead.table-light { --bs-table-bg: #07553f; --bs-table-color: #fff; color: #fff; }
    .category-table > thead.table-light th { background-color: #07553f !important; border-color: #28745c; color: #fff !important; }
    .category-number { font-variant-numeric: tabular-nums; }
    .category-usage { border-radius: 999px; display: inline-block; font-size: .78rem; font-weight: 600; padding: .38rem .55rem; }
    .category-usage--used { background: #dff3e8 !important; color: #07553f !important; }
    .category-usage--unused { background: #e9edf0 !important; color: #43515a !important; }
</style>

<div class="container-fluid py-4 pb-5">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert"><i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert"><i class="bi bi-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }

    <section class="card shadow-sm border-0 mb-4">
        <div class="card-body p-4 d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3" style="background:linear-gradient(120deg,#07553f,#14835f); color:#fff; border-radius:.75rem;">
            <div><div class="text-uppercase small fw-semibold opacity-75 mb-1">Finance configuration</div><h1 class="h4 mb-1">Expense Categories</h1><p class="mb-0 opacity-75">Control the categories available when Finance captures an approved operating expense.</p></div>
            <a class="btn btn-outline-light" href="/Finance/Expenses"><i class="bi bi-arrow-left me-1"></i> Expense register</a>
        </div>
    </section>

    <div class="row g-4 align-items-start">
        <div class="col-xl-4">
            <section class="card shadow-sm border-0">
                <div class="card-header bg-white py-3"><h2 class="h6 mb-1">Add category</h2><p class="small text-muted mb-0">Use a short, clear label for financial reporting.</p></div>
                <div class="card-body">
                    <form method="post" asp-page-handler="Create" class="row g-3">
                        <div class="col-12"><label asp-for="NewCategory.Name" class="form-label">Category name</label><input asp-for="NewCategory.Name" class="form-control" maxlength="100" placeholder="e.g. Utilities" required /></div>
                        <div class="col-sm-6"><label asp-for="NewCategory.DisplayOrder" class="form-label">Display order</label><input asp-for="NewCategory.DisplayOrder" type="number" class="form-control" min="0" max="999" /></div>
                        <div class="col-12 d-grid"><button class="btn btn-success"><i class="bi bi-plus-circle me-1"></i> Add category</button></div>
                    </form>
                </div>
            </section>
            <div class="alert alert-light border mt-4 small mb-0"><i class="bi bi-shield-check text-success me-1"></i>Categories already used by an expense cannot be deleted. Renaming one updates its recorded operating expenses so reporting remains consistent.</div>
        </div>

        <div class="col-xl-8">
            <section class="card shadow-sm border-0">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center"><div><h2 class="h6 mb-1">Configured categories</h2><p class="small text-muted mb-0">@Model.Categories.Count available for new approved expenses.</p></div><span class="badge text-bg-light border">Manager control</span></div>
                <div class="card-body p-0">
                    @if (Model.Categories.Any())
                    {
                        <div class="table-responsive"><table class="table table-hover category-table mb-0"><thead class="table-light"><tr><th class="ps-4">Category</th><th>Order</th><th>Recorded expenses</th><th class="text-end">Total paid</th><th class="text-end pe-4">Actions</th></tr></thead><tbody>@foreach (var category in Model.Categories) { <tr><td class="ps-4 fw-semibold">@category.Name</td><td class="category-number">@category.DisplayOrder</td><td><span class="category-usage @(category.ExpenseCount > 0 ? "category-usage--used" : "category-usage--unused")">@category.ExpenseCount record@(category.ExpenseCount == 1 ? string.Empty : "s")</span></td><td class="text-end category-number">$@category.TotalPaid.ToString("N2")</td><td class="text-end pe-4"><button type="button" class="btn btn-sm btn-outline-primary edit-category-btn" data-bs-toggle="modal" data-bs-target="#editCategoryModal" data-id="@category.Id" data-name="@category.Name" data-order="@category.DisplayOrder"><i class="bi bi-pencil"></i><span class="visually-hidden">Edit @category.Name</span></button>@if (category.ExpenseCount == 0) { <form method="post" asp-page-handler="Delete" class="d-inline delete-category-form" data-category-name="@category.Name"><input type="hidden" name="categoryId" value="@category.Id" /><button type="submit" class="btn btn-sm btn-outline-danger ms-1"><i class="bi bi-trash"></i><span class="visually-hidden">Delete @category.Name</span></button></form> }</td></tr> }</tbody></table></div>
                    }
                    else
                    {
                        <div class="p-5 text-center text-muted"><i class="bi bi-tags fs-2 d-block mb-2"></i>No expense categories have been configured yet.</div>
                    }
                </div>
            </section>
        </div>
    </div>
</div>

<div class="modal fade" id="editCategoryModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog"><div class="modal-content"><form method="post" asp-page-handler="Update"><div class="modal-header text-white" style="background:#07553f;"><div><h2 class="modal-title h5 mb-0">Edit expense category</h2><small class="opacity-75">Renaming updates matching operating-expense records.</small></div><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button></div><div class="modal-body"><input asp-for="EditCategory.Id" type="hidden" /><div class="row g-3"><div class="col-12"><label asp-for="EditCategory.Name" class="form-label">Category name</label><input asp-for="EditCategory.Name" class="form-control" maxlength="100" required /></div><div class="col-sm-6"><label asp-for="EditCategory.DisplayOrder" class="form-label">Display order</label><input asp-for="EditCategory.DisplayOrder" type="number" class="form-control" min="0" max="999" /></div></div></div><div class="modal-footer"><button type="button" class="btn btn-light border" data-bs-dismiss="modal">Cancel</button><button class="btn btn-success"><i class="bi bi-check2-circle me-1"></i> Save changes</button></div></form></div></div></div>

@section Scripts {
    <script>
        document.querySelectorAll('.edit-category-btn').forEach(button => {
            button.addEventListener('click', () => {
                document.getElementById('EditCategory_Id').value = button.dataset.id;
                document.getElementById('EditCategory_Name').value = button.dataset.name;
                document.getElementById('EditCategory_DisplayOrder').value = button.dataset.order;
            });
        });

        document.querySelectorAll('.delete-category-form').forEach(form => {
            form.addEventListener('submit', event => {
                if (!confirm(`Delete ${form.dataset.categoryName}?`)) event.preventDefault();
            });
        });
    </script>
}
