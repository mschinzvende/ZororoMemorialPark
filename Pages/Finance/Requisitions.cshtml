@page
@model ZororoMemorialPark.Pages.Finance.RequisitionsModel
@{
    ViewData["Title"] = "Requisitions";
}

<div class="card shadow-sm mb-5">
    <div class="card-header d-flex justify-content-between align-items-center"
         style="background-color: var(--primary-green); color: var(--primary-white);">
        <div>
            <h5 class="mb-0">Requisitions</h5>
            <small class="d-block" style="font-size:0.8rem;">
                Internal requisitions with item-level approvals.
            </small>
        </div>
        <a asp-page="./CreateRequisition" class="btn btn-light btn-sm">
            + New Requisition
        </a>
    </div>

    <div class="card-body">

        <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
            <form method="get" class="d-flex flex-wrap align-items-center gap-2">
                <div>
                    <label class="form-label mb-0 small">Status</label>
                    <select asp-for="StatusFilter"
                            asp-items="Model.StatusOptions"
                            class="form-select form-select-sm"
                            onchange="this.form.submit()">
                    </select>
                </div>

                <div>
                    <label class="form-label mb-0 small">Ownership</label>
                    <select asp-for="OwnershipFilter"
                            asp-items="Model.OwnershipOptions"
                            class="form-select form-select-sm"
                            onchange="this.form.submit()">
                    </select>
                </div>
            </form>
        </div>

        <div class="table-responsive">
            <table class="table table-striped table-class table-sm">
                <thead class="thead-light">
                    <tr>
                        <th>#</th>
                        <th>Date</th>
                        <th>Title</th>
                        <th>Requested By</th>
                        <th class="text-end">Total Requested</th>
                        <th class="text-end">Total Approved</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Requisitions.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted">
                                No requisitions found.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var r in Model.Requisitions)
                        {
                            var badgeClass = r.Status switch
                            {
                                "Pending" => "bg-warning text-dark",
                                "PendingLevel2" => "bg-info text-dark",
                                "PartiallyApproved" => "bg-primary",
                                "Approved" => "bg-success",
                                "Rejected" => "bg-danger",
                                "Paid" => "bg-dark",
                                _ => "bg-secondary"
                            };

                            <tr>
                                <td>@r.Id</td>
                                <td>@r.Date.ToString("yyyy-MM-dd")</td>
                                <td>@r.Title</td>
                                <td>@r.RequestedByUserId</td>
                                <td class="text-end">$@r.TotalRequested.ToString("N2")</td>
                                <td class="text-end">
                                    @if (r.TotalApproved > 0)
                                    {
                                        @("$" + r.TotalApproved.ToString("N2"))
                                    }
                                    else
                                    {
                                        <span class="text-muted">0.00</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge @badgeClass">@r.Status</span>
                                </td>
                                <td class="text-end">
                                    <a asp-page="./RequisitionDetails"
                                       asp-route-id="@r.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        View
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
