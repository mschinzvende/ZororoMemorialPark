@page
@model ZororoMemorialPark.Pages.Finance.Commissions.DetailsModel

@{
    ViewData["Title"] = "Agent Commission Details";
}

<div class="container-fluid py-4 mb-4">

    <!-- Header -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header text-white"
             style="background:var(--primary-green)">

            <div class="d-flex justify-content-between align-items-center">

                <div>

                    <h3 class="mb-0">

                        <i class="bi bi-cash-stack me-2"></i>

                        Agent Commission Management

                    </h3>

                    <small>

                        Finance / Agent Commissions

                    </small>

                </div>

                <div>

                    <a asp-page="Index"
                       class="btn btn-light">

                        <i class="bi bi-arrow-left"></i>

                        Back

                    </a>

                </div>

            </div>

        </div>

    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm">

            <i class="bi bi-check-circle-fill me-2"></i>

            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm">

            <i class="bi bi-exclamation-triangle-fill me-2"></i>

            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    <!-- Agent -->

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <div class="row">

                <div class="col-md-8">

                    <h3>

                        @Model.Agent.sys_agentName

                    </h3>

                    <div class="text-muted">

                        @Model.Agent.sys_agentContactPerson

                    </div>

                    <div>

                        <i class="bi bi-envelope"></i>

                        @Model.Agent.sys_agentEmail

                    </div>

                    <div>

                        <i class="bi bi-telephone"></i>

                        @Model.Agent.sys_agentPhone

                    </div>

                    <div>

                        <i class="bi bi-geo-alt"></i>

                        @Model.Agent.sys_agentAddress

                    </div>

                </div>

                <div class="col-md-4 text-end">

                    @if (Model.Agent.sys_isActive)
                    {
                        <span class="badge bg-success fs-6">

                            ACTIVE

                        </span>
                    }
                    else
                    {
                        <span class="badge bg-danger fs-6">

                            DISABLED

                        </span>
                    }

                    <br />

                    <br />

                   
                        <span class="badge bg-primary fs-6">

                          

                            Commission

                        </span>
                   
                        <span class="badge bg-warning text-dark fs-6">

                           

                            Fixed

                        </span>
                    

                </div>

            </div>

        </div>

    </div>

    <!-- Summary -->

    <div class="row mb-4">

        <div class="col-md-3">

            <div class="card border-start border-primary border-4 shadow-sm">

                <div class="card-body">

                    <small class="text-muted">

                        Bookings

                    </small>

                    <h2>

                        @Model.BookingCount

                    </h2>

                </div>

            </div>

        </div>

        <div class="col-md-3">

            <div class="card border-start border-success border-4 shadow-sm">

                <div class="card-body">

                    <small class="text-muted">

                        Earned

                    </small>

                    <h2>

                        $@Model.TotalEarned.ToString("N2")

                    </h2>

                </div>

            </div>

        </div>

        <div class="col-md-3">

            <div class="card border-start border-info border-4 shadow-sm">

                <div class="card-body">

                    <small class="text-muted">

                        Paid

                    </small>

                    <h2>

                        $@Model.TotalPaid.ToString("N2")

                    </h2>

                </div>

            </div>

        </div>

        <div class="col-md-3">

            <div class="card border-start border-danger border-4 shadow-sm">

                <div class="card-body">

                    <small class="text-muted">

                        Outstanding

                    </small>

                    <h2>

                        $@Model.Outstanding.ToString("N2")

                    </h2>

                    <span class="badge bg-danger fs-6"
                          id="RemainingBadge">

                        Remaining:
                        $@Model.Outstanding.ToString("N2")

                    </span>

                </div>

            </div>

        </div>

    </div>

    <!-- Tabs -->

    <ul class="nav nav-tabs mb-3">

        <li class="nav-item">

            <button class="nav-link active"
                    data-bs-toggle="tab"
                    data-bs-target="#commissions">

                Commissions Ledger

            </button>

        </li>

        <li class="nav-item">

            <button class="nav-link"
                    data-bs-toggle="tab"
                    data-bs-target="#payments">

                Payment History

            </button>

        </li>

        <li class="nav-item">

            <button class="nav-link"
                    data-bs-toggle="tab"
                    data-bs-target="#statement">

                Statement

            </button>

        </li>

    </ul>

    <div class="tab-content">

        <!-- COMMISSIONS TAB -->

        <div class="tab-pane fade show active"
             id="commissions">

            <div class="row">

                <!-- LEFT -->

                <div class="col-lg-8">

                    <div class="card shadow-sm">

                        <div class="card-header">

                            <div class="row">

                                <div class="col-md-6">

                                    <h5>

                                        Earned Commissions

                                    </h5>

                                </div>

                                <div class="col-md-6">

                                    <form method="get">

                                        <input type="hidden"
                                               name="id"
                                               value="@Model.Id" />

                                        <input name="CommissionSearch"
                                               value="@Model.CommissionSearch"
                                               class="form-control"
                                               placeholder="Search..." />

                                    </form>

                                </div>

                            </div>

                        </div>

                        <div class="card-body p-0">

                            <div class="table-responsive">

                                <table class="table table-striped table-sm">

                                    <thead>

                                        <tr>

                                            <th style="width:90px">Booking</th>

                                            <th>Deceased</th>

                                            <th>Section</th>

                                            <th class="text-end">Commission</th>

                                            <th class="text-end">Paid</th>

                                            <th class="text-end">Outstanding</th>

                                        </tr>

                                    </thead>

                                    <tbody>

                                        @if (Model.OutstandingCommissions.Any())
                                        {
                                            @foreach (var row in Model.OutstandingCommissions)
                                            {
                                                var progress = row.Commission == 0
                                                ? 0
                                                : (row.Paid / row.Commission) * 100;

                                                var rowClass = "";

                                                if (row.Balance <= 0)
                                                {
                                                    rowClass = "table-success";
                                                }
                                                else if (row.Paid > 0)
                                                {
                                                    rowClass = "table-warning";
                                                }
                                                else
                                                {
                                                    rowClass = "table-danger";
                                                }

                                                <tr class="@rowClass">

                                                    <td>

                                                        <strong>

                                                            #@row.BookingId

                                                        </strong>

                                                    </td>

                                                    <td>

                                                        @row.DeceasedName

                                                    </td>

                                                    <td>

                                                        @row.SectionName

                                                    </td>

                                                    <td class="text-end">

                                                        $@row.Commission.ToString("N2")

                                                    </td>

                                                    <td class="text-end text-success">

                                                        $@row.Paid.ToString("N2")

                                                    </td>

                                                    <td class="text-end">

                                                        <div>

                                                            <strong>

                                                                $@row.Balance.ToString("N2")

                                                            </strong>

                                                        </div>

                                                        @if (row.Balance > 0)
                                                        {
                                                            <div class="progress mt-1"
                                                                 style="height:5px;">

                                                                <div class="progress-bar bg-success"
                                                                     style="width:@progress%">
                                                                </div>

                                                            </div>
                                                        }

                                                    </td>

                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr>

                                                <td colspan="6"
                                                    class="text-center py-5">

                                                    <i class="bi bi-cash-stack fs-1 text-muted"></i>

                                                    <br />

                                                    No commission records found.

                                                </td>

                                            </tr>
                                        }

                                    </tbody>

                                    <tfoot class="table-light fw-bold">

                                        <tr>

                                            <td colspan="3">

                                                Totals

                                            </td>

                                            <td class="text-end">

                                                $@Model.OutstandingCommissions.Sum(x => x.Commission).ToString("N2")

                                            </td>

                                            <td class="text-end text-success">

                                                $@Model.OutstandingCommissions.Sum(x => x.Paid).ToString("N2")

                                            </td>

                                            <td class="text-end text-danger">

                                                $@Model.OutstandingCommissions.Sum(x => x.Balance).ToString("N2")

                                            </td>

                                        </tr>

                                    </tfoot>

                                </table>

                            </div>

                        </div>

                    </div>

                </div>

                <!-- RIGHT -->

                <div class="col-lg-4">

                    <div class="card shadow-sm sticky-top" style="top:20px;">

                        <div class="card-header bg-success text-white">

                            <h5 class="mb-0">

                                <i class="bi bi-cash-coin me-2"></i>

                                Record Payment

                            </h5>

                        </div>

                        <div class="card-body">

                            <form method="post"
                                  asp-page-handler="RecordPayment">

                                <input type="hidden"
                                       asp-for="Id" />

                                <div class="mb-3">

                                    <label class="form-label">

                                        Payment Date

                                    </label>

                                    <input asp-for="Payment.PaymentDate"
                                           type="date"
                                           class="form-control" />

                                </div>

                                <div class="mb-3">

                                    <label class="form-label">

                                        Amount

                                    </label>

                                    <input asp-for="Payment.Amount"
                                           id="paymentAmount"
                                           type="number"
                                           step="0.01"
                                           class="form-control"
                                           autocomplete="off" />

                                </div>

                                <div class="mb-3">

                                    <label class="form-label">

                                        Reference

                                    </label>

                                    <input asp-for="Payment.Reference"
                                           class="form-control" />

                                </div>

                                <div class="mb-3">

                                    <label class="form-label">

                                        Notes

                                    </label>

                                    <textarea asp-for="Payment.Notes"
                                              rows="3"
                                              class="form-control"></textarea>

                                </div>

                                <hr />

                                <div class="row text-center">

                                    <div class="col-12">

                                        <small class="text-muted">

                                            Outstanding

                                        </small>

                                        <h4 class="text-danger"
                                            id="OutstandingAmount">

                                            @Model.Outstanding.ToString("N2")

                                        </h4>

                                    </div>

                                </div>

                                <div class="row mt-3">

                                    <div class="col-6 text-center">

                                        <small class="text-muted">

                                            Payment

                                        </small>

                                        <h5 class="text-success"
                                            id="PaymentPreview">

                                            0.00

                                        </h5>

                                    </div>

                                    <div class="col-6 text-center">

                                        <small class="text-muted">

                                            Remaining

                                        </small>

                                        <h5 id="RemainingPreview">

                                            @Model.Outstanding.ToString("N2")

                                        </h5>

                                    </div>

                                </div>

                                <hr />

                                <button id="btnRecordPayment"
                                        class="btn btn-success w-100"
                                        disabled>

                                    <i class="bi bi-check-circle me-2"></i>

                                    Record Payment

                                </button>

                            </form>

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <!-- PAYMENT TAB -->

        <div class="tab-pane fade"
             id="payments">

            <div class="card shadow-sm mt-4">

                <div class="card-header bg-light">

                    <div class="row align-items-center">

                        <div class="col-md-6">

                            <h5 class="mb-0">
                                <i class="bi bi-clock-history me-2"></i>
                                Payment History
                            </h5>

                        </div>

                        <div class="col-md-6">

                            <form method="get">

                                <input type="hidden" name="Id" value="@Model.Id" />

                                <input class="form-control"
                                       name="PaymentSearch"
                                       value="@Model.PaymentSearch"
                                       placeholder="Search Reference..." />

                            </form>

                        </div>

                    </div>

                </div>

                <div class="table-responsive">

                    <table class="table table-striped table-sm">

                        <thead>

                            <tr>

                                <th>Date</th>

                                <th>Reference</th>

                                <th class="text-end">Amount</th>

                                <th class="text-end">Allocated</th>

                                <th class="text-center">Commissions</th>

                                <th>Recorded By</th>

                                <th class="text-center">Actions</th>

                            </tr>

                        </thead>

                        <tbody>

                            @if (Model.Payments.Any())
                            {
                                @foreach (var payment in Model.Payments)
                                {
                                    <tr>

                                        <td>

                                            @payment.PaymentDate.ToString("dd MMM yyyy")

                                        </td>

                                        <td>

                                            @payment.Reference

                                        </td>

                                        <td class="text-end fw-bold text-success">

                                            $@payment.Amount.ToString("N2")

                                        </td>

                                        <td class="text-end">

                                            $@payment.AllocatedAmount.ToString("N2")

                                        </td>

                                        <td class="text-center">

                                            <span class="badge bg-primary">

                                                @payment.AllocatedCommissions

                                            </span>

                                        </td>

                                        <td>

                                            @payment.RecordedBy

                                        </td>

                                        <td class="text-center">

                                            <button type="button"
                                                    class="btn btn-sm btn-outline-primary"
                                                    onclick="viewPaymentAllocations(@payment.PaymentId)">

                                                <i class="bi bi-eye"></i>

                                            </button>

                                        </td>

                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>

                                    <td colspan="7"
                                        class="text-center py-5">

                                        No payment history found.

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

        <!-- STATEMENT -->

        <div class="tab-pane fade"
             id="statement">

            <div class="card shadow-sm mt-4">

                <div class="card-header bg-light">

                    <h5 class="mb-0">

                        <i class="bi bi-file-earmark-text me-2"></i>

                        Commission Statement

                    </h5>

                </div>

                <div class="card-body text-center">

                    <a class="btn btn-success me-2">

                        <i class="bi bi-printer"></i>

                        Print Statement

                    </a>

                    <a class="btn btn-danger me-2">

                        <i class="bi bi-file-earmark-pdf"></i>

                        PDF

                    </a>

                    <a class="btn btn-primary">

                        <i class="bi bi-file-earmark-excel"></i>

                        Excel

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>

<div class="offcanvas offcanvas-end"
     tabindex="-1"
     id="allocationCanvas">

    <div class="offcanvas-header">

        <h5>

            Payment Allocation

        </h5>

        <button type="button"
                class="btn-close"
                data-bs-dismiss="offcanvas"></button>

    </div>

    <div class="offcanvas-body">

        <div id="allocationContainer">

            <div class="text-center py-5">

                <div class="spinner-border"></div>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <script>

        const outstanding=@Model.Outstanding.ToString(System.Globalization.CultureInfo.InvariantCulture);

        const amount=document.getElementById("paymentAmount");

        const payment=document.getElementById("PaymentPreview");

        const remaining=document.getElementById("RemainingPreview");

                function updatePreview() {

            let value = parseFloat(amount.value);

            if (isNaN(value))
                value = 0;

            if (value < 0)
                value = 0;

            const button = document.getElementById("btnRecordPayment");

            if (value > outstanding) {

                payment.innerHTML = value.toFixed(2);

                remaining.innerHTML =
                    "<span class='text-danger'>Overpayment</span>";

                document
                    .getElementById("RemainingBadge")
                    .className = "badge bg-danger fs-6";

                document
                    .getElementById("RemainingBadge")
                    .innerHTML =
                    "Overpayment: $" +
                    (value - outstanding).toFixed(2);

                button.disabled = true;

                return;
            }

            payment.innerHTML =
                value.toFixed(2);

            var balance =
                outstanding - value;

            remaining.innerHTML =
                balance.toFixed(2);

            if (balance <= 0) {

                document
                    .getElementById("RemainingBadge")
                    .className =
                    "badge bg-success fs-6";

                document
                    .getElementById("RemainingBadge")
                    .innerHTML =
                    "Fully Paid";

            }
            else {

                document
                    .getElementById("RemainingBadge")
                    .className =
                    "badge bg-warning text-dark fs-6";

                document
                    .getElementById("RemainingBadge")
                    .innerHTML =
                    "Remaining: $" +
                    balance.toFixed(2);

            }

            button.disabled =
                value <= 0;
        }

        if(amount){

        amount.addEventListener("input",updatePreview);

        }

        async function viewPaymentAllocations(paymentId){

            const canvas=new bootstrap.Offcanvas(document.getElementById('allocationCanvas'));

            canvas.show();

            document.getElementById("allocationContainer").innerHTML=
                "<div class='text-center py-5'><div class='spinner-border'></div></div>";

            const response=await fetch(
                `?handler=PaymentAllocations&paymentId=${paymentId}`);

            const data=await response.json();

            let html="";
            
            html+="<table class='table table-sm table-striped'>";

            html+="<thead>";

            html+="<tr>";

            html+="<th>Booking</th>";

            html+="<th>Deceased</th>";

            html+="<th>Section</th>";

            html+="<th class='text-end'>Amount</th>";

            html+="</tr>";

            html+="</thead>";

            html+="<tbody>";

            data.forEach(function(item){

                html+="<tr>";

                html+="<td>"+item.booking+"</td>";

                html+="<td>"+item.deceased+"</td>";

                html+="<td>"+item.section+"</td>";

                html+="<td class='text-end'>$"+parseFloat(item.sys_amountAllocated).toFixed(2)+"</td>";

                html+="</tr>";

            });

            html+="</tbody>";

            html+="</table>";

            document.getElementById("allocationContainer").innerHTML=html;

        }

    </script>

}