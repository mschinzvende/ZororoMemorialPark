@page
@model AgentManagementModel
@{
    ViewData["Title"] = "Agents";
}

<div class="row">
    <div class="col-lg-12 mx-auto">
        <div class="card shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center"
                 style="background-color: var(--primary-green); color: var(--primary-white);">
                <h5 class="mb-0">Agent Management</h5>
                <div>
                    
                    <button class="btn btn-sm btn-light me-2" data-bs-toggle="modal" data-bs-target="#addAgentModal">
                        <i class="bi bi-plus-circle"></i>Add Agent
                    </button>
                </div>
            </div>

            <div class="card-body">

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert alert-success alert-dismissible fade show mt-2" role="alert">
            @Model.StatusMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show mt-2" role="alert">
            @Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
   

    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th>Name</th>
                <th>Contact Person</th>
                <th>Phone</th>
                <th>Email</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in Model.Agents)
            {
                <tr>
                    <td>@a.sys_agentName</td>
                    <td>@a.sys_agentContactPerson</td>
                    <td>@a.sys_agentPhone</td>
                    <td>@a.sys_agentEmail</td>
                    <td>
                        <button class="btn btn-info btn-sm viewBtn" data-id="@a.sys_agentId">View</button>
                        <button class="btn btn-warning btn-sm editBtn"
                                data-id="@a.sys_agentId"
                                data-name="@a.sys_agentName"
                                data-contact="@a.sys_agentContactPerson"
                                data-phone="@a.sys_agentPhone"
                                data-email="@a.sys_agentEmail"
                                data-address="@a.sys_agentAddress"
                                data-userid="@a.UserId">
                            Edit
                        </button>
                        <button class="btn btn-danger btn-sm deleteBtn" data-id="@a.sys_agentId">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
</div>
</div>
</div>

<!-- Add Agent Modal -->
<div class="modal fade" id="addAgentModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <form method="post" asp-page-handler="AddAgent">
                <div class="modal-header" style="background-color: var(--primary-green); color: var(--primary-white);"><h5>Add Agent</h5></div>
                <div class="modal-body">
                    <div class="mb-2"><label>Name</label><input asp-for="Agent.sys_agentName" class="form-control" required /></div>
                    <div class="mb-2"><label>Contact Person</label><input asp-for="Agent.sys_agentContactPerson" class="form-control" /></div>
                    <div class="mb-2"><label>Phone</label><input asp-for="Agent.sys_agentPhone" class="form-control" /></div>
                    <div class="mb-2"><label>Email</label><input asp-for="Agent.sys_agentEmail" class="form-control" /></div>
                    <div class="mb-2"><label>Address</label><input asp-for="Agent.sys_agentAddress" class="form-control" /></div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Agent Modal -->
<div class="modal fade" id="editAgentModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="EditAgent">
                <div class="modal-header" style="background-color: var(--primary-green); color: var(--primary-white);"><h5>Edit Agent</h5></div>
                <div class="modal-body">
                    <input type="hidden" asp-for="Agent.sys_agentId" id="editAgentId" />
                    <input type="hidden" asp-for="Agent.UserId" id="editAgentUserId" />
                    <div class="mb-2"><label>Name</label><input asp-for="Agent.sys_agentName" id="editAgentName" class="form-control" required /></div>
                    <div class="mb-2"><label>Contact Person</label><input asp-for="Agent.sys_agentContactPerson" id="editContact" class="form-control" /></div>
                    <div class="mb-2"><label>Phone</label><input asp-for="Agent.sys_agentPhone" id="editPhone" class="form-control" /></div>
                    <div class="mb-2"><label>Email</label><input asp-for="Agent.sys_agentEmail" id="editEmail" class="form-control" /></div>
                    <div class="mb-2"><label>Address</label><input asp-for="Agent.sys_agentAddress" id="editAddress" class="form-control" /></div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button class="btn btn-primary">Update</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Delete Agent Modal -->
<div class="modal fade" id="deleteAgentModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="DeleteAgent">
                <div class="modal-header" style="background-color: var(--primary-green); color: var(--primary-white);"><h5>Delete Agent</h5></div>
                <div class="modal-body">
                    <p>Are you sure you want to delete this agent?</p>
                    <input type="hidden" name="id" id="deleteAgentId" />
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button class="btn btn-danger">Delete</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- View Agent Modal -->
<div class="modal fade" id="viewAgentModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header" style="background-color: var(--primary-green); color: var(--primary-white);"><h5>Agent Details</h5></div>
            <div class="modal-body" id="agentDetails">
                <!-- Fetched dynamically -->
            </div>
        </div>
    </div>
</div>

<!-- Add Payment Modal -->
<div class="modal fade" id="addPaymentModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="AddPayment">
                <div class="modal-header" style="background-color: var(--primary-green); color: var(--primary-white);"><h5>Record Payment</h5></div>
                <div class="modal-body">
                    <input type="hidden" asp-for="Payment.sys_commissionId" id="paymentCommissionId" />
                    <div class="mb-2"><label>Date</label><input asp-for="Payment.sys_paymentDate" type="date" class="form-control" required /></div>
                    <div class="mb-2"><label>Amount</label><input asp-for="Payment.sys_amountPaid" type="number" step="0.01" class="form-control" required /></div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button class="btn btn-primary">Save Payment</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Edit
            document.querySelectorAll(".editBtn").forEach(btn => {
                btn.addEventListener("click", function () {
                    document.getElementById("editAgentId").value = this.dataset.id;
                    document.getElementById("editAgentName").value = this.dataset.name;
                    document.getElementById("editContact").value = this.dataset.contact;
                    document.getElementById("editPhone").value = this.dataset.phone;
                    document.getElementById("editEmail").value = this.dataset.email;
                    document.getElementById("editAddress").value = this.dataset.address;
                   document.getElementById("editAgentUserId").value = this.dataset.userid;
                    new bootstrap.Modal(document.getElementById("editAgentModal")).show();
                });
            });

            // Delete
            document.querySelectorAll(".deleteBtn").forEach(btn => {
                btn.addEventListener("click", function () {
                    document.getElementById("deleteAgentId").value = this.dataset.id;
                    new bootstrap.Modal(document.getElementById("deleteAgentModal")).show();
                });
            });

            // View (fetch commissions + payments)
            document.querySelectorAll(".viewBtn").forEach(btn => {
                btn.addEventListener("click", function () {
                    fetch(`?handler=AgentDetails&id=${this.dataset.id}`)
                        .then(r => r.json())
                        .then(data => {
                            let totalCommission = data.commissions.reduce((sum, c) => sum + c.sys_amount, 0);
                            let totalPayments = data.payments.reduce((sum, p) => sum + p.sys_amountPaid, 0);
                            let balance = totalCommission - totalPayments;

                            let html = `
                                <h5>${data.agent.sys_agentName}</h5>
                                <p><b>Contact:</b> ${data.agent.sys_agentContactPerson} | ${data.agent.sys_agentPhone}</p>
                                <p><b>Email:</b> ${data.agent.sys_agentEmail}</p>
                                <p><b>Address:</b> ${data.agent.sys_agentAddress}</p>
                                <p><b>Total Commission:</b> $${totalCommission.toFixed(2)} |
                                   <b>Total Payments:</b> $${totalPayments.toFixed(2)} |
                                   <b>Balance Due:</b> $${balance.toFixed(2)}</p>

                                <h6>Commissions Due</h6>
                                <table class="table table-sm table-bordered">
                                    <thead><tr><th>Grave</th><th>Amount</th><th></th></tr></thead>
                                    <tbody>
                                        ${data.commissions.map(c => `
                                            <tr>
                                                <td>${c.sys_graveId}</td>
                                                <td>$${c.sys_amount}</td>
                                                <td><button class="btn btn-success btn-sm payBtn" data-id="${c.sys_commissionId}">Pay</button></td>
                                            </tr>`).join("")}
                                    </tbody>
                                </table>

                                <h6>Payments Made</h6>
                                <table class="table table-sm table-bordered">
                                    <thead><tr><th>Date</th><th>Amount</th></tr></thead>
                                    <tbody>
                                        ${data.payments.map(p => `
                                            <tr>
                                                <td>${new Date(p.paymentDate).toLocaleDateString()}</td>
                                                <td>$${p.amountPaid}</td>
                                            </tr>`).join("")}
                                    </tbody>
                                </table>
                            `;
                            document.getElementById("agentDetails").innerHTML = html;

                            document.querySelectorAll(".payBtn").forEach(btn => {
                                btn.addEventListener("click", function () {
                                    document.getElementById("paymentCommissionId").value = this.dataset.id;
                                    new bootstrap.Modal(document.getElementById("addPaymentModal")).show();
                                });
                            });

                            new bootstrap.Modal(document.getElementById("viewAgentModal")).show();
                        });
                });
            });
        });
    </script>
}
