@page
@model AgentManagementModel
@{
    ViewData["Title"] = "Agents";
}

<div class="row">
    <div class="col-lg-12 mx-auto">
        <div class="card shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center"
                 style="background-color: var(--primary-green); color: var(--primary-white);">
                <h5 class="mb-0">Agent Management</h5>
                <div>
                    
                    <button class="btn btn-sm btn-light me-2" data-bs-toggle="modal" data-bs-target="#addAgentModal">
                        <i class="bi bi-plus-circle"></i>Add Agent
                    </button>
                </div>
            </div>

            <div class="card-body">

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert" id="successMessage">
                        @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
   

    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th>Name</th>
                <th>Contact Person</th>
                <th>Phone (263...)</th>
                <th>Email</th>
                            <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in Model.Agents)
            {
                <tr>
                    <td>@a.sys_agentName</td>
                    <td>@a.sys_agentContactPerson</td>
                    <td>@a.sys_agentPhone</td>
                    <td>@a.sys_agentEmail</td>
                                <td>
                                    @if (a.sys_isActive)
                                    {
                                        <span class="badge bg-success">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            Disabled
                                        </span>
                                    }
                                </td>
                    <td>
                                    <button class="btn btn-info btn-sm viewBtn" data-id="@a.sys_agentId">View</button>
                        <button class="btn btn-warning btn-sm editBtn"
                                data-id="@a.sys_agentId"
                                data-name="@a.sys_agentName"
                                data-contact="@a.sys_agentContactPerson"
                                data-phone="@a.sys_agentPhone"
                                data-email="@a.sys_agentEmail"
                                data-address="@a.sys_agentAddress"
                                data-userid="@a.UserId"
                                >
                            Edit
                        </button>
                                    @if (a.sys_isActive)
                                    {
                                        <button class="btn btn-secondary btn-sm toggleStatusBtn"
                                                data-id="@a.sys_agentId"
                                                data-action="disable">
                                            Disable
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-success btn-sm toggleStatusBtn"
                                                data-id="@a.sys_agentId"
                                                data-action="enable">
                                            Enable
                                        </button>
                                    }

                                    <button class="btn btn-secondary btn-sm resetPinBtn"
                                            data-id="@a.sys_agentId">
                                        Reset PIN
                                    </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
</div>
</div>
</div>

<!-- Add Agent Modal -->
<div class="modal fade" id="addAgentModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <form method="post" asp-page-handler="AddAgent">
                <div class="modal-header" style="background-color: var(--primary-green); color: var(--primary-white);"><h5>Add Agent</h5></div>
                <div class="modal-body">

                    <div class="row">

                        <div class="col-md-6 mb-3">
                            <label class="form-label">Agent Name</label>
                            <input asp-for="Agent.sys_agentName" class="form-control" required />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">Contact Person</label>
                            <input asp-for="Agent.sys_agentContactPerson" class="form-control" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">Phone (263...)</label>
                            <input asp-for="Agent.sys_agentPhone" class="form-control" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">Email Address</label>
                            <input asp-for="Agent.sys_agentEmail" class="form-control" />
                        </div>

                        <div class="col-12 mb-3">
                            <label class="form-label">Address</label>
                            <textarea asp-for="Agent.sys_agentAddress"
                                      class="form-control"
                                      rows="3"></textarea>
                        </div>

                    </div>

                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Agent Modal -->
<div class="modal fade" id="editAgentModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="EditAgent">
                <div class="modal-header" style="background-color: var(--primary-green); color: var(--primary-white);"><h5>Edit Agent</h5></div>
                <div class="modal-body">

                    <input type="hidden" asp-for="Agent.sys_agentId" id="editAgentId" />
                    <input type="hidden" asp-for="Agent.UserId" id="editAgentUserId" />

                    <div class="row">

                        <div class="col-md-6 mb-3">
                            <label class="form-label">Agent Name</label>
                            <input asp-for="Agent.sys_agentName"
                                   id="editAgentName"
                                   class="form-control"
                                   required />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">Contact Person</label>
                            <input asp-for="Agent.sys_agentContactPerson"
                                   id="editContact"
                                   class="form-control" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">Phone (263...)</label>
                            <input asp-for="Agent.sys_agentPhone"
                                   id="editPhone"
                                   class="form-control" placeholder="Include country code" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">Email Address</label>
                            <input asp-for="Agent.sys_agentEmail"
                                   id="editEmail"
                                   class="form-control" />
                        </div>

                        <div class="col-12 mb-3">
                            <label class="form-label">Address</label>
                            <textarea asp-for="Agent.sys_agentAddress"
                                      id="editAddress"
                                      class="form-control"
                                      rows="3"></textarea>
                        </div>

                    </div>

                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Update</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!--DISABLE AGENT MODAL-->
<div class="modal fade" id="toggleStatusModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <form method="post" asp-page-handler="ToggleStatus">

                <div class="modal-header">
                    <h5 id="toggleStatusTitle">Change Agent Status</h5>
                </div>

                <div class="modal-body">

                    <input type="hidden"
                           id="toggleAgentId"
                           name="AgentId" />

                    <input type="hidden"
                           id="toggleAction"
                           name="Action" />

                    <p id="toggleStatusMessage"></p>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button class="btn btn-primary">
                        Confirm
                    </button>

                </div>

            </form>

        </div>
    </div>
</div>

<!--DISABLE AGENT-->





<!-- View Agent Modal -->
<div class="modal fade" id="viewAgentModal" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-body">

            <!-- Agent Summary -->
            <div class="row mb-4">

                <div class="col-md-4">
                    <div class="card border-primary">
                        <div class="card-body">
                            <h6 class="text-muted">Agent Name</h6>
                            <h5 id="agentName"></h5>

                            <hr />

                            <p>
                                <strong>Contact Person:</strong><br />
                                <span id="agentContact"></span>
                            </p>

                            <p>
                                <strong>Email:</strong><br />
                                <span id="agentEmail"></span>
                            </p>

                            <p>
                                <strong>Phone:</strong><br />
                                <span id="agentPhone"></span>
                            </p>

                            <p>
                                <strong>Address:</strong><br />
                                <span id="agentAddress"></span>
                            </p>

                            <p>
                                <strong>Status:</strong>
                                <span id="agentStatus"></span>
                            </p>

                            <p>
                                <strong>WhatsApp PIN:</strong>
                                <span id="agentPinStatus"></span>
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Summary Cards -->
                <div class="col-md-8">

                    <div class="row">

                        <div class="col-md-3">
                            <div class="card bg-primary text-white">
                                <div class="card-body text-center">
                                    <h6>Total Bookings</h6>
                                    <h3 id="totalBookings">0</h3>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="card bg-success text-white">
                                <div class="card-body text-center">
                                    <h6>Commission Due</h6>
                                    <h3 id="commissionDue">$0</h3>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="card bg-info text-white">
                                <div class="card-body text-center">
                                    <h6>Paid</h6>
                                    <h3 id="commissionPaid">$0</h3>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="card bg-warning text-dark">
                                <div class="card-body text-center">
                                    <h6>Outstanding</h6>
                                    <h3 id="commissionOutstanding">$0</h3>
                                </div>
                            </div>
                        </div>

                    </div>

                    <!-- Commission Table -->
                    <div class="card mt-3">
                        <div class="card-header">
                            Commissions Due
                        </div>
                        <div class="card-body p-0">

                            <table class="table table-sm table-bordered mb-0">
                                <thead>
                                    <tr>
                                        <th>Grave</th>
                                        <th>Amount</th>
                                        <th>Paid</th>
                                        <th>Remaining</th>
                                        <th></th>
                                    </tr>
                                </thead>

                                <tbody id="commissionsTableBody"></tbody>
                            </table>

                        </div>
                    </div>

                </div>

            </div>

            <!-- Payments -->
            <div class="card">

                <div class="card-header">
                    Payment History
                </div>

                <div class="card-body p-0">

                    <table class="table table-sm table-bordered mb-0">

                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Amount</th>
                            </tr>
                        </thead>

                        <tbody id="paymentsTableBody"></tbody>

                    </table>

                </div>

            </div>

        </div>
    </div>
</div>

<!-- Add Payment Modal -->
<div class="modal fade" id="addPaymentModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="paymentForm">
                @Html.AntiForgeryToken()
                <div class="modal-header" style="background-color: var(--primary-green); color: var(--primary-white);">
                    <h5>Record Payment</h5>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="paymentCommissionId" name="Payment.sys_commissionId" />
                    <div class="mb-2">
                        <label>Date</label>
                        <input type="date" id="paymentDate" name="Payment.sys_paymentDate" class="form-control" required />
                    </div>
                    <div class="mb-2">
                        <label>Amount</label>
                        <input type="number" step="0.01" id="paymentAmount" name="Payment.sys_amountPaid" class="form-control" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Payment</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="resetPinModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <form method="post" asp-page-handler="ResetPin">

                <div class="modal-header">
                    <h5>Reset WhatsApp PIN</h5>
                </div>

                <div class="modal-body">

                    <input type="hidden"
                           id="resetPinAgentId"
                           name="AgentId" />

                    <p>
                        Reset this agent's WhatsApp PIN?
                    </p>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button class="btn btn-warning">
                        Reset PIN
                    </button>

                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Edit
            document.querySelectorAll(".editBtn").forEach(btn => {
                btn.addEventListener("click", function () {
                    document.getElementById("editAgentId").value = this.dataset.id;
                    document.getElementById("editAgentName").value = this.dataset.name;
                    document.getElementById("editContact").value = this.dataset.contact;
                    document.getElementById("editPhone").value = this.dataset.phone;
                    document.getElementById("editEmail").value = this.dataset.email;
                    document.getElementById("editAddress").value = this.dataset.address;
                   document.getElementById("editAgentUserId").value = this.dataset.userid;
                   
                    new bootstrap.Modal(document.getElementById("editAgentModal")).show();
                });
            });

            // Delete
            document.querySelectorAll(".deleteBtn").forEach(btn => {
                btn.addEventListener("click", function () {
                    document.getElementById("deleteAgentId").value = this.dataset.id;
                    new bootstrap.Modal(document.getElementById("deleteAgentModal")).show();
                });
            });

            
                let currentAgentId = null;

        // View Agent
        document.querySelectorAll(".viewBtn").forEach(btn => {
            btn.addEventListener("click", function () {
                currentAgentId = this.dataset.id;
                loadAgentDetails(currentAgentId);
            });
        });
            function loadAgentDetails(id) {

                        

            fetch(`?handler=AgentDetails&id=${id}`)
                .then(r => r.json())
                .then(data => {
                    document.getElementById("agentName").innerText = data.agent.sys_agentName;
                    document.getElementById("agentEmail").innerText = data.agent.sys_agentEmail;
                    document.getElementById("agentPhone").innerText = data.agent.sys_agentPhone;
                    document.getElementById("agentAddress").innerText = data.agent.sys_agentAddress;


                            document.getElementById("agentContact").innerText =
            data.agent.sys_agentContactPerson;

        document.getElementById("agentStatus").innerHTML =
            data.agent.sys_isActive
                ? '<span class="badge bg-success">Active</span>'
                : '<span class="badge bg-danger">Disabled</span>';

        document.getElementById("agentPinStatus").innerHTML =
            data.agent.sys_whatsAppPinSet
                ? '<span class="badge bg-success">Set</span>'
                : '<span class="badge bg-warning">Not Set</span>';

        document.getElementById("totalBookings").innerText =
            data.bookingCount;

        document.getElementById("commissionDue").innerText =
            "$" + data.totalCommission.toFixed(2);

        document.getElementById("commissionPaid").innerText =
            "$" + data.totalPaid.toFixed(2);

        document.getElementById("commissionOutstanding").innerText =
            "$" + data.outstanding.toFixed(2);
                    // Commissions
                    let commHtml = "";
                    data.result.forEach(c => {
                        let remaining = (c.sys_amount - c.amountPaid);
                        commHtml += `
                            <tr>
                                <td>${c.sys_graveId}</td>
                                <td>$${c.sys_amount.toFixed(2)}</td>
                                <td>${c.sys_isPaid ? "✅" : "❌"}</td>
                                <td>$${remaining}</td>
                                <td>
                                    ${remaining > 0 ? `<button class="btn btn-success btn-sm payBtn" data-id="${c.sys_commissionId}" data-remaining="${remaining}">Pay</button>` : `<button class="btn btn-secondary btn-sm" disabled>Paid</button>`}
                                </td>

                                 
                            </tr>`;
                    });
                    document.getElementById("commissionsTableBody").innerHTML = commHtml;

                    // Payments
                    let payHtml = "";
                    data.payments.forEach(p => {
                        payHtml += `<tr>
                                        <td>${new Date(p.sys_paymentDate).toLocaleDateString()}</td>
                                        <td>$${p.sys_amountPaid.toFixed(2)}</td>
                                    </tr>`;
                    });
                    document.getElementById("paymentsTableBody").innerHTML = payHtml;

                    // Re-bind pay buttons
                    document.querySelectorAll(".payBtn").forEach(btn => {
                        btn.addEventListener("click", function () {
                            document.getElementById("paymentCommissionId").value = this.dataset.id;
                            document.getElementById("paymentAmount").value = this.dataset.remaining;
                            document.getElementById("paymentDate").valueAsDate = new Date();
                            new bootstrap.Modal(document.getElementById("addPaymentModal")).show();
                        });
                    });

                    new bootstrap.Modal(document.getElementById("viewAgentModal")).show();
                });
        }

            // Save Payment (AJAX)
        document.getElementById("paymentForm").addEventListener("submit", function (e) {
            e.preventDefault();
                   const form = document.getElementById("paymentForm");
        const formData = new FormData(form);

            fetch("/Agents/AgentManagement?handler=AddPayment", {
                    method: "POST",
                    headers: {"RequestVerificationToken": form.querySelector("input[name='__RequestVerificationToken']").value
        },
        body: formData
            })
            .then(r => {
                if (r.ok) {
                    bootstrap.Modal.getInstance(document.getElementById("addPaymentModal")).hide();
                    loadAgentDetails(currentAgentId); // refresh details
                } else {
                    alert("Error saving payment");
                }
            });
        });
    

        });


     document.querySelectorAll(".resetPinBtn")
        .forEach(btn => {

            btn.addEventListener("click", function () {

                document.getElementById(
                    "resetPinAgentId").value =
                    this.dataset.id;

                new bootstrap.Modal(
                    document.getElementById(
                        "resetPinModal"))
                    .show();
            });

        });


                document.querySelectorAll(".toggleStatusBtn")
        .forEach(btn => {

            btn.addEventListener("click", function () {

                const id = this.dataset.id;
                const action = this.dataset.action;

                document.getElementById("toggleAgentId").value = id;
                document.getElementById("toggleAction").value = action;

                if (action === "disable") {
                    document.getElementById("toggleStatusTitle").innerText =
                        "Disable Agent";

                    document.getElementById("toggleStatusMessage").innerText =
                        "Are you sure you want to disable this agent?";
                }
                else {
                    document.getElementById("toggleStatusTitle").innerText =
                        "Enable Agent";

                    document.getElementById("toggleStatusMessage").innerText =
                        "Are you sure you want to enable this agent?";
                }

                new bootstrap.Modal(
                    document.getElementById("toggleStatusModal")
                ).show();
            });

        });


    </script>
}
