@page
@model AgentManagementModel
@{
    ViewData["Title"] = "Agents";
}

<div class="row">
    <div class="col-lg-12 mx-auto">
        <div class="card shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center"
                 style="background-color: var(--primary-green); color: var(--primary-white);">
                <h5 class="mb-0">Agent Management</h5>
                <div>
                    
                    <button class="btn btn-sm btn-light me-2" data-bs-toggle="modal" data-bs-target="#addAgentModal">
                        <i class="bi bi-plus-circle"></i>Add Agent
                    </button>
                </div>
            </div>

            <div class="card-body">

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert" id="successMessage">
                        @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
   

    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th>Name</th>
                <th>Contact Person</th>
                <th>Phone</th>
                <th>Email</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in Model.Agents)
            {
                <tr>
                    <td>@a.sys_agentName</td>
                    <td>@a.sys_agentContactPerson</td>
                    <td>@a.sys_agentPhone</td>
                    <td>@a.sys_agentEmail</td>
                    <td>
                                    <button class="btn btn-info btn-sm viewBtn" data-id="@a.sys_agentId">View</button>
                        <button class="btn btn-warning btn-sm editBtn"
                                data-id="@a.sys_agentId"
                                data-name="@a.sys_agentName"
                                data-contact="@a.sys_agentContactPerson"
                                data-phone="@a.sys_agentPhone"
                                data-email="@a.sys_agentEmail"
                                data-address="@a.sys_agentAddress"
                                data-userid="@a.UserId"
                                data-sys_commission="@a.sys_commission"
                                data-sys_isPercentage="@a.sys_isPercentage">
                            Edit
                        </button>
                        <button class="btn btn-danger btn-sm deleteBtn" data-id="@a.sys_agentId">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
</div>
</div>
</div>

<!-- Add Agent Modal -->
<div class="modal fade" id="addAgentModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <form method="post" asp-page-handler="AddAgent">
                <div class="modal-header" style="background-color: var(--primary-green); color: var(--primary-white);"><h5>Add Agent</h5></div>
                <div class="modal-body">
                    <div class="mb-2"><label>Name</label><input asp-for="Agent.sys_agentName" class="form-control" required /></div>
                    <div class="mb-2"><label>Contact Person</label><input asp-for="Agent.sys_agentContactPerson" class="form-control" /></div>
                    <div class="mb-2"><label>Phone</label><input asp-for="Agent.sys_agentPhone" class="form-control" /></div>
                    <div class="mb-2"><label>Email</label><input asp-for="Agent.sys_agentEmail" class="form-control" /></div>
                    <div class="mb-2"><label>Address</label><input asp-for="Agent.sys_agentAddress" class="form-control" /></div>
                    <div class="mb-2"><label>Commission</label><input asp-for="Agent.sys_commission" class="form-control" /></div>
                    <div class="mb-2">
                        <label>Type</label>
                        <select  class="form-control" asp-for="Agent.sys_isPercentage">
                            <option value="true">Percentage</option>
                            <option value="false">Fixed Amount</option>
                        </select>

                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Agent Modal -->
<div class="modal fade" id="editAgentModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="EditAgent">
                <div class="modal-header" style="background-color: var(--primary-green); color: var(--primary-white);"><h5>Edit Agent</h5></div>
                <div class="modal-body">
                    <input type="hidden" asp-for="Agent.sys_agentId" id="editAgentId" />
                    <input type="hidden" asp-for="Agent.UserId" id="editAgentUserId" />
                    <div class="mb-2"><label>Name</label><input asp-for="Agent.sys_agentName" id="editAgentName" class="form-control" required /></div>
                    <div class="mb-2"><label>Contact Person</label><input asp-for="Agent.sys_agentContactPerson" id="editContact" class="form-control" /></div>
                    <div class="mb-2"><label>Phone</label><input asp-for="Agent.sys_agentPhone" id="editPhone" class="form-control" /></div>
                    <div class="mb-2"><label>Email</label><input asp-for="Agent.sys_agentEmail" id="editEmail" class="form-control" /></div>
                    <div class="mb-2"><label>Address</label><input asp-for="Agent.sys_agentAddress" id="editAddress" class="form-control" /></div>
                    <div class="mb-2"><label>Commission</label><input asp-for="Agent.sys_commission" id="editCommission" class="form-control" /></div>
                    <div class="mb-2">
                        <label>Type</label>
                        <select id="editIsPercentage" class="form-control" asp-for="Agent.sys_isPercentage" asp-items="Model.IsPercentageOptions"></select>

                        
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button class="btn btn-primary">Update</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Delete Agent Modal -->
<div class="modal fade" id="deleteAgentModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="DeleteAgent">
                <div class="modal-header" style="background-color: var(--primary-green); color: var(--primary-white);"><h5>Delete Agent</h5></div>
                <div class="modal-body">
                    <p>Are you sure you want to delete this agent?</p>
                    <input type="hidden" name="id" id="deleteAgentId" />
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button class="btn btn-danger">Delete</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- View Agent Modal -->
<div class="modal fade" id="viewAgentModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header" style="background-color: var(--primary-green); color: var(--primary-white);">
                <h5 class="modal-title">Agent Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <h6>Agent Info</h6>
                <p><strong>Name:</strong> <span id="agentName"></span></p>
                <p><strong>Email:</strong> <span id="agentEmail"></span></p>
                <p><strong>Phone:</strong> <span id="agentPhone"></span></p>
                <p><strong>Address:</strong> <span id="agentAddress"></span></p>

                <h6>Commissions Due</h6>
                <table class="table table-sm table-bordered">
                    <thead><tr><th>Grave</th><th>Amount</th><th>Paid</th><th>Remaining</th><th></th></tr></thead>
                    <tbody id="commissionsTableBody"></tbody>
                </table>

                <h6>Payments Made</h6>
                <table class="table table-sm table-bordered">
                    <thead><tr><th>Date</th><th>Amount</th></tr></thead>
                    <tbody id="paymentsTableBody"></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Add Payment Modal -->
<div class="modal fade" id="addPaymentModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="paymentForm">
                @Html.AntiForgeryToken()
                <div class="modal-header" style="background-color: var(--primary-green); color: var(--primary-white);">
                    <h5>Record Payment</h5>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="paymentCommissionId" name="Payment.sys_commissionId" />
                    <div class="mb-2">
                        <label>Date</label>
                        <input type="date" id="paymentDate" name="Payment.sys_paymentDate" class="form-control" required />
                    </div>
                    <div class="mb-2">
                        <label>Amount</label>
                        <input type="number" step="0.01" id="paymentAmount" name="Payment.sys_amountPaid" class="form-control" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Payment</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Edit
            document.querySelectorAll(".editBtn").forEach(btn => {
                btn.addEventListener("click", function () {
                    document.getElementById("editAgentId").value = this.dataset.id;
                    document.getElementById("editAgentName").value = this.dataset.name;
                    document.getElementById("editContact").value = this.dataset.contact;
                    document.getElementById("editPhone").value = this.dataset.phone;
                    document.getElementById("editEmail").value = this.dataset.email;
                    document.getElementById("editAddress").value = this.dataset.address;
                   document.getElementById("editAgentUserId").value = this.dataset.userid;
                   document.getElementById("editCommission").value = this.dataset.sys_commission;
                   document.getElementById("editIsPercentage").value = this.dataset.sys_isPercentage;
                    new bootstrap.Modal(document.getElementById("editAgentModal")).show();
                });
            });

            // Delete
            document.querySelectorAll(".deleteBtn").forEach(btn => {
                btn.addEventListener("click", function () {
                    document.getElementById("deleteAgentId").value = this.dataset.id;
                    new bootstrap.Modal(document.getElementById("deleteAgentModal")).show();
                });
            });

            
                let currentAgentId = null;

        // View Agent
        document.querySelectorAll(".viewBtn").forEach(btn => {
            btn.addEventListener("click", function () {
                currentAgentId = this.dataset.id;
                loadAgentDetails(currentAgentId);
            });
        });
            function loadAgentDetails(id) {
            fetch(`?handler=AgentDetails&id=${id}`)
                .then(r => r.json())
                .then(data => {
                    document.getElementById("agentName").innerText = data.agent.sys_agentName;
                    document.getElementById("agentEmail").innerText = data.agent.sys_agentEmail;
                    document.getElementById("agentPhone").innerText = data.agent.sys_agentPhone;
                    document.getElementById("agentAddress").innerText = data.agent.sys_agentAddress;

                    // Commissions
                    let commHtml = "";
                    data.result.forEach(c => {
                        let remaining = (c.sys_amount - c.amountPaid);
                        commHtml += `
                            <tr>
                                <td>${c.sys_graveId}</td>
                                <td>$${c.sys_amount.toFixed(2)}</td>
                                <td>${c.sys_isPaid ? "✅" : "❌"}</td>
                                <td>$${remaining}</td>
                                <td>
                                    ${remaining > 0 ? `<button class="btn btn-success btn-sm payBtn" data-id="${c.sys_commissionId}" data-remaining="${remaining}">Pay</button>` : `<button class="btn btn-secondary btn-sm" disabled>Paid</button>`}
                                </td>

                                 
                            </tr>`;
                    });
                    document.getElementById("commissionsTableBody").innerHTML = commHtml;

                    // Payments
                    let payHtml = "";
                    data.payments.forEach(p => {
                        payHtml += `<tr>
                                        <td>${new Date(p.sys_paymentDate).toLocaleDateString()}</td>
                                        <td>$${p.sys_amountPaid.toFixed(2)}</td>
                                    </tr>`;
                    });
                    document.getElementById("paymentsTableBody").innerHTML = payHtml;

                    // Re-bind pay buttons
                    document.querySelectorAll(".payBtn").forEach(btn => {
                        btn.addEventListener("click", function () {
                            document.getElementById("paymentCommissionId").value = this.dataset.id;
                            document.getElementById("paymentAmount").value = this.dataset.remaining;
                            document.getElementById("paymentDate").valueAsDate = new Date();
                            new bootstrap.Modal(document.getElementById("addPaymentModal")).show();
                        });
                    });

                    new bootstrap.Modal(document.getElementById("viewAgentModal")).show();
                });
        }

            // Save Payment (AJAX)
        document.getElementById("paymentForm").addEventListener("submit", function (e) {
            e.preventDefault();
                   const form = document.getElementById("paymentForm");
        const formData = new FormData(form);

            fetch("/Agents/AgentManagement?handler=AddPayment", {
                    method: "POST",
                    headers: {"RequestVerificationToken": form.querySelector("input[name='__RequestVerificationToken']").value
        },
        body: formData
            })
            .then(r => {
                if (r.ok) {
                    bootstrap.Modal.getInstance(document.getElementById("addPaymentModal")).hide();
                    loadAgentDetails(currentAgentId); // refresh details
                } else {
                    alert("Error saving payment");
                }
            });
        });
    

        });
    </script>
}
