@page
@model UserManagementModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<h2 class="mb-4">User Management</h2>

<!-- Add User Button -->
<button class="btn btn-success mb-3" data-bs-toggle="modal" data-bs-target="#addUserModal">Add New User</button>


<!-- Users Table -->
<div class="table-responsive">
    <table class="table table-bordered table-striped align-middle">
        <thead>
            <tr>
                <th>Email</th>
                <th>Roles</th>
                <th>Locked Out</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model.Users)
            {
                <tr>
                    <td>@user.Email</td>
                    <td>@string.Join(", ", user.Roles)</td>
                    <td>@user.IsLockedOut</td>
                    <td class="d-flex flex-wrap gap-1">
                        <!-- Add Role -->
                        <form method="post" asp-page-handler="AddRole" class="d-flex gap-1">
                            <input type="hidden" name="userId" value="@user.Id" />
                            <select name="role" class="form-select form-select-sm">
                                @foreach (var r in Model.AllRoles)
                                {
                                    <option value="@r">@r</option>
                                }
                            </select>
                            <button type="submit" class="btn btn-sm btn-success">Add</button>
                        </form>

                        <!-- Remove Role -->
                        <form method="post" asp-page-handler="RemoveRole" class="d-flex gap-1">
                            <input type="hidden" name="userId" value="@user.Id" />
                            <select name="role" class="form-select form-select-sm">
                                @foreach (var r in Model.AllRoles)
                                {
                                    <option value="@r">@r</option>
                                }
                            </select>
                            <button type="submit" class="btn btn-sm btn-danger">Remove</button>
                        </form>

                        <!-- Lock/Unlock -->
                        <form method="post" asp-page-handler="ToggleLock">
                            <input type="hidden" name="userId" value="@user.Id" />
                            <button type="submit" class="btn btn-sm btn-warning">
                                @(user.IsLockedOut ? "Unlock" : "Lock")
                            </button>
                        </form>

                        <!-- Reset Password Modal Trigger -->
                        <button type="button" class="btn btn-sm btn-info" data-bs-toggle="modal" data-bs-target="#resetPasswordModal-@user.Id">
                            Reset
                        </button>

                        <!-- Reset Password Modal -->
                        <div class="modal fade" id="resetPasswordModal-@user.Id" tabindex="-1" aria-labelledby="resetPasswordLabel-@user.Id" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title" id="resetPasswordLabel-@user.Id">Reset Password for @user.Email</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <form method="post" asp-page-handler="ResetPassword">
                                        <div class="modal-body">
                                            <input type="hidden" name="userId" value="@user.Id" />
                                            <input type="text" name="newPassword" class="form-control" placeholder="New Password" required />
                                        </div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                            <button type="submit" class="btn btn-info">Reset Password</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>

                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Add User Modal -->
<div class="modal fade" id="addUserModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title">Add New User</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form method="post" asp-page-handler="AddUser">
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label">Email</label>
                        <input asp-for="Input.Email" class="form-control" placeholder="user@example.com" />
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Password" class="form-label">Password</label>
                        <input asp-for="Input.Password" type="password" class="form-control" placeholder="Password" />
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-success w-100">Create User</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Check server-side flag to reopen modal
            var showModal = '@Model.ShowModal'.toLowerCase() === 'true';
            if (showModal) {
                var myModal = new bootstrap.Modal(document.getElementById('addUserModal'));
                myModal.show();
            }
        });
    </script>
}
