@page
@model ZororoMemorialPark.Pages.Requisitions.ListModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<div class="card shadow-sm mb-5">
    <div class="card-header d-flex justify-content-between align-items-center"
         style="background-color: var(--primary-green); color: var(--primary-white);">
        <div>
            <h5 class="mb-0">Requisitions Overview</h5>
            <small class="d-block" style="font-size: 0.8rem;">
                View and manage all requisitions in the system.
            </small>
        </div>

    </div>

    <div class="card-body">

        <!-- FILTERS BAR -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body">
                <form method="get" class="row g-3">
                    <div class="col-md-4">
                        <input type="text" name="Search" value="@Model.Search" class="form-control"
                               placeholder="Search by Req#, Requester, Item…" />
                    </div>

                    <div class="col-md-3">
                        <select asp-for="Status" asp-items="Model.StatusOptions" class="form-select"></select>

                    </div>

                    <div class="col-md-2">
                        <button type="submit" class="btn text-white w-100" style="background-color:#006A46;">
                            Filter
                        </button>
                    </div>
                </form>
            </div>
        </div>


        <!-- RESULTS TABLE -->
        <div class="card shadow border-0">
            <div class="card-body">

                @if (!Model.Requisitions.Any())
                {
                    <p class="text-muted">No requisitions found.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-hover align-middle">
                            <thead class="thead-light">
                                <tr>
                                    <th>Req #</th>
                                    <th>Requester</th>
                                    <th>Created</th>
                                    <th>Workflow</th>
                                    <th>Current Stage</th>
                                    <th>Status</th>
                                    <th>Total</th>
                                    <th class="text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in Model.Requisitions)
                                {
                                    <tr>
                                        <td>@r.RequestNumber</td>
                                        <td>@r.Requester</td>
                                        <td>@r.CreatedAt.ToString("yyyy-MM-dd")</td>
                                        <td>@r.WorkflowName</td>
                                        <td>@r.CurrentStepName</td>
                                        <td>
                                            @switch (r.Status)
                                            {
                                                case "InProgress":
                                                    <span class="badge bg-warning text-dark">In Progress</span>
                                                    break;
                                                case "Approved":
                                                    <span class="badge bg-success">Approved</span>
                                                    break;
                                                case "Rejected":
                                                    <span class="badge bg-danger">Rejected</span>
                                                    break;
                                                default:
                                                    <span class="badge bg-secondary">@r.Status</span>
                                                    break;
                                            }
                                        </td>
                                        <td>$@r.TotalAmount.ToString("N2")</td>

                                        <td class="text-end">
                                            <a asp-page="/Requisitions/Details" asp-route-id="@r.Id">View</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

    </div>

</div>
