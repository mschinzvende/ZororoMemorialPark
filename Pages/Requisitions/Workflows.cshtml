@page
@model ZororoMemorialPark.Pages.Requisitions.WorkflowsModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<div class="card shadow-sm mb-5">
    <div class="card-header d-flex justify-content-between align-items-center"
         style="background-color: var(--primary-green); color: var(--primary-white);">
        <div>
            <h5 class="mb-0">Requisition Workflows</h5>
            <small class="d-block" style="font-size: 0.8rem;">
                Manage workflow definitions and approval paths.
            </small>
        </div>

        <div>
            <a asp-page="/Requisitions/WorkflowConfig"
               class="btn btn-light btn-sm">
                + Create Workflow
            </a>
        </div>
    </div>

    <div class="card-body">

        @if (!string.IsNullOrEmpty(Model.StatusMessage))
        {
            <div class="alert alert-info alert-dismissible fade show">
                @Model.StatusMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <!-- Search Bar -->
        <form method="get" class="mb-4">
            <div class="input-group">
                <input type="text"
                       name="Search"
                       value="@Model.Search"
                       class="form-control"
                       placeholder="Search by name or requester role..." />
                <button type="submit" class="btn btn-outline-secondary">
                    Search
                </button>
            </div>
        </form>

        <div class="card shadow border-0">
            <div class="card-body">

                @if (Model.Workflows == null || !Model.Workflows.Any())
                {
                    <p class="text-muted">No workflows found.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Requester Role</th>
                                    <th>Steps</th>
                                    <th>Status</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var w in Model.Workflows)
                                {
                                    <tr>
                                        <td>@w.Name</td>
                                        <td>@w.RequesterRole</td>
                                        <td>@w.StepCount</td>
                                        <td>
                                            @if (w.IsActive)
                                            {
                                                <span class="badge bg-success">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Inactive</span>
                                            }
                                        </td>
                                        <td class="text-end">

                                            <a asp-page="/Requisitions/WorkflowConfig"
                                               asp-route-id="@w.Id"
                                               class="btn btn-sm btn-outline-primary">
                                                View
                                            </a>

                                            @if (!w.IsInUse)
                                            {
                                                <button type="button"
                                                        class="btn btn-sm btn-outline-danger"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#deleteModal"
                                                        data-id="@w.Id"
                                                        data-name="@w.Name">
                                                    Delete
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button"
                                                        class="btn btn-sm btn-outline-danger"
                                                        disabled
                                                        title="Workflow is in use">
                                                    Delete
                                                </button>
                                            }

                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    @if (Model.TotalPages > 1)
                    {
                        <nav class="mt-3">
                            <ul class="pagination justify-content-center">

                                @for (int i = 1; i <= Model.TotalPages; i++)
                                {
                                    <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                        <a class="page-link"
                                           asp-route-PageNumber="@i"
                                           asp-route-Search="@Model.Search">
                                            @i
                                        </a>
                                    </li>
                                }

                            </ul>
                        </nav>
                    }

                }

            </div>
        </div>

    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header" style="background-color:#006A46;">
                <h5 class="modal-title text-white">Confirm Delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <form method="post" asp-page-handler="Delete">
                <div class="modal-body">
                    <input type="hidden" id="deleteWorkflowId" name="WorkflowId" />

                    <p>
                        Are you sure you want to delete workflow
                        <strong id="workflowName"></strong>?
                    </p>

                    <p class="text-danger">
                        This will permanently delete the workflow and its steps.
                    </p>
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn text-white"
                            style="background-color:#006A46;">
                        Confirm Delete
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        var deleteModal = document.getElementById('deleteModal');

        deleteModal.addEventListener('show.bs.modal', function (event) {

            var button = event.relatedTarget;

            var workflowId = button.getAttribute('data-id');
            var workflowName = button.getAttribute('data-name');

            document.getElementById("deleteWorkflowId").value = workflowId;
            document.getElementById("workflowName").innerText = workflowName;
        });
    </script>
}