@model ZororoMemorialPark.Data.Models.tbl_Tombstones

<div class="col-md-6">
    <label asp-for="sys_tombstoneName" class="form-label">Name</label>
    <input asp-for="sys_tombstoneName" class="form-control" required />
</div>

<div class="col-md-6">
    <label asp-for="sys_material" class="form-label">Material</label>
    <input asp-for="sys_material" class="form-control" />
</div>

<div class="col-md-6">
    <label asp-for="sys_size" class="form-label">Size</label>
    <input asp-for="sys_size" class="form-control" />
</div>

<div class="col-md-6">
    <label asp-for="sys_price" class="form-label">Price</label>
    <input asp-for="sys_price" type="number" step="0.01" class="form-control" required />
</div>

<div class="col-md-6">
    <label asp-for="sys_quantityAvailable" class="form-label">Quantity in Stock</label>
    <input asp-for="sys_quantityAvailable" type="number" class="form-control" min="0" required />
</div>

<div class="col-md-6">
    <label class="form-label">Image</label>
    <input type="file" name="ImageFile" accept="image/*" class="form-control" />
</div>

<div class="col-md-12">
    <label asp-for="sys_description" class="form-label">Description</label>
    <textarea asp-for="sys_description" class="form-control" rows="3"></textarea>
</div>
