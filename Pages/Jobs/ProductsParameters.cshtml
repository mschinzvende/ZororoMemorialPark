@page "{id:int}"
@model ZororoMemorialPark.Pages.Jobs.ProductsParametersModel

@{
    ViewData["Title"] = "Linked Products";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
       
        <a asp-page="/Jobs/JobParameters" class="btn btn-secondary">
            ← Back to Job Evaluation Parameters
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }
    <div class="row">
        <div class="col-sm-6">
            <!-- Add Product Card -->
            <div class="card shadow-sm mb-4 border-0">
                <div class="card-header d-flex justify-content-between align-items-center"
                     style="background-color: var(--primary-green); color: var(--primary-white);">
                    <span>Link Product to <strong>@Model.Parameter.sys_parameterName</strong></span>
                </div>
                <div class="card-body">
                    <form method="post" asp-page-handler="Add">
                        <input type="hidden" asp-for="ParameterId" />

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Product</label>
                                <select asp-for="SelectedProductId" asp-items="Model.ProductList" class="form-select">
                                    <option value="">-- Select Product --</option>
                                </select>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label fw-semibold">Default Qty</label>
                                <input asp-for="DefaultQty" class="form-control" type="number" step="0.01" placeholder="Enter default quantity" />
                            </div>

                            <div class="col-md-2 d-flex align-items-end">
                                <button type="submit" class="btn btn-primary w-100">
                                    <i class="bi bi-plus-circle"></i> Add
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-sm-6">
            <!-- Linked Products Card -->
            <div class="card shadow-sm border-0">
                <div class="card-header d-flex justify-content-between align-items-center"
                     style="background-color: var(--primary-green); color: var(--primary-white);">
                    <span>Currently Linked Products - <strong>@Model.Parameter.sys_parameterName</strong></span>
                </div>
                <div class="card-body">
                    @if (Model.LinkedProducts == null || !Model.LinkedProducts.Any())
                    {
                        <div class="alert alert-info mb-0">
                            No products linked to this evaluation parameter yet.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Product</th>
                                        <th>Default Quantity</th>
                                        <th style="width: 100px;">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.LinkedProducts)
                                    {
                                        <tr>
                                            <td>@item.tbl_ProductsAndServices.sys_itemName</td>
                                            <td>@item.sys_defaultQty</td>
                                            <td>
                                                <form method="post" asp-page-handler="Delete" class="m-0">
                                                    <input type="hidden" name="ParameterId" value="@Model.ParameterId" />
                                                    <input type="hidden" name="linkId" value="@item.sys_evalParamProductId" />
                                                    <button type="submit" class="btn btn-sm btn-danger w-100">
                                                        <i class="bi bi-trash"></i> Delete
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
    

    
</div>

