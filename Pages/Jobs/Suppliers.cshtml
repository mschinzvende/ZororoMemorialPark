@page
@model ZororoMemorialPark.Pages.Jobs.SuppliersModel

@{
    ViewData["Title"] = "Suppliers";
}

<div class="row">
    <div class="col-lg-11 mx-auto">
        <div class="card shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center"
                 style="background-color: var(--primary-green); color: var(--primary-white);">
                <h5 class="mb-0">Suppliers</h5>
                <div>
                    <button class="btn btn-sm btn-light me-2" data-bs-toggle="modal" data-bs-target="#createSupplierModal">
                        <i class="bi bi-plus-circle"></i> Add Supplier
                    </button>
                    
                </div>
            </div>

            <div class="card-body">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert" id="successMessage">
                        @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                <div class="d-flex justify-content-between align-items-center mb-3">
               
                    <input type="text" id="searchInput" class="form-control w-50"  placeholder="Search suppliers...">
                

                <button id="deleteSelectedBtn" type="button" class="btn btn-sm btn-danger" disabled
                        data-bs-toggle="modal" data-bs-target="#bulkDeleteModal">
                    <i class="bi bi-trash"></i> Delete Selected
                </button>
                </div>
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>
                                    <input type="checkbox" id="selectAll" />
                                </th>
                                <th>Supplier Name</th>
                                <th>Address</th>
                                <th>Phone</th>
                                <th>Email</th>
                                <th style="width:150px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="suppliersTable">
                            @foreach (var supplier in Model.PaginatedSuppliers)
                            {
                                <tr id="row-@supplier.sys_supplierId">
                                    <td>
                                        <input type="checkbox" class="row-checkbox" value="@supplier.sys_supplierId" />
                                    </td>
                                    <td>@supplier.sys_supplierName</td>
                                    <td>@supplier.sys_supplierAddress</td>
                                    <td>@supplier.sys_supplierPhone</td>
                                    <td>@supplier.sys_supplierEmail</td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-secondary"
                                                data-bs-toggle="modal"
                                                data-bs-target="#editSupplierModal"
                                                data-id="@supplier.sys_supplierId"
                                                data-name="@supplier.sys_supplierName"
                                                data-address="@supplier.sys_supplierAddress"
                                                data-phone="@supplier.sys_supplierPhone"
                                                data-email="@supplier.sys_supplierEmail">
                                            Edit
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger"
                                                data-bs-toggle="modal"
                                                data-bs-target="#deleteSupplierModal"
                                                data-id="@supplier.sys_supplierId"
                                                data-name="@supplier.sys_supplierName">
                                            Delete
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Pagination -->
            <div class="card-footer d-flex justify-content-between align-items-center mb-lg-4"
                 style="background-color: var(--primary-grey);">
                <span>Page @Model.PaginatedSuppliers.PageIndex of @Model.PaginatedSuppliers.TotalPages</span>
                <nav>
                    <ul class="pagination">
                        <li class="page-item @(Model.PaginatedSuppliers.HasPreviousPage ? "" : "disabled")">
                            <a class="page-link" asp-route-pageIndex="@(Model.PaginatedSuppliers.PageIndex - 1)">Previous</a>
                        </li>
                        @for (int i = 1; i <= Model.PaginatedSuppliers.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.PaginatedSuppliers.PageIndex ? "active" : "")">
                                <a class="page-link" asp-route-pageIndex="@i">@i</a>
                            </li>
                        }
                        <li class="page-item @(Model.PaginatedSuppliers.HasNextPage ? "" : "disabled")">
                            <a class="page-link" asp-route-pageIndex="@(Model.PaginatedSuppliers.PageIndex + 1)">Next</a>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="createSupplierModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header" style="background-color: var(--primary-green); color: var(--primary-white);">
                <h5 class="modal-title">Add Supplier</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body bg-light">
                <form method="post" asp-page-handler="Create" id="createSupplierForm">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Supplier Name</label>
                        <input name="sys_supplierName" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Address</label>
                        <input name="sys_supplierAddress" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Phone</label>
                        <input name="sys_supplierPhone" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Email</label>
                        <input type="email" name="sys_supplierEmail" class="form-control" />
                    </div>
                    <div class="text-end">
                        <button type="submit" class="btn btn-primary">Save</button>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="editSupplierModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header" style="background-color: var(--primary-green); color: var(--primary-white);">
                <h5 class="modal-title">Edit Supplier</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body bg-light">
                <form method="post" asp-page-handler="Edit" id="editSupplierForm">
                    <input type="hidden" name="sys_supplierId" />
                    <div class="mb-3">
                        <label class="form-label fw-bold">Supplier Name</label>
                        <input name="sys_supplierName" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Address</label>
                        <input name="sys_supplierAddress" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Phone</label>
                        <input name="sys_supplierPhone" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Email</label>
                        <input name="sys_supplierEmail" class="form-control" />
                    </div>
                    <div class="text-end">
                        <button type="submit" class="btn btn-primary">Update</button>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteSupplierModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">Delete Supplier</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body bg-light">
                <form method="post" asp-page-handler="Delete" id="deleteSupplierForm">
                    <input type="hidden" name="sys_supplierId" />
                    <p class="fw-semibold text-danger">
                        Are you sure you want to delete supplier <strong id="supplierName"></strong>?
                    </p>
                    <div class="text-end">
                        <button type="submit" class="btn btn-danger">Delete</button>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="bulkDeleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">Delete Selected Suppliers</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p id="bulkDeleteMessage">Are you sure you want to delete the selected suppliers?</p>
            </div>
            <div class="modal-footer">
                <form method="post" asp-page-handler="DeleteSelected" id="bulkDeleteForm">
                    <input type="hidden" name="SelectedIds" id="SelectedIds" />
                    <button type="submit" class="btn btn-danger">Delete</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                </form>
            </div>
        </div>
    </div>
</div>


<script>
    // --- Live Search ---
    document.getElementById("searchInput").addEventListener("keyup", function () {
        let filter = this.value.toLowerCase();
        let rows = document.querySelectorAll("#suppliersTable tr");
        rows.forEach(row => {
            let text = row.innerText.toLowerCase();
            row.style.display = text.includes(filter) ? "" : "none";
        });
    });

    // --- Checkbox Select/Deselect ---
    const selectAll = document.getElementById("selectAll");
    const deleteBtn = document.getElementById("deleteSelectedBtn");

    selectAll.addEventListener("change", function () {
        let checkboxes = document.querySelectorAll(".row-checkbox");
        checkboxes.forEach(cb => cb.checked = this.checked);
        toggleDeleteButton();
    });

    document.addEventListener("change", function (e) {
        if (e.target.classList.contains("row-checkbox")) {
            toggleDeleteButton();
        }
    });

    function toggleDeleteButton() {
        let checked = document.querySelectorAll(".row-checkbox:checked").length;
        deleteBtn.disabled = checked === 0;
    }

    // --- Bulk Delete Modal ---
    const bulkDeleteModal = document.getElementById("bulkDeleteModal");
    const bulkDeleteMessage = document.getElementById("bulkDeleteMessage");
    const selectedIdsInput = document.getElementById("SelectedIds");

    bulkDeleteModal.addEventListener("show.bs.modal", function () {
        let ids = Array.from(document.querySelectorAll(".row-checkbox:checked"))
            .map(cb => cb.value);

        if (ids.length > 0) {
            selectedIdsInput.value = ids.join(",");
            bulkDeleteMessage.textContent = `Are you sure you want to delete ${ids.length} selected supplier(s)?`;
        }
    });

    // --- Edit Modal ---
    var editModal = document.getElementById('editSupplierModal');
    editModal.addEventListener('show.bs.modal', function (event) {
        var button = event.relatedTarget;
        var supplierId = button.getAttribute('data-id');
        var name = button.getAttribute('data-name');
        var address = button.getAttribute('data-address');
        var phone = button.getAttribute('data-phone');
        var email = button.getAttribute('data-email');

        var modal = this;
        modal.querySelector('input[name="sys_supplierId"]').value = supplierId;
        modal.querySelector('input[name="sys_supplierName"]').value = name;
        modal.querySelector('input[name="sys_supplierAddress"]').value = address;
        modal.querySelector('input[name="sys_supplierPhone"]').value = phone;
        modal.querySelector('input[name="sys_supplierEmail"]').value = email;
    });

    // --- Delete Modal ---
    var deleteModal = document.getElementById('deleteSupplierModal');
    deleteModal.addEventListener('show.bs.modal', function (event) {
        var button = event.relatedTarget;
        var supplierId = button.getAttribute('data-id');
        var name = button.getAttribute('data-name');

        var modal = this;
        modal.querySelector('input[name="sys_supplierId"]').value = supplierId;
        modal.querySelector('#supplierName').textContent = name;
    });
</script>

