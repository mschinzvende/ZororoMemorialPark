@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model dynamic

@{
    int pageNumber = (int)Model.PageNumber;
    int pageSize = (int)Model.PageSize;
    int totalCount = (int)Model.TotalCount;
    string searchTerm = Model.SearchTerm as string ?? string.Empty;

    int totalPages = pageSize > 0
        ? (int)Math.Ceiling((double)totalCount / pageSize)
        : 1;

    if (totalPages == 0) totalPages = 1;

    int start = totalCount == 0 ? 0 : ((pageNumber - 1) * pageSize) + 1;
    int end = Math.Min(pageNumber * pageSize, totalCount);
}

@if (totalPages > 1)
{
    <div class="d-flex justify-content-between align-items-center mt-2">
        <nav aria-label="Page navigation">
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(pageNumber <= 1 ? "disabled" : "")">
                    <a class="page-link"
                       asp-page="/Graves/Graves"
                       asp-route-pageNumber="@(pageNumber - 1)"
                       asp-route-pageSize="@pageSize"
                       asp-route-searchTerm="@searchTerm">
                        Previous
                    </a>
                </li>

                @for (var i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == pageNumber ? "active" : "")">
                        <a class="page-link"
                           asp-page="/Graves/Graves"
                           asp-route-pageNumber="@i"
                           asp-route-pageSize="@pageSize"
                           asp-route-searchTerm="@searchTerm">
                            @i
                        </a>
                    </li>
                }

                <li class="page-item @(pageNumber >= totalPages ? "disabled" : "")">
                    <a class="page-link"
                       asp-page="/Graves/Graves"
                       asp-route-pageNumber="@(pageNumber + 1)"
                       asp-route-pageSize="@pageSize"
                       asp-route-searchTerm="@searchTerm">
                        Next
                    </a>
                </li>
            </ul>
        </nav>

        <div class="rows_count small text-muted">
            Showing @start to @end of @totalCount entries
        </div>
    </div>
}
else
{
    <div class="rows_count small text-muted mt-2">
        Showing @start to @end of @totalCount entries
    </div>
}
