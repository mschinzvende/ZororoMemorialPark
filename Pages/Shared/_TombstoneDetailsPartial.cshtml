@using ZororoMemorialPark.Pages.Tombstones
@model TombstoneDetailsViewModel

@if (Model == null)
{
    <div class="alert alert-warning">No tombstone linked to this grave.</div>
}
else
{
    <div class="card mb-3">
        <div class="card-header bg-light">
            <strong>@Model.Tombstone.sys_tombstoneName</strong>
        </div>
        <div class="card-body">
            <p><b>Material:</b> @Model.Tombstone.sys_material</p>
            <p><b>Size:</b> @Model.Tombstone.sys_size</p>
            <p><b>Price:</b> @Model.Tombstone.sys_price.ToString("C")</p>
            <p><b>Invoice #:</b> @Model.Invoice.sys_invoiceNumber</p>
            <p><b>Invoice Date:</b> @Model.Invoice.sys_invoiceDate</p>
            <p><b>Status:</b> @Model.PaymentStatus</p>

            <h6>Payments</h6>
            <table class="table table-bordered table-sm">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Amount</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var payment in Model.Payments)
                    {
                        <tr>
                            <td>@payment.sys_saleDate</td>
                            <td>@payment.sys_amountPaid.ToString("C")</td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (!Model.IsFullyPaid)
            {
                <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addPaymentModal">
                    Add Payment
                </button>
            }
        </div>
    </div>

    <!-- Payment Modal -->
    <div class="modal fade" id="addPaymentModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <form method="post" asp-page-handler="AddTombstonePayment">
                    <div class="modal-header">
                        <h5 class="modal-title">Add Payment</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" name="invoiceId" value="@Model.Invoice.sys_invoiceId" />
                        <input type="hidden" name="tombstoneId" value="@Model.Tombstone.sys_tombstoneId" />
                        <input type="hidden" name="graveId" value="@Model.GraveId" />

                        <div class="mb-3">
                            <label>Payment Amount</label>
                            <input type="number" class="form-control" name="amountPaid" step="0.01" required />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="submit" class="btn btn-success">Save Payment</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
