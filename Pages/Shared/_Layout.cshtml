@using Microsoft.AspNetCore.Identity
@inject UserManager<IdentityUser> UserManager

@{
    bool isManager = User.IsInRole("Manager");
    bool isOps = User.IsInRole("OperationsOfficer");
    bool isFinance = User.IsInRole("FinanceOfficer");
    bool isAgent = User.IsInRole("Agent");
}
@inject ZororoMemorialPark.Services.SystemSettingsService SettingsService

@{
    var settings = await SettingsService.GetSettingsAsync();
    string logo = "https://zororomemorial.azurewebsites.net"+ settings?.LogoPath;
    string companyName = settings?.CompanyName ?? "Zororo Memorial";
}


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ZororoMemorialPark</title>

    <!-- Core Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />

    <!-- Site CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ZororoMemorialPark.styles.css" asp-append-version="true" />

    <link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.css" rel="stylesheet" />


    
    


    <style>
        .user-profile-toggle {
        display: flex;
        align-items: center;
        cursor: pointer;
        border-radius: 999px;
        padding: 0.2rem 0.5rem;
        transition: background-color .2s ease-in-out;
        }

        .user-profile-toggle:hover {
        background-color: rgba(255, 255, 255, 0.15);
        }

        .user-avatar {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background-color: #ffffff;
        border: 1px solid #ddd;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-right: .5rem;
        }

        .user-avatar i {
        font-size: .9rem;
        color: #000;
        }

        .user-name {
        max-width: 140px;
        overflow: hidden;
        white-space: nowrap;
        text-overflow: ellipsis;
        color: #fff;
        }

        .user-caret {
        color: #e5e5e5;
        margin-left: .25rem;
        }

        .dropdown-menu {
        border-radius: .5rem;
        font-size: .9rem;
        }

        .dropdown-item i {
        margin-right: .5rem;
        }
    </style>

</head>

<body class="d-flex flex-column min-vh-100">

    <header>
        <nav class="navbar navbar-expand-lg navbar-dark">
            <div class="container-fluid">

                <!-- Brand -->
                <a class="navbar-brand d-flex align-items-center" href="/">
                    <img src="@logo"
                    alt="Logo"
                    style="height:38px; width:auto; margin-right:8px;" />

                    <span>@companyName</span>
                </a>


                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                data-bs-target="#mainNavbar" aria-controls="mainNavbar"
                aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- NAV ITEMS -->
                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-lg-center">

                        <!-- Dashboard (visible to all roles) -->
                        <li class="nav-item">
                            <a class="nav-link" href="/Index">Dashboard</a>
                        </li>

                        <!-- Graves -->
                        @if (isManager || isOps  || isFinance)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="gravesDropdown"
                                role="button" data-bs-toggle="dropdown">
                                    Graves
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    @if (isManager || isOps || isFinance || isAgent)
                                    {
                                        <li>
                                            <a class="dropdown-item" href="/Bookings/Index">
                                                <i class="bi bi-clipboard-check"></i> Bookings
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" href="/Graves/Graves">
                                                <i class="bi bi-archive"></i> Grave Stock
                                            </a>
                                        </li>
                                    }

                                    @if (isManager || isOps || isFinance)
                                    {
                                        <li>
                                            <a class="dropdown-item" href="/Reservations/Index">
                                                <i class="bi bi-bookmark-check"></i> Reservations
                                            </a>
                                        </li>
                                    }

                                    @if (isManager || isOps || isFinance || isAgent)
                                    {
                                        <li>
                                            <a class="dropdown-item" href="/Burials/BurialSchedule">
                                                <i class="bi bi-calendar-check"></i> Burial Schedule
                                            </a>
                                        </li>
                                    }

                                    @if (isManager || isOps)
                                    {
                                        <li>
                                            <a class="dropdown-item" href="/Graves/GraveSections">
                                                <i class="bi bi-grid"></i> Sections
                                            </a>
                                        </li>

                                        <li>
                                            <a class="dropdown-item" href="/Graves/DevelopmentStages">
                                                <i class="bi bi-layers"></i> Development Stages
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </li>
                        }

                        <!-- Tombstones -->
                        @if (isManager ||  isOps)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="tombDropdown"
                                data-bs-toggle="dropdown">
                                    Tombstones
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <a class="dropdown-item" href="/Tombstones/ManageTombstones">
                                            <i class="bi bi-bricks"></i> Manage Tombstones
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }

                        <!-- Jobs -->
                        @if (isManager || isOps)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="jobsDropdown"
                                data-bs-toggle="dropdown">
                                    Jobs
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <a class="dropdown-item" href="/Jobs/Suppliers">
                                            <i class="bi bi-truck"></i> Suppliers
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="/Jobs/JobParameters">
                                            <i class="bi bi-ui-checks"></i> Job Evaluations
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="/Jobs/JobEntries">
                                            <i class="bi bi-list-check"></i> Job Entries
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }

                        <!-- Finance -->
                        @if (isManager || isFinance || isOps)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="financeDropdown"
                                data-bs-toggle="dropdown">
                                    Finance
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">

                                    @if (isManager || isFinance)
                                    {
                                        <li>
                                            <a class="dropdown-item" href="/Finance/InvoicesList">
                                                <i class="bi bi-receipt"></i> Invoices
                                            </a>
                                        </li>

                                        <li>
                                            <a class="dropdown-item" href="/Finance/Expenses">
                                                <i class="bi bi-wallet2"></i> Daily Expenses
                                            </a>
                                        </li>

                                        @if (isManager)
                                        {
                                            <li>
                                                <a class="dropdown-item" href="/Finance/ExpenseCategories">
                                                    <i class="bi bi-tags"></i> Expense Categories
                                                </a>
                                            </li>
                                        }

                                        <li>
                                            <a class="dropdown-item" href="/Finance/Commissions">
                                                <i class="bi bi-cash-stack"></i> Commissions
                                            </a>
                                        </li>
                                    }
                                    @if (isManager || isFinance || isOps)
                                    {
                                        <li>
                                            <a class="dropdown-item" href="/Requisitions/Inbox">
                                                <i class="bi bi-file-earmark-text"></i> Requisitions
                                            </a>
                                        </li>
                                    }

                                    @if(isManager || isFinance)
                                    {
                                        <li>
                                            <a class="dropdown-item" href="/Requisitions/List">
                                                <i class="bi bi-clock-history"></i> Requisition History
                                            </a>
                                        </li>
                                    }
                                    @if (isManager || isFinance)
                                    {
                                        <li>
                                            <a class="dropdown-item" href="/Finance/PaymentMethods">
                                                <i class="bi bi-credit-card"></i> Payment Methods
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" href="/Finance/ReceiptBooks">
                                                <i class="bi bi-journal"></i> Receipt Books
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </li>
                        }



                        <!-- Inventory (Manager only) -->
                        @if (isManager)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="inventoryDropdown"
                                   data-bs-toggle="dropdown">
                                    Inventory
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <a class="dropdown-item" href="/Inventory/Products">
                                            <i class="bi bi-box"></i> Products
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="/Inventory/Services">
                                            <i class="bi bi-tools"></i> Services
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }

                        <!-- Agents -->
                        @if (isManager || isOps)
                        {
                            <li class="nav-item">
                                <a class="nav-link" href="/Agents/AgentManagement">
                                    Agents
                                </a>
                            </li>
                        }

                        <!-- Reports -->
                        @if (isManager || isFinance)
                        {
                            <li class="nav-item">
                                <a class="nav-link" href="/Reports/ReportsDash">
                                    Reports
                                </a>
                            </li>
                        }

                        <!-- Settings (Manager only) -->
                        @if (isManager)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="settingsDropdown"
                                   data-bs-toggle="dropdown">
                                    Settings
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <a class="dropdown-item" href="/Settings/SystemSettings">
                                            <i class="bi bi-gear-wide-connected"></i> System Configurations
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="/Requisitions/Workflows">
                                            <i class="bi bi-diagram-3"></i> Requisition Workflows
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="/UserManagement">
                                            <i class="bi bi-people"></i> Users
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }

                        <!-- Profile -->
                        <li class="nav-item dropdown ms-lg-3">
                            <a class="nav-link dropdown-toggle user-profile-toggle" href="#"
                               id="userDropdown" data-bs-toggle="dropdown">

                                <span class="user-avatar">
                                    <i class="bi bi-person-fill"></i>
                                </span>

                                <span class="user-name">
                                    @(User?.Identity?.IsAuthenticated == true
                                        ? User.FindFirst("FullName")?.Value ?? User.Identity.Name
                                        : "User")
                                </span>

                                <i class="bi bi-caret-down-fill user-caret"></i>
                            </a>

                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                                <li>
                                    <a class="dropdown-item" href="/Settings/UserProfile">
                                        <i class="bi bi-person-circle"></i> My Profile
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item" href="/Settings">
                                        <i class="bi bi-gear"></i> Settings
                                    </a>
                                </li>

                                <li><hr class="dropdown-divider" /></li>

                                <li>
                                    <a class="dropdown-item" href="/Account/Logout">
                                        <i class="bi bi-box-arrow-right"></i> Logout
                                    </a>
                                </li>
                            </ul>
                        </li>

                    </ul>
                </div>

            </div>
        </nav>
    </header>
    <main class="container-fluid flex-grow-1 py-4">
        @RenderBody()
    </main>

    <footer class="footer text-center mt-auto">
        © @DateTime.Now.Year @companyName — @settings?.Phone | @settings?.Email
    </footer>


    
    <script>
        setTimeout(function () {
            var message = document.getElementById("successMessage");
            if (message) {
                message.style.transition = "opacity 1s";
                message.style.opacity = "0";
                setTimeout(function () { message.style.display = "none"; }, 1000);
            }
        }, 3000);
    </script>
    

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.js"></script>
    

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
