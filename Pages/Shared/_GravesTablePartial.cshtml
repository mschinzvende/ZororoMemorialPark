@using ZororoMemorialPark.Pages.Graves
@using static ZororoMemorialPark.Pages.Graves.GravesModel
@model dynamic

@{
    var graves = Model.Graves as List<GraveViewModel>;
    var occupiedGraves = Model.Graves as List<OccupiedGraveViewModel>;
    var underConstructionGraves = Model.Graves as List<UnderConstructionGraveViewModel>;
    string status = Model.Status as string;
}

<div class="mb-2 d-flex justify-content-between align-items-center">
   <div class="row">

        <div class="col-auto me-2">
        <button class="btn btn-sm btn-danger" id="deleteSelectedBtn" data-bs-toggle="modal" data-bs-target="#bulkDeleteModal" disabled>
            <i class="bi bi-trash"></i> Delete Selected
        </button>
    </div>
        <div class="col-auto me-2">
        <div class="form-group">
            <!--		Show Numbers Of Rows 		-->
            <select class="form-select" name="state" id="maxRows">

                <option value="10">Show 10</option>
                <option value="15">15</option>
                <option value="20">20</option>
                <option value="50">50</option>
                <option value="70">70</option>
                <option value="100">100</option>
                <option value="5000">ALL</option>
            </select>

        </div>
        </div>
        <div class="col-auto me-2">
        <input type="text" id="search_input_all" onkeyup="FilterkeyWord_all_table()" placeholder="Search Table" class="form-control">
        </div>

        <div class="col-auto me-2">
           <h4>@status Graves</h4>
        </div>
    </div>

 
</div>


@if(status == "Under Construction" && underConstructionGraves !=null)
{
    <div class="table-responsive">
        <table class="table table-striped table-class table-sm" id="myTable">

            <thead class="thead-light">
                <tr>
                    <th><input type="checkbox" id="selectAll-@status"></th>
                    <th>Plot Number</th>
                    <th>Section</th>
                    <th>Stage</th>
                    <th>Due Date</th>
                    <th>Status</th>
                    <th>Supplier</th>
                    <th>Price</th>
                    <th>Location</th>
                    <th style="width:150px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var underConstructionGrave in underConstructionGraves)
                {
                    <tr id="row-@underConstructionGrave.sys_graveId">
                        <td><input type="checkbox" class="row-checkbox" value="@underConstructionGrave.sys_graveId"></td>
                        <td><a asp-page="/Graves/GraveDetails" asp-route-id="@underConstructionGrave.sys_graveId">@underConstructionGrave.sys_plotNumber</a></td>
                        <td>@underConstructionGrave.SectionName</td>
                        <td>@underConstructionGrave.StageName</td>
                        <td>@underConstructionGrave.sys_endDate.ToString("yyyy-MM-dd")</td>

                        <td style="background-color:@(underConstructionGrave.sys_endDate.ToDateTime(TimeOnly.MinValue) < DateTime.Today ? "#f8d7da" : "#d1e7dd");
           color:@(underConstructionGrave.sys_endDate.ToDateTime(TimeOnly.MinValue) < DateTime.Today ? "#842029" : "#0f5132");
           font-weight:bold;">
                            @(underConstructionGrave.sys_endDate.ToDateTime(TimeOnly.MinValue) < DateTime.Today
                                ? "Overdue"
                                : "On Track")
                        </td>
                        <td>@underConstructionGrave.sys_supplierName</td>
                        <td>@underConstructionGrave.sys_price.ToString("C")</td>
                        <td>@underConstructionGrave.sys_latitude, @underConstructionGrave.sys_longitude</td>
                        <td>
                            <button class="btn btn-sm btn-outline-secondary"
                                    data-bs-toggle="modal"
                                    data-bs-target="#editGraveModal"
                                    data-id="@underConstructionGrave.sys_graveId"
                                    data-plot="@underConstructionGrave.sys_plotNumber"
                                    data-section="@underConstructionGrave.sys_sectionId"
                                    data-stage="@underConstructionGrave.sys_stageId"
                                    data-status="@underConstructionGrave.sys_graveSaleStatus"
                                    data-price="@underConstructionGrave.sys_price"
                                    data-latitude="@underConstructionGrave.sys_latitude"
                                    data-longitude="@underConstructionGrave.sys_longitude">
                                Edit
                            </button>

                            <a class="btn btn-sm btn-outline-primary" asp-page="/Graves/GraveDetails" asp-route-id="@underConstructionGrave.sys_graveId">View</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <!--		Start Pagination -->
        <div class="pagination-container">
            <nav>
                <ul class="pagination">
                    <!--	Here the JS Function Will Add the Rows -->
                </ul>
            </nav>
        </div>
        <div class="rows_count">Showing 11 to 20 of 91 entries</div>
    </div>
}

else if(status =="Occupied" && occupiedGraves !=null)
{
    <div class="table-responsive">
        <table class="table table-striped table-class table-sm" id="myTable">

            <thead class="thead-light">
                <tr>
                    <th><input type="checkbox" id="selectAll-@status"></th>
                    <th>Plot Number</th>
                    <th>Section</th>
                    <th>Occupied On</th>
                    <th>Next of kin</th>
                    <th>Contact #</th>
                    <th>Tombstone Status</th>
                    <th>Location</th>
                    <th style="width:150px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var occupiedGrave in occupiedGraves)
                {
                    <tr id="row-@occupiedGrave.sys_graveId">
                        <td><input type="checkbox" class="row-checkbox" value="@occupiedGrave.sys_graveId"></td>

                        @if(occupiedGrave.topBuildStatus!="N/A" && occupiedGrave.sys_reminderPeriod !=0)
                        {
                            <td><a asp-page="/Graves/GraveDetails" asp-route-id="@occupiedGrave.sys_graveId">@occupiedGrave.sys_plotNumber</a><br><span class="badge bg-success">@occupiedGrave.topBuildStatus</span></td>
                        }
                        else
                        {
                            <td><a asp-page="/Graves/GraveDetails" asp-route-id="@occupiedGrave.sys_graveId">@occupiedGrave.sys_plotNumber</a></td>
                        }


                        
                        <td>@occupiedGrave.SectionName</td>
                        <td>@occupiedGrave.sys_occupationDate</td>
                        <td>@occupiedGrave.sys_nextOfKinName</td>
                        <td>@occupiedGrave.sys_nextOfKinContact</td>
                        <td><span class="badge bg-secondary">@occupiedGrave.sys_graveTombStatus</span></td>

                        <td>@occupiedGrave.sys_latitude, @occupiedGrave.sys_longitude</td>
                        <td>
                            
                            @if (occupiedGrave.sys_graveTombStatus == "Ready for Tombstone")
                                {
                                <button class="btn btn-success btn-sm" data-bs-toggle="modal" data-bs-target="#tombstoneOrderModal"
                                        data-graveid="@occupiedGrave.sys_graveId">
                                    Order Tombstone
                                </button>
                                }
                           
                            <a class="btn btn-sm btn-outline-primary" asp-page="/Graves/GraveDetails" asp-route-id="@occupiedGrave.sys_graveId">View</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <!--		Start Pagination -->
        <div class="pagination-container">
            <nav>
                <ul class="pagination">
                    <!--	Here the JS Function Will Add the Rows -->
                </ul>
            </nav>
        </div>
        <div class="rows_count">Showing 11 to 20 of 91 entries</div>
    </div>

}

else
{
    <div class="table-responsive">
        <table class="table table-striped table-class table-sm" id="myTable">

            <thead class="thead-light">
                <tr>
                    <th><input type="checkbox" id="selectAll-@status"></th>
                    <th>Plot Number</th>
                    <th>Section</th>
                    
                    <th>Status</th>
                    <th>Price</th>
                    <th>Location</th>
                    <th style="width:150px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var grave in graves)
                {
                    <tr id="row-@grave.sys_graveId">
                        <td><input type="checkbox" class="row-checkbox" value="@grave.sys_graveId"></td>
                        <td><a asp-page="/Graves/GraveDetails" asp-route-id="@grave.sys_graveId">@grave.sys_plotNumber</a></td>
                        <td>@grave.SectionName</td>
                        
                        <td>@grave.sys_graveSaleStatus</td>
                        <td>@grave.sys_price.ToString("C")</td>
                        <td>@grave.sys_latitude, @grave.sys_longitude</td>
                        <td>
                            <button class="btn btn-sm btn-outline-secondary"
                                    data-bs-toggle="modal"
                                    data-bs-target="#editGraveModal"
                                    data-id="@grave.sys_graveId"
                                    data-plot="@grave.sys_plotNumber"
                                    data-section="@grave.sys_sectionId"
                                    data-stage="@grave.sys_stageId"
                                    data-status="@grave.sys_graveSaleStatus"
                                    data-price="@grave.sys_price"
                                    data-latitude="@grave.sys_latitude"
                                    data-longitude="@grave.sys_longitude">
                                Edit
                            </button>

                            <a class="btn btn-sm btn-outline-primary" asp-page="/Graves/GraveDetails" asp-route-id="@grave.sys_graveId">View</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <!--		Start Pagination -->
        <div class="pagination-container">
            <nav>
                <ul class="pagination">
                    <!--	Here the JS Function Will Add the Rows -->
                </ul>
            </nav>
        </div>
        <div class="rows_count">Showing 11 to 20 of 91 entries</div>
    </div>
}



<script src='https://cdnjs.cloudflare.com/ajax/libs/jquery/2.2.2/jquery.min.js'></script>
<script src='https://maxcdn.bootstrapcdn.com/bootstrap/3.3.6/js/bootstrap.min.js'></script>
<script src="~/js/tableScript.js"></script>