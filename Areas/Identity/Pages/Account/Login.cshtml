@page
@model LoginModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = null; // No navbar/footer
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - Zororo Grave Management</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="bg-light">

    <div class="container vh-100 d-flex justify-content-center align-items-center">
        <div class="row shadow-lg rounded-3 w-100 mx-2" style="max-width: 900px;">

            <!-- Branding / Image Column -->
            <div class="col-md-6 d-none d-md-flex align-items-center justify-content-center rounded-start"
                 style="background-color: #006A46; color: white;">
                <div class="text-center p-4">
                    <img src="~/images/logo.png" class="img-fluid mb-3" alt="Zororo Logo" style="max-height:120px;">
                    <h2>Zororo Grave Management</h2>
                    <p class="mt-3">Securely manage graves, reservations, and users efficiently.</p>
                </div>
            </div>

            <!-- Login Form Column -->
            <div class="col-md-6 bg-white rounded-end p-5">
                <h3 class="mb-4 text-center" style="color:#006A46;">Sign In</h3>

                <form method="post" class="d-flex flex-column gap-3">
                    <div class="mb-2">
                        <label asp-for="Input.Email">Email</label>
                        <input asp-for="Input.Email" class="form-control" placeholder="Email" required />
                    </div>
                    <div class="mb-2">
                        <label asp-for="Input.Password">Password</label>
                        <input asp-for="Input.Password" type="password" class="form-control" placeholder="Password" required />
                    </div>
                    <div class="form-check mb-2">
                        <input asp-for="Input.RememberMe" class="form-check-input" />
                        <label asp-for="Input.RememberMe" class="form-check-label">Remember Me</label>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Login</button>
                </form>

                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-danger mt-3">@Model.ErrorMessage</div>

                    <div asp-validation-summary="All" class="text-danger"></div>
                }

                <div class="text-center mt-4">
                    <a href="/Account/ForgotPassword" class="text-decoration-none" style="color:#006A46;">Forgot Password?</a>
                </div>
            </div>

        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
