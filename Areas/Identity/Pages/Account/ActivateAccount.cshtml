@page
@model ActivateAccountModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = null;
}

@inject ZororoMemorialPark.Services.SystemSettingsService SettingsService

@{
    var settings = await SettingsService.GetSettingsAsync();
    string logo = settings?.LogoPath ?? "/images/default-logo.png";
    string companyName = settings?.CompanyName ?? "Zororo Memorial Park";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Activate Account - Zororo Memorial Park</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" />
</head>

<body class="bg-light">

    <div class="container vh-100 d-flex justify-content-center align-items-center">
        <div class="row shadow-lg rounded-3 w-100 mx-2" style="max-width: 900px;">

            <!-- Branding Side -->
            <div class="col-md-6 d-none d-md-flex align-items-center justify-content-center rounded-start"
                 style="background-color:#006A46; color:white;">
                <div class="text-center p-4">
                    <img src="@logo" class="img-fluid mb-3" alt="Zororo Logo" style="max-height:120px;">
                    <h2>@companyName</h2>
                    <p class="mt-2" style="font-size:1rem;">Account Activation</p>
                </div>
            </div>

            <!-- Form Side -->
            <div class="col-md-6 bg-white rounded-end p-5">

                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-danger text-center">@Model.ErrorMessage</div>
                }

                <h3 class="mb-4 text-center" style="color:#006A46;">Activate Your Account</h3>

                <form method="post" class="d-flex flex-column gap-3">

                    <input type="hidden" asp-for="Input.UserId" />

                    <div>
                        <label asp-for="Input.Code">Activation Code</label>
                        <input asp-for="Input.Code" class="form-control" placeholder="Enter 6-digit activation code" required />
                        <span asp-validation-for="Input.Code" class="text-danger"></span>
                    </div>

                    <div>
                        <label asp-for="Input.Password">New Password</label>
                        <input asp-for="Input.Password" type="password" class="form-control" placeholder="Create a password" required />
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>

                    <div>
                        <label asp-for="Input.ConfirmPassword">Confirm Password</label>
                        <input asp-for="Input.ConfirmPassword" type="password" class="form-control" placeholder="Repeat password" required />
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">Activate Account</button>
                </form>

                <div class="mt-3">
                    <partial name="_ValidationScriptsPartial" />
                </div>

            </div>

        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

